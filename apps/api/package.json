{
  "name": "@palcert/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage",
    "test:e2e": "jest --config jest-e2e.config.js",
    "bootstrap:admin": "node dist/cli/bootstrap-admin.js",
    "start:worker": "node dist/worker-main.js",
    "dev:worker": "nest start --watch --entryFile worker-main",
    "storage:provision": "node scripts/provision-storage.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:verify": "node scripts/verify-backup.mjs",
    "restore": "node scripts/restore.mjs",
    "restore:verify": "node scripts/verify-restore.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@expo-google-fonts/noto-sans-arabic": "0.4.3",
    "@fontsource/noto-sans": "5.3.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@node-rs/argon2": "^2.0.2",
    "@palcert/config": "workspace:*",
    "@palcert/contracts": "workspace:*",
    "@palcert/database": "workspace:*",
    "body-parser": "2.4.0",
    "bullmq": "^6.3.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.0",
    "nestjs-pino": "^4.4.1",
    "nodemailer": "10.1.4",
    "otpauth": "^9.4.0",
    "pdfkit": "0.20.2",
    "pino": "^9.13.1",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "qrcode": "1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^22.6.2",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.8",
    "@nestjs/testing": "^11.1.6",
    "@types/body-parser": "1.19.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/fontkit": "2.0.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.2",
    "@types/pdfkit": "0.17.4",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "@types/yauzl": "^3.4.0",
    "fontkit": "2.0.4",
    "jest": "^30.2.0",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  }
}
