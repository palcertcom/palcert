{
  "name": "palcert",
  "version": "0.1.0",
  "private": true,
  "description": "PalCert - AI-powered document compliance, correction, verification and certification platform",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./apps/**\" build",
    "dev": "pnpm --parallel --filter \"./apps/**\" dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "db:generate": "pnpm --filter @palcert/database generate",
    "db:migrate": "pnpm --filter @palcert/database migrate:dev",
    "db:deploy": "pnpm --filter @palcert/database migrate:deploy",
    "db:check-migrations": "pnpm --filter @palcert/database migrations:check",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "py:lint": "ruff check services/document-engine",
    "py:format": "ruff format services/document-engine",
    "py:test": "pytest services/document-engine",
    "db:provision-app-role": "pnpm --filter @palcert/database provision-app-role",
    "db:setup": "pnpm db:generate && pnpm db:deploy && pnpm db:provision-app-role",
    "storage:provision": "pnpm --filter @palcert/api storage:provision",
    "webhooks:refresh-iana": "node scripts/generate-iana-registry.mjs",
    "webhooks:check-iana": "node scripts/generate-iana-registry.mjs --check",
    "docs:check-phases": "node scripts/check-phase-docs.mjs",
    "local:up": "bash scripts/local/palcert-local.sh up",
    "local:stop": "bash scripts/local/palcert-local.sh stop",
    "local:status": "bash scripts/local/palcert-local.sh status",
    "local:logs": "bash scripts/local/palcert-local.sh logs",
    "local:admin": "bash scripts/local/palcert-local.sh admin",
    "local:reset": "bash scripts/local/palcert-local.sh reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axe-core": "4.10.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "json-schema-to-typescript": "^15.0.4",
    "playwright": "1.56.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.1.12",
    "vite": "^7.3.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "unrs-resolver",
      "@parcel/watcher",
      "@node-rs/argon2"
    ],
    "overrides": {
      "postcss": ">=8.5.18",
      "deepmerge-ts": ">=8.0.0",
      "multer": ">=2.4.0 <3",
      "proxy-addr@<2.0.8": "^2.0.8",
      "handlebars@<4.7.10": "^4.7.10",
      "brace-expansion@<2": "^1.1.21",
      "brace-expansion@>=2 <3": "^2.1.7",
      "brace-expansion@>=4 <5.0.12": "^5.0.12",
      "source-map-js@<1.2.2": "^1.2.2",
      "fast-uri@>=3 <3.1.8": "^3.1.8",
      "js-yaml@>=5 <5.4.1": "^5.4.1",
      "vite@>=7 <7.3.7": "^7.3.7"
    }
  }
}
