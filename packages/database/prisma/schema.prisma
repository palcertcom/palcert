  declaredSizeBytes Int     @map("declared_size_bytes")
  maxFileBytes      Int     @map("max_file_bytes")
  sizeBytes         Int?    @map("size_bytes")
  clientSha256      String? @map("client_sha256") @db.Char(64)
  sha256            String? @db.Char(64)

  quarantineObjectKey       String    @map("quarantine_object_key")
  quarantineObjectVersionId String?   @map("quarantine_object_version_id")
  quarantineObjectEtag      String?   @map("quarantine_object_etag")
  quarantineDeletedAt       DateTime? @map("quarantine_deleted_at") @db.Timestamptz(6)

  cleanObjectKey       String? @unique(map: "manual_topup_receipts_clean_key") @map("clean_object_key")
  cleanObjectVersionId String? @map("clean_object_version_id")
  cleanObjectEtag      String? @map("clean_object_etag")

  scanEngine    String? @map("scan_engine")
  scanSignature String? @map("scan_signature")
  rejectionCode String? @map("rejection_code")
  failureCode   String? @map("failure_code")
  failureDetail String? @map("failure_detail")

  idempotencyKey  String?  @map("idempotency_key") @db.VarChar(200)
  uploadExpiresAt DateTime @map("upload_expires_at") @db.Timestamptz(6)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  uploadedAt  DateTime? @map("uploaded_at") @db.Timestamptz(6)
  validatedAt DateTime? @map("validated_at") @db.Timestamptz(6)
  scannedAt   DateTime? @map("scanned_at") @db.Timestamptz(6)
  readyAt     DateTime? @map("ready_at") @db.Timestamptz(6)
  rejectedAt  DateTime? @map("rejected_at") @db.Timestamptz(6)
  failedAt    DateTime? @map("failed_at") @db.Timestamptz(6)

  request   ManualTopUpRequest   @relation("ManualTopUpReceipts", fields: [requestId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict, map: "manual_topup_receipts_request_owner_fkey")
  currentOf ManualTopUpRequest[] @relation("ManualTopUpCurrentReceipt")

  @@unique([id, requestId], map: "manual_topup_receipts_id_request_key")
  @@unique([ownerUserId, idempotencyKey], map: "manual_topup_receipts_owner_idempotency")
  @@index([requestId, createdAt], map: "manual_topup_receipts_request_idx")
  @@index([status, uploadExpiresAt], map: "manual_topup_receipts_status_idx")
  @@map("manual_topup_receipts")
}

/// Append-only history of a manual top-up request.
model ManualTopUpRequestEvent {
  id          String               @id @default(uuid()) @db.Uuid
  requestId   String               @map("request_id") @db.Uuid
  ownerUserId String               @map("owner_user_id") @db.Uuid
  eventType   ManualTopUpEventType @map("event_type")
  actorSide   ManualTopUpActorSide @map("actor_side")
  actorUserId String?              @map("actor_user_id") @db.Uuid
  /// Written by the database (`clock_timestamp()`), so history orders itself.
  createdAt   DateTime             @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)

  request ManualTopUpRequest @relation(fields: [requestId, ownerUserId], references: [id, ownerUserId], onDelete: Restrict, map: "manual_topup_request_events_request_owner_fkey")

  @@index([requestId, createdAt, id], map: "manual_topup_request_events_request_idx")
  @@map("manual_topup_request_events")
}

// =============================================================================
// Withdrawals and payouts (ADR-0150)
//
// One review workflow for three beneficiaries: a user's own eligible money, an
// organization's settled net share, and PalCert's realized revenue. Payouts
// are recorded, never executed: Finance sends the money outside PalCert and
// records the transfer reference. Availability is always derived, never
// stored. A user's withdrawal is reserved with a CASH credit hold and settled
// by capturing it as exactly one WITHDRAWAL_DEBIT; an organization or platform
// withdrawal is reserved with a withdrawal_reservations row under the lock of
// its withdrawal_accounts anchor.
//
// The state machine, write-once fields, separation-of-duties checks, the
// settlement shape and RLS live in the migration; Prisma's schema language
// cannot express them.
// =============================================================================

enum WithdrawalScope {
  USER
  ORGANIZATION
  PLATFORM
}

enum WithdrawalStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PROCESSING
  PAID
  REJECTED
  CANCELLED
  FAILED
}

enum PayoutDestinationType {
  BANK_ACCOUNT
  MOBILE_WALLET
  OTHER
}

enum WithdrawalRejectionReason {
  DESTINATION_INVALID
  BENEFICIARY_MISMATCH
  VERIFICATION_REQUIRED
  POLICY_VIOLATION
  SUSPECTED_FRAUD
  DUPLICATE_REQUEST
  OTHER
}

enum WithdrawalEventType {
  CREATED
  SUBMITTED
  RESERVED
  REVIEW_STARTED
  APPROVED
  REJECTED
  CANCELLED
  EXECUTION_STARTED
  PAID
  FAILED
  RETRY_STARTED
  RESERVATION_RELEASED
  PROOF_ATTACHED
}

enum WithdrawalActorSide {
  REQUESTER
  FINANCE
}

enum WithdrawalAttemptOutcome {
  IN_PROGRESS
  SUCCEEDED
  FAILED
}

enum WithdrawalReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

/// The one policy row. No fee column: v1 charges no withdrawal fee.
model WithdrawalPolicy {
  id                          Int      @id @default(1) @db.SmallInt
  userManualTopUpClearingDays Int      @default(14) @map("user_manual_topup_clearing_days")
  organizationClearingDays    Int      @default(30) @map("organization_clearing_days")
  version                     Int      @default(1)
  updatedAt                   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedByUserId             String?  @map("updated_by_user_id") @db.Uuid

  @@map("withdrawal_policy")
}

/// Optional minimum and maximum per currency.
model WithdrawalCurrencyLimit {
  currency        String   @id @db.Char(3)
  minAmountMinor  BigInt?  @map("min_amount_minor")
  maxAmountMinor  BigInt?  @map("max_amount_minor")
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid

  @@map("withdrawal_currency_limits")
}

/// Where a beneficiary is paid. Details are sealed (AES-256-GCM, payout key
/// ring); `summary` holds only masked display values. Never hard-deleted.
model PayoutDestination {
  id                String                @id @default(uuid()) @db.Uuid
  scope             WithdrawalScope
  ownerUserId       String?               @map("owner_user_id") @db.Uuid
  organizationId    String?               @map("organization_id") @db.Uuid
  type              PayoutDestinationType
  label             String                @db.VarChar(80)
  beneficiaryName   String                @map("beneficiary_name") @db.VarChar(140)
  currency          String?               @db.Char(3)
  summary           Json
  detailsCiphertext String                @map("details_ciphertext")
  detailsIv         String                @map("details_iv")
  detailsAuthTag    String                @map("details_auth_tag")
  detailsKid        String                @map("details_kid")
  version           Int                   @default(1)
  archivedAt        DateTime?             @map("archived_at") @db.Timestamptz(6)
  createdByUserId   String                @map("created_by_user_id") @db.Uuid
  updatedByUserId   String?               @map("updated_by_user_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)

  requests WithdrawalRequest[]

  @@map("payout_destinations")
}

/// Lock anchor for an organization's or PalCert's payouts in one currency.
/// Holds no balance; reserving locks this row FOR UPDATE.
model WithdrawalAccount {
  id             String          @id @default(uuid()) @db.Uuid
  scope          WithdrawalScope
  organizationId String?         @map("organization_id") @db.Uuid
  currency       String          @db.Char(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  reservations WithdrawalReservation[]

  @@map("withdrawal_accounts")
}

/// One request to pay money out, and Finance's handling of it.
model WithdrawalRequest {
  id                          String                     @id @default(uuid()) @db.Uuid
  scope                       WithdrawalScope
  requesterUserId             String                     @map("requester_user_id") @db.Uuid
  beneficiaryUserId           String?                    @map("beneficiary_user_id") @db.Uuid
  organizationId              String?                    @map("organization_id") @db.Uuid
  currency                    String                     @db.Char(3)
  amountMinor                 BigInt                     @map("amount_minor")
  status                      WithdrawalStatus           @default(DRAFT)
  destinationId               String                     @map("destination_id") @db.Uuid
  /// The masked destination as it was at submission. Frozen.
  destinationSnapshot         Json                       @map("destination_snapshot")
  destinationSealedCiphertext String                     @map("destination_sealed_ciphertext")
  destinationSealedIv         String                     @map("destination_sealed_iv")
  destinationSealedAuthTag    String                     @map("destination_sealed_auth_tag")
  destinationSealedKid        String                     @map("destination_sealed_kid")
  requesterNote               String?                    @map("requester_note") @db.VarChar(500)
  availableBeforeMinor        BigInt?                    @map("available_before_minor")
  holdId                      String?                    @unique(map: "withdrawal_requests_hold_key") @map("hold_id") @db.Uuid
  reservationId               String?                    @unique(map: "withdrawal_requests_reservation_key") @map("reservation_id") @db.Uuid
  submittedAt                 DateTime?                  @map("submitted_at") @db.Timestamptz(6)
  reviewStartedAt             DateTime?                  @map("review_started_at") @db.Timestamptz(6)
  reviewedByUserId            String?                    @map("reviewed_by_user_id") @db.Uuid
  approvedAt                  DateTime?                  @map("approved_at") @db.Timestamptz(6)
  approvedByUserId            String?                    @map("approved_by_user_id") @db.Uuid
  rejectedAt                  DateTime?                  @map("rejected_at") @db.Timestamptz(6)
  rejectedByUserId            String?                    @map("rejected_by_user_id") @db.Uuid
  rejectionReason             WithdrawalRejectionReason? @map("rejection_reason")
  rejectionNote               String?                    @map("rejection_note") @db.VarChar(1000)
  cancelledAt                 DateTime?                  @map("cancelled_at") @db.Timestamptz(6)
  cancelledByUserId           String?                    @map("cancelled_by_user_id") @db.Uuid
  releaseNote                 String?                    @map("release_note") @db.VarChar(1000)
  executedAt                  DateTime?                  @map("executed_at") @db.Timestamptz(6)
  executedByUserId            String?                    @map("executed_by_user_id") @db.Uuid
  externalTransferReference   String?                    @map("external_transfer_reference") @db.VarChar(120)
  executionNote               String?                    @map("execution_note") @db.VarChar(1000)
  version                     Int                        @default(1)
  idempotencyKey              String?                    @map("idempotency_key") @db.VarChar(200)
  createdAt                   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                   @default(now()) @map("updated_at") @db.Timestamptz(6)

  destination  PayoutDestination            @relation(fields: [destinationId], references: [id], onDelete: Restrict, map: "withdrawal_requests_destination_fkey")
  reservation  WithdrawalReservation?       @relation("WithdrawalRequestCurrentReservation", fields: [reservationId], references: [id], onDelete: Restrict, map: "withdrawal_requests_reservation_fkey")
  reservations WithdrawalReservation[]      @relation("WithdrawalReservationRequest")
  settlement   WithdrawalSettlement?
  attempts     WithdrawalExecutionAttempt[]
  events       WithdrawalRequestEvent[]
  proofs       WithdrawalProof[]

  @@unique([requesterUserId, idempotencyKey], map: "withdrawal_requests_requester_idempotency")
  @@index([requesterUserId, createdAt(sort: Desc), id], map: "withdrawal_requests_requester_idx")
  @@index([status, submittedAt, id], map: "withdrawal_requests_queue_idx")
  @@map("withdrawal_requests")
}

/// The reservation of an organization or platform withdrawal.
model WithdrawalReservation {
  id             String                      @id @default(uuid()) @db.Uuid
  accountId      String                      @map("account_id") @db.Uuid
  requestId      String                      @unique(map: "withdrawal_reservations_request_key") @map("request_id") @db.Uuid
  scope          WithdrawalScope
  organizationId String?                     @map("organization_id") @db.Uuid
  currency       String                      @db.Char(3)
  amountMinor    BigInt                      @map("amount_minor")
  status         WithdrawalReservationStatus @default(ACTIVE)
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  consumedAt     DateTime?                   @map("consumed_at") @db.Timestamptz(6)
  releasedAt     DateTime?                   @map("released_at") @db.Timestamptz(6)

  account    WithdrawalAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict, map: "withdrawal_reservations_account_fkey")
  request    WithdrawalRequest     @relation("WithdrawalReservationRequest", fields: [requestId], references: [id], onDelete: Restrict, map: "withdrawal_reservations_request_fkey")
  currentOf  WithdrawalRequest[]   @relation("WithdrawalRequestCurrentReservation")
  settlement WithdrawalSettlement?

  @@index([accountId, status], map: "withdrawal_reservations_account_idx")
  @@map("withdrawal_reservations")
}

/// The one settlement of a paid withdrawal. Append-only; the idempotency key
/// is `withdrawal:<request id>:settle`.
model WithdrawalSettlement {
  id                        String          @id @default(uuid()) @db.Uuid
  requestId                 String          @unique(map: "withdrawal_settlements_request_key") @map("request_id") @db.Uuid
  scope                     WithdrawalScope
  beneficiaryUserId         String?         @map("beneficiary_user_id") @db.Uuid
  organizationId            String?         @map("organization_id") @db.Uuid
  currency                  String          @db.Char(3)
  amountMinor               BigInt          @map("amount_minor")
  ledgerEntryId             String?         @unique(map: "withdrawal_settlements_ledger_entry_key") @map("ledger_entry_id") @db.Uuid
  reservationId             String?         @unique(map: "withdrawal_settlements_reservation_key") @map("reservation_id") @db.Uuid
  idempotencyKey            String          @unique(map: "withdrawal_settlements_idempotency_key") @map("idempotency_key") @db.VarChar(200)
  externalTransferReference String          @map("external_transfer_reference") @db.VarChar(120)
  settledByUserId           String          @map("settled_by_user_id") @db.Uuid
  settledAt                 DateTime        @default(now()) @map("settled_at") @db.Timestamptz(6)

  request     WithdrawalRequest      @relation(fields: [requestId], references: [id], onDelete: Restrict, map: "withdrawal_settlements_request_fkey")
  reservation WithdrawalReservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict, map: "withdrawal_settlements_reservation_fkey")

  @@map("withdrawal_settlements")
}

/// One attempt to execute a payout outside PalCert. Append-only per attempt.
model WithdrawalExecutionAttempt {
  id                String                   @id @default(uuid()) @db.Uuid
  requestId         String                   @map("request_id") @db.Uuid
  attemptNumber     Int                      @map("attempt_number")
  outcome           WithdrawalAttemptOutcome @default(IN_PROGRESS)
  startedByUserId   String                   @map("started_by_user_id") @db.Uuid
  startedAt         DateTime                 @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedByUserId  String?                  @map("finished_by_user_id") @db.Uuid
  finishedAt        DateTime?                @map("finished_at") @db.Timestamptz(6)
  externalReference String?                  @map("external_reference") @db.VarChar(120)
  note              String?                  @db.VarChar(1000)

  request WithdrawalRequest @relation(fields: [requestId], references: [id], onDelete: Restrict, map: "withdrawal_execution_attempts_request_fkey")

  @@unique([requestId, attemptNumber], map: "withdrawal_execution_attempts_number_key")
  @@map("withdrawal_execution_attempts")
}

/// Append-only history of a withdrawal request.
model WithdrawalRequestEvent {
  id              String              @id @default(uuid()) @db.Uuid
  requestId       String              @map("request_id") @db.Uuid
  requesterUserId String              @map("requester_user_id") @db.Uuid
  organizationId  String?             @map("organization_id") @db.Uuid
  eventType       WithdrawalEventType @map("event_type")
  actorSide       WithdrawalActorSide @map("actor_side")
  actorUserId     String?             @map("actor_user_id") @db.Uuid
  note            String?             @db.VarChar(1000)
  /// Written by the database (`clock_timestamp()`), so history orders itself.
  createdAt       DateTime            @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)

  request WithdrawalRequest @relation(fields: [requestId], references: [id], onDelete: Restrict, map: "withdrawal_request_events_request_fkey")

  @@index([requestId, createdAt, id], map: "withdrawal_request_events_request_idx")
  @@map("withdrawal_request_events")
}

/// Proof of an external payout. Private to Finance and the requester.
model WithdrawalProof {
  id               String                @id @default(uuid()) @db.Uuid
  requestId        String                @map("request_id") @db.Uuid
  requesterUserId  String                @map("requester_user_id") @db.Uuid
  organizationId   String?               @map("organization_id") @db.Uuid
  uploadedByUserId String                @map("uploaded_by_user_id") @db.Uuid
  status           ManualTopUpFileStatus @default(AWAITING_UPLOAD)

  originalFilename String                 @map("original_filename")
  declaredMimeType String?                @map("declared_mime_type")
  expectedFormat   ManualTopUpFileFormat  @map("expected_format")
  detectedFormat   ManualTopUpFileFormat? @map("detected_format")
  detectedMimeType String?                @map("detected_mime_type")

  declaredSizeBytes Int     @map("declared_size_bytes")
  maxFileBytes      Int     @map("max_file_bytes")
  sizeBytes         Int?    @map("size_bytes")
  clientSha256      String? @map("client_sha256") @db.Char(64)
  sha256            String? @db.Char(64)

  quarantineObjectKey       String    @map("quarantine_object_key")
  quarantineObjectVersionId String?   @map("quarantine_object_version_id")
  quarantineObjectEtag      String?   @map("quarantine_object_etag")
  quarantineDeletedAt       DateTime? @map("quarantine_deleted_at") @db.Timestamptz(6)

  cleanObjectKey       String? @unique(map: "withdrawal_proofs_clean_key") @map("clean_object_key")
  cleanObjectVersionId String? @map("clean_object_version_id")
  cleanObjectEtag      String? @map("clean_object_etag")

  scanEngine    String? @map("scan_engine")
  scanSignature String? @map("scan_signature")
  rejectionCode String? @map("rejection_code")
  failureCode   String? @map("failure_code")
  failureDetail String? @map("failure_detail")

  idempotencyKey  String?  @map("idempotency_key") @db.VarChar(200)
  uploadExpiresAt DateTime @map("upload_expires_at") @db.Timestamptz(6)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  uploadedAt  DateTime? @map("uploaded_at") @db.Timestamptz(6)
  validatedAt DateTime? @map("validated_at") @db.Timestamptz(6)
  scannedAt   DateTime? @map("scanned_at") @db.Timestamptz(6)
  readyAt     DateTime? @map("ready_at") @db.Timestamptz(6)
  rejectedAt  DateTime? @map("rejected_at") @db.Timestamptz(6)
  failedAt    DateTime? @map("failed_at") @db.Timestamptz(6)

  request WithdrawalRequest @relation(fields: [requestId], references: [id], onDelete: Restrict, map: "withdrawal_proofs_request_fkey")

  @@unique([uploadedByUserId, idempotencyKey], map: "withdrawal_proofs_uploader_idempotency")
  @@index([requestId, createdAt], map: "withdrawal_proofs_request_idx")
  @@index([status, uploadExpiresAt], map: "withdrawal_proofs_status_idx")
  @@map("withdrawal_proofs")
}

/// Finance staff assigned to review withdrawals. Assignment grants nothing:
/// a reviewer must hold finance:withdrawal:review through a GLOBAL role, which
/// the database checks on insert and the notification pipeline re-checks.
model WithdrawalReviewer {
  userId          String   @id @map("user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByUserId String?  @map("created_by_user_id") @db.Uuid

  @@map("withdrawal_reviewers")
}

/// Platform-controlled, append-only institution share for one billable product.
model OrganizationServiceShare {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  productCode     ServiceProductCode @map("product_code")
  institutionBps  Int                @map("institution_bps")
  effectiveFrom   DateTime           @map("effective_from") @db.Timestamptz(6)
  changedByUserId String             @map("changed_by_user_id") @db.Uuid
  changeReason    String             @map("change_reason")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, productCode, effectiveFrom(sort: Desc), createdAt(sort: Desc), id(sort: Desc)], map: "organization_service_shares_current_idx")
  @@map("organization_service_shares")
}

/// Trigger-created from the immutable service resource. Never editable by the app.
model ServiceRevenueSnapshot {
  purchaseId     String             @id @map("purchase_id") @db.Uuid
  ownerUserId    String             @map("owner_user_id") @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  productCode    ServiceProductCode @map("product_code")
  policyId       String?            @map("policy_id") @db.Uuid
  institutionBps Int                @map("institution_bps")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("service_revenue_snapshots")
}

/// Two balanced revenue shares for one cash capture or its exact reversal.
model ServiceRevenueEntry {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseId       String             @map("purchase_id") @db.Uuid
  ledgerEntryId    String             @unique @map("ledger_entry_id") @db.Uuid
  reversalOfId     String?            @unique @map("reversal_of_id") @db.Uuid
  ownerUserId      String             @map("owner_user_id") @db.Uuid
  organizationId   String             @map("organization_id") @db.Uuid
  productCode      ServiceProductCode @map("product_code")
  currency         String             @db.VarChar(3)
  grossMinor       BigInt             @map("gross_minor")
  institutionMinor BigInt             @map("institution_minor")
  platformMinor    BigInt             @map("platform_minor")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, createdAt, id], map: "service_revenue_entries_org_idx")
  @@index([purchaseId], map: "service_revenue_entries_purchase_idx")
  @@map("service_revenue_entries")
}
