// PalCert database schema.
//
// Phase 0 intentionally contains NO business entities. It establishes the
// migration pipeline and a single infrastructure table used by the API health
// check to prove real read/write connectivity (not just a TCP handshake).
//
// Domain entities are introduced from Phase 1 onward, each with its own
// migration (§45: never edit an applied migration).

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/client"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  // Used by the Prisma CLI only (migrate, generate, studio). This is the
  // schema-owning identity. The running application NEVER connects with it:
  // `buildPrismaClientOptions` passes the least-privileged application URL,
  // which cannot bypass row-level security (ADR-0018).
  url      = env("DATABASE_ADMIN_URL")
}

/// Infrastructure-only key/value table.
/// Used for schema provenance and for the database health probe.
/// This table is NOT tenant-scoped and must never hold customer data.
model AppMetadata {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_metadata")
}

// =============================================================================
// Phase 1 — Identity, authentication, sessions and RBAC
// =============================================================================

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED
}

enum RoleScope {
  GLOBAL
  ORGANIZATION
}

enum SessionState {
  PENDING_MFA
  ACTIVE
  REVOKED
}

enum AssuranceLevel {
  AAL1
  AAL2
}

enum SessionRevocationReason {
  EXPIRED
  USER_LOGOUT
  USER_LOGOUT_ALL
  USER_REVOKED
  PASSWORD_CHANGED
  PASSWORD_RESET
  ACCOUNT_SUSPENDED
  ACCOUNT_DISABLED
  ADMIN_REVOKED
  SESSION_ROTATED
  MFA_CHANGED
}

enum MfaAuthenticatorType {
  TOTP
}

/// A PalCert identity.
///
/// Phase 1 stores identity-related profile data only; richer profile data
/// belongs to the phases that need it.
model User {
  id String @id @default(uuid()) @db.Uuid

  /// The address exactly as the user typed it, for display and for sending mail.
  email           String
  /// Canonical form used for lookup and uniqueness. See PasswordService/EmailNormalizer.
  normalizedEmail String @unique @map("normalized_email")

  passwordHash      String   @map("password_hash")
  /// Identifies the hashing policy that produced `passwordHash`, so credentials
  /// can be transparently rehashed when the policy changes.
  passwordAlgorithm String   @map("password_algorithm")
  passwordChangedAt DateTime @default(now()) @map("password_changed_at")

  emailVerifiedAt DateTime?  @map("email_verified_at")
  status          UserStatus @default(PENDING_VERIFICATION)

  displayName     String? @map("display_name")
  preferredLocale String  @default("en") @map("preferred_locale")

  /// Forces MFA for this individual regardless of role (security policy escape
  /// hatch). Role-derived requirements are computed from the role catalogue.
  mfaRequiredOverride Boolean @default(false) @map("mfa_required_override")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  lastLoginAt DateTime? @map("last_login_at")

  roles               UserRole[]
  sessions            Session[]
  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  mfaAuthenticators   MfaAuthenticator[]
  mfaRecoveryCodes    MfaRecoveryCode[]
  securityEvents      SecurityEvent[]          @relation("SecurityEventSubject")
  rolesGranted        UserRole[]               @relation("UserRoleGrantedBy")

  organizationsCreated   Organization[]                    @relation("OrganizationCreatedBy")
  memberships            OrganizationMembership[]
  membershipsInvited     OrganizationMembership[]          @relation("MembershipInvitedBy")
  invitationsSent        OrganizationInvitation[]          @relation("InvitationInvitedBy")
  invitationsAccepted    OrganizationInvitation[]          @relation("InvitationAcceptedBy")
  verificationsRequested OrganizationVerificationRequest[] @relation("VerificationRequestedBy")
  verificationsReviewed  OrganizationVerificationRequest[] @relation("VerificationReviewedBy")

  documentTypesCreated      DocumentType[]          @relation("DocumentTypeCreatedBy")
  standardsCreated          Standard[]              @relation("StandardCreatedBy")
  standardVersionsCreated   StandardVersion[]       @relation("StandardVersionCreatedBy")
  standardVersionsPublished StandardVersion[]       @relation("StandardVersionPublishedBy")
  standardVersionImports    StandardVersionImport[] @relation("StandardVersionImportedBy")

  documents                    Document[]                    @relation("DocumentOwner")
  documentVersions             DocumentVersion[]             @relation("DocumentVersionOwner")
  uploadSessions               UploadSession[]               @relation("UploadSessionOwner")
  processingJobs               ProcessingJob[]               @relation("ProcessingJobOwner")
  documentRetentionLocks       DocumentRetentionLock[]       @relation("DocumentRetentionLockOwner")
  documentAnalyses             DocumentAnalysis[]            @relation("DocumentAnalysisOwner")
  documentChecks               DocumentCheck[]               @relation("DocumentCheckOwner")
  checkRuns                    CheckRun[]                    @relation("CheckRunOwner")
  checkRuleResults             CheckRuleResult[]             @relation("CheckRuleResultOwner")
  checkViolations              CheckViolation[]              @relation("CheckViolationOwner")
  checkReports                 CheckReport[]                 @relation("CheckReportOwner")
  aiConsent                    AIConsent?                    @relation("AIConsentUser")
  aiReviews                    AIReview[]                    @relation("AIReviewOwner")
  standardSourcesUploaded      StandardSourceAsset[]         @relation("StandardSourceUploadedBy")
  aiConsentsAccepted           OrganizationAIConsent[]       @relation("OrganizationAIConsentAcceptedBy")
  aiConsentsRevoked            OrganizationAIConsent[]       @relation("OrganizationAIConsentRevokedBy")
  extractionRunsCreated        RuleExtractionRun[]           @relation("RuleExtractionRunCreatedBy")
  proposalDecisions            RuleProposalDecision[]        @relation("RuleProposalDecisionReviewedBy")
  aiInvocations                AIInvocation[]                @relation("AIInvocationOwner")
  aiRuleAssessments            AIRuleAssessment[]            @relation("AIRuleAssessmentOwner")
  aiReportSupplements          AIReportSupplement[]          @relation("AIReportSupplementOwner")
  creditAccounts               CustomerCreditAccount[]       @relation("CreditAccountOwner")
  ledgerEntries                CreditLedgerEntry[]           @relation("LedgerEntryOwner")
  ledgerEntriesCreated         CreditLedgerEntry[]           @relation("LedgerEntryCreatedBy")
  creditHolds                  CreditHold[]                  @relation("CreditHoldOwner")
  priceVersionsCreated         PriceVersion[]                @relation("PriceVersionCreatedBy")
  priceQuotes                  PriceQuote[]                  @relation("PriceQuoteOwner")
  servicePurchases             ServicePurchase[]             @relation("ServicePurchaseOwner")
  purchaseAllocations          ServicePurchaseAllocation[]   @relation("PurchaseAllocationOwner")
  balanceTopUps                BalanceTopUp[]                @relation("BalanceTopUpOwner")
  paymentRefunds               PaymentRefund[]               @relation("PaymentRefundOwner")
  paymentRefundsRequested      PaymentRefund[]               @relation("PaymentRefundRequestedBy")
  paymentDisputes              PaymentDispute[]              @relation("PaymentDisputeOwner")
  smartFixPlans                SmartFixPlan[]                @relation("SmartFixPlanOwner")
  smartFixPlanningReservations SmartFixPlanningReservation[] @relation("SmartFixPlanningOwner")
  smartFixRequests             SmartFixRequest[]             @relation("SmartFixRequestOwner")
  smartFixManifests            SmartFixManifest[]            @relation("SmartFixManifestOwner")
  officialSubmissions          OfficialSubmission[]          @relation("OfficialSubmissionOwner")
  certificates                 ComplianceCertificate[]       @relation("ComplianceCertificateOwner")
  submissionRevisions          SubmissionRevision[]          @relation("SubmissionRevisionOwner")
  domainEventsOwned            DomainEvent[]                 @relation("DomainEventOwner")
  webhookEndpointsCreated      WebhookEndpoint[]             @relation("WebhookEndpointCreatedBy")
  webhookOperations            WebhookManagementOperation[]  @relation("WebhookOperationActor")

  apiClientsCreated       ApiClient[]              @relation("ApiClientCreatedBy")
  apiClientsRevoked       ApiClient[]              @relation("ApiClientRevokedBy")
  apiClientSecrets        ApiClientSecret[]        @relation("ApiClientSecretCreatedBy")
  apiClientOperations     ApiClientOperation[]     @relation("ApiClientOperationActor")
  notifications           UserNotification[]       @relation("UserNotificationRecipient")
  notificationPreferences NotificationPreference[] @relation("NotificationPreferenceUser")

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

/// A capability. Authorization always evaluates permissions, never role names.
model Permission {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique
  description String

  roles RolePermission[]

  @@map("permissions")
}

/// A named bundle of permissions.
///
/// `scope` distinguishes platform-wide roles from roles that are only
/// meaningful within an organization (Phase 2). The distinction is enforced by
/// a database check constraint on `user_roles`, not only in application code.
model Role {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique
  scope       RoleScope
  description String
  requiresMfa Boolean   @default(false) @map("requires_mfa")
  /// System roles come from the code catalogue and may not be deleted.
  isSystem    Boolean   @default(true) @map("is_system")

  permissions RolePermission[]
  users       UserRole[]
  invitations OrganizationInvitation[]

  /// Supports the composite foreign key from `user_roles`, which is what makes
  /// "an organization role can never be granted globally" a database guarantee.
  @@unique([id, scope], map: "roles_id_scope_key")
  @@map("roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// A role granted to a user.
///
/// `organizationId` is null for global roles and carries the organization for
/// organization-scoped roles. Phase 2 resolved the deferred reference: it is
/// now a real foreign key, and a second composite foreign key to
/// `organization_memberships(user_id, organization_id)` makes it impossible to
/// hold an organization role without an active membership record.
model UserRole {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @map("user_id") @db.Uuid
  roleId         String  @map("role_id") @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid

  /// Mirrors the role's scope so a check constraint can require
  /// GLOBAL => organization_id IS NULL and ORGANIZATION => NOT NULL.
  /// Kept honest by a composite foreign key to roles(id, scope).
  scope RoleScope

  grantedByUserId String?  @map("granted_by_user_id") @db.Uuid
  grantedAt       DateTime @default(now()) @map("granted_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy    User?         @relation("UserRoleGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // NULLS NOT DISTINCT is applied in the migration so a user cannot hold the
  // same global role twice (PostgreSQL would otherwise treat each NULL
  // organization_id as distinct).
  @@unique([userId, roleId, organizationId], map: "user_roles_user_role_org_key")
  @@index([userId])
  @@index([roleId])
  @@index([organizationId])
  @@map("user_roles")
}

/// An authenticated (or pending-MFA) browser session.
///
/// The raw session token is NEVER stored. `tokenHash` holds its SHA-256 digest,
/// so a database leak yields no directly replayable credential.
model Session {
  id            String @id @default(uuid()) @db.Uuid
  userId        String @map("user_id") @db.Uuid
  tokenHash     String @unique @map("token_hash")
  /// Digest of the CSRF synchronizer token bound to this session.
  csrfTokenHash String @map("csrf_token_hash")

  state          SessionState   @default(ACTIVE)
  assuranceLevel AssuranceLevel @default(AAL1) @map("assurance_level")
  mfaCompletedAt DateTime?      @map("mfa_completed_at")

  createdAt         DateTime @default(now()) @map("created_at")
  lastActivityAt    DateTime @default(now()) @map("last_activity_at")
  /// Hard ceiling: the session dies at this instant no matter how active it is.
  absoluteExpiresAt DateTime @map("absolute_expires_at")
  /// Rolling ceiling: refreshed on activity, bounded by absoluteExpiresAt.
  idleExpiresAt     DateTime @map("idle_expires_at")

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  revokedAt        DateTime?                @map("revoked_at")
  revocationReason SessionRevocationReason? @map("revocation_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, state])
  @@index([absoluteExpiresAt])
  @@map("sessions")
}

/// Single-use, expiring email-verification token. Only the digest is persisted.
model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

/// Single-use, expiring password-reset token. Only the digest is persisted.
model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// A second authentication factor.
///
/// The TOTP secret is stored encrypted (AES-256-GCM) rather than in plaintext,
/// so a database leak alone does not let an attacker mint valid codes.
/// `lastAcceptedCounter` prevents a captured code from being replayed inside
/// its validity window.
model MfaAuthenticator {
  id     String               @id @default(uuid()) @db.Uuid
  userId String               @map("user_id") @db.Uuid
  type   MfaAuthenticatorType @default(TOTP)

  secretCiphertext String @map("secret_ciphertext")
  secretIv         String @map("secret_iv")
  secretAuthTag    String @map("secret_auth_tag")

  /// Null until the user proves possession with a valid code. An unconfirmed
  /// authenticator never satisfies an MFA challenge.
  confirmedAt         DateTime? @map("confirmed_at")
  lastUsedAt          DateTime? @map("last_used_at")
  lastAcceptedCounter BigInt?   @map("last_accepted_counter")
  createdAt           DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_authenticators")
}

/// Single-use MFA recovery code. Stored as a digest; shown to the user once.
model MfaRecoveryCode {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  codeHash   String    @unique @map("code_hash")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

/// Append-only authentication telemetry, including failures.
///
/// Separate from `audit_events`: this table is high-volume and records attempts
/// (including ones with no known user), whereas the audit log records completed
/// sensitive mutations with before/after state.
model SecurityEvent {
  id     String  @id @default(uuid()) @db.Uuid
  type   String
  userId String? @map("user_id") @db.Uuid

  /// Present when the event was caused by someone other than the subject.
  actorUserId String? @map("actor_user_id") @db.Uuid
  requestId   String? @map("request_id")
  ipAddress   String? @map("ip_address")
  userAgent   String? @map("user_agent")
  /// Non-sensitive structured context. Never contains secrets or tokens.
  metadata    Json    @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation("SecurityEventSubject", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
  @@map("security_events")
}

/// Append-only audit log for sensitive mutations (Master Prompt 30).
model AuditEvent {
  id     String @id @default(uuid()) @db.Uuid
  action String

  /// USER, API_CLIENT or SYSTEM (Phase 19).
  ///
  /// Explicit because a null `actorUserId` used to mean "PalCert itself" and a
  /// machine would have arrived as a second meaning for the same null. An
  /// auditor after an incident needs to tell housekeeping from an integration
  /// credential, and that is precisely what they would be looking for.
  actorType        String  @default("SYSTEM") @map("actor_type")
  actorUserId      String? @map("actor_user_id") @db.Uuid
  actorApiClientId String? @map("actor_api_client_id") @db.Uuid

  targetType String  @map("target_type")
  targetId   String? @map("target_id")

  requestId String? @map("request_id")
  ipAddress String? @map("ip_address")

  /// State before and after the change, with secret fields removed.
  beforeState Json? @map("before_state")
  afterState  Json? @map("after_state")

  createdAt DateTime @default(now()) @map("created_at")

  actorApiClient ApiClient? @relation("ApiClientAuditActor", fields: [actorApiClientId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@index([actorApiClientId, createdAt(sort: Desc)], map: "audit_events_actor_api_client_idx")
  @@index([actorType, createdAt(sort: Desc)], map: "audit_events_actor_type_idx")
  @@map("audit_events")
}

// =============================================================================
// Phase 2 — Organizations, membership, invitations and verification
//
// Every table below is TENANT_SCOPED and is protected by PostgreSQL row-level
// security in addition to application authorization (ADR-0017/0018). The
// policies themselves live in the migration, because Prisma cannot express
// them.
// =============================================================================

enum OrganizationType {
  UNIVERSITY
  SCIENTIFIC_JOURNAL
  PUBLISHER
  RESEARCH_INSTITUTION
  GOVERNMENT
  COMPANY
  OTHER
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum OrganizationVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum VerificationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A PalCert tenant.
///
/// `status` (operational) and `verificationStatus` (identity) are deliberately
/// separate: suspending an organization and rejecting its identity check are
/// unrelated events, and one field could not express both without ambiguity.
model Organization {
  id String @id @default(uuid()) @db.Uuid

  type        OrganizationType
  legalName   String           @map("legal_name")
  displayName String           @map("display_name")
  /// URL-safe handle. Navigation only — never a security boundary (§24).
  slug        String           @unique

  website       String?
  /// ISO 3166-1 alpha-2, uppercase.
  countryCode   String  @map("country_code") @db.Char(2)
  /// IANA timezone identifier, e.g. `Asia/Hebron`.
  timezone      String
  /// Organization default; a member's personal preference still wins (§51).
  defaultLocale String  @default("en") @map("default_locale")

  status             OrganizationStatus             @default(ACTIVE)
  verificationStatus OrganizationVerificationStatus @default(UNVERIFIED) @map("verification_status")

  suspendedAt      DateTime? @map("suspended_at")
  /// PalCert-internal. Never exposed to organization members.
  suspensionReason String?   @map("suspension_reason")
  closedAt         DateTime? @map("closed_at")

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  createdBy            User                              @relation("OrganizationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  memberships          OrganizationMembership[]
  invitations          OrganizationInvitation[]
  verificationRequests OrganizationVerificationRequest[]
  roleAssignments      UserRole[]

  documentTypes               DocumentType[]
  standards                   Standard[]
  standardSourceAssets        StandardSourceAsset[]
  aiConsent                   OrganizationAIConsent?
  extractionRuns              RuleExtractionRun[]
  extractionRunSources        RuleExtractionRunSource[]
  extractionInvocations       ExtractionInvocation[]
  sourceEvidence              SourceEvidence[]
  templateObservations        TemplateObservation[]
  ruleProposals               RuleProposal[]
  ruleProposalEvidence        RuleProposalEvidence[]
  ruleProposalDecisions       RuleProposalDecision[]
  standardRuleProvenance      StandardRuleProvenance[]
  processingJobs              ProcessingJob[]
  standardVersions            StandardVersion[]
  standardVersionImports      StandardVersionImport[]
  standardRules               StandardRule[]
  standardVersionSnapshots    StandardVersionSnapshot[]
  documentChecks              DocumentCheck[]
  domainEvents                DomainEvent[]                @relation("DomainEventOrganization")
  webhookEndpoints            WebhookEndpoint[]            @relation("WebhookEndpointOrganization")
  webhookEvents               WebhookEvent[]               @relation("WebhookEventOrganization")
  webhookManagementOperations WebhookManagementOperation[] @relation("WebhookOperationOrganization")

  apiClients          ApiClient[]          @relation("ApiClientOrganization")
  apiClientOperations ApiClientOperation[] @relation("ApiClientOperationOrganization")
  userNotifications   UserNotification[]   @relation("UserNotificationOrganization")

  @@index([status])
  @@index([verificationStatus])
  @@index([createdAt, id])
  @@map("organizations")
}

/// A user's standing in one organization.
///
/// Membership is the tenant relationship; `UserRole` rows scoped to the same
/// organization carry the capabilities. Keeping them separate avoids a second
/// source of truth: membership answers "may this user act here at all?", roles
/// answer "what may they do?". A user with a membership and no roles is a
/// member with no capabilities, which is a coherent state.
model OrganizationMembership {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid

  status MembershipStatus @default(ACTIVE)

  joinedAt    DateTime  @default(now()) @map("joined_at")
  suspendedAt DateTime? @map("suspended_at")
  removedAt   DateTime? @map("removed_at")

  /// Provenance: who brought this member in, and through which invitation.
  invitedByUserId String? @map("invited_by_user_id") @db.Uuid
  invitationId    String? @map("invitation_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("MembershipInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  /// Supports the composite foreign key from `user_roles`, which is what makes
  /// "no organization role without a membership" a database guarantee.
  @@unique([userId, organizationId], map: "organization_memberships_user_org_key")
  @@index([organizationId, status])
  @@index([userId, status])
  @@index([organizationId, joinedAt, id])
  @@map("organization_memberships")
}

/// An invitation to join an organization in a specific role.
///
/// The raw token is never stored: only its SHA-256 digest, exactly as for
/// session and credential tokens (ADR-0011). The intended organization and role
/// come from this row, never from the client payload (§30).
model OrganizationInvitation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// As typed by the inviter, for display and delivery.
  email           String
  /// Canonical form, using the same normalization as account identity (§62).
  normalizedEmail String @map("normalized_email")

  /// The organization role the invitee will receive. Scope is enforced by a
  /// composite foreign key to `roles(id, scope)`.
  roleId String    @map("role_id") @db.Uuid
  scope  RoleScope @default(ORGANIZATION)

  tokenHash String @unique @map("token_hash")

  status    InvitationStatus @default(PENDING)
  expiresAt DateTime         @map("expires_at")

  invitedByUserId  String    @map("invited_by_user_id") @db.Uuid
  acceptedByUserId String?   @map("accepted_by_user_id") @db.Uuid
  acceptedAt       DateTime? @map("accepted_at")
  revokedByUserId  String?   @map("revoked_by_user_id") @db.Uuid
  revokedAt        DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy    User         @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy   User?        @relation("InvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([normalizedEmail])
  @@index([status, expiresAt])
  @@index([organizationId, createdAt, id])
  @@map("organization_invitations")
}

/// One identity-verification attempt.
///
/// Kept as its own table rather than columns on `organizations` so resubmission
/// after a rejection produces an auditable history rather than overwriting the
/// previous decision.
model OrganizationVerificationRequest {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  status VerificationRequestStatus @default(PENDING)

  requestedByUserId String   @map("requested_by_user_id") @db.Uuid
  requestedAt       DateTime @default(now()) @map("requested_at")
  /// Optional context supplied by the organization.
  submissionNote    String?  @map("submission_note")

  reviewedByUserId String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime? @map("reviewed_at")
  /// Applicant-facing explanation. Safe to show to organization members.
  decisionReason   String?   @map("decision_reason")
  /// Reviewer-only notes. Never returned by any organization-facing endpoint.
  internalNotes    String?   @map("internal_notes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation("VerificationRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  reviewedBy   User?        @relation("VerificationReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, requestedAt])
  @@index([status, requestedAt, id])
  @@map("organization_verification_requests")
}

// =============================================================================
// Phase 3 — Document types, standards, standard versions and rules
//
// Every table below is TENANT_SCOPED. Two structural decisions carry most of
// the safety:
//
//  1. **`organizationId` is denormalized onto every table**, including the
//     children. Each row-level security policy is then a single-column
//     comparison with no subquery or join — cheaper, and impossible to get
//     subtly wrong in a way that only shows up under an unusual query plan.
//
//  2. **Every parent reference is a *composite* foreign key that includes
//     `organization_id`** (declared in the migration, since Prisma cannot model
//     composite foreign keys). That is what makes cross-tenant parent injection
//     — POSTing a rule whose `standardVersionId` belongs to another tenant —
//     a database error rather than something the application must remember to
//     check. The application checks it too; this is the layer that does not
//     forget.
//
// Published immutability is enforced by database triggers as well as by the
// services, for the same reason (§Phase 3).
// =============================================================================

enum DocumentSystemCategory {
  THESIS
  DISSERTATION
  JOURNAL_ARTICLE
  CONFERENCE_PAPER
  BOOK
  BOOK_CHAPTER
  TECHNICAL_REPORT
  GRANT_PROPOSAL
  RESEARCH_PROPOSAL
  GRADUATION_PROJECT
  COURSE_ASSIGNMENT
  ADMINISTRATIVE_DOCUMENT
  OTHER
}

enum DocumentTypeStatus {
  ACTIVE
  ARCHIVED
}

enum StandardStatus {
  ACTIVE
  ARCHIVED
}

enum StandardCheckAvailability {
  PRIVATE
  PUBLIC_CHECKABLE
}

enum CheckStatus {
  CREATED
  WAITING_ANALYSIS
  EVALUATING
  GENERATING_REPORT
  COMPLETED
  FAILED
  CANCELLED
}

enum CheckRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum ComplianceDetermination {
  COMPLIANT
  NON_COMPLIANT
  REVIEW_REQUIRED
  INDETERMINATE
}

enum StandardVersionStatus {
  DRAFT
  PUBLISHED
  /// Replaced by a newer published version. Immutable history, never in force.
  SUPERSEDED
  ARCHIVED
}

enum RuleCategory {
  PAGE_SETUP
  MARGINS
  TYPOGRAPHY
  SPACING
  ALIGNMENT
  PAGINATION
  HEADINGS
  TITLE_PAGE
  ABSTRACT
  KEYWORDS
  TABLE_OF_CONTENTS
  SECTION_STRUCTURE
  TABLES
  FIGURES
  CAPTIONS
  EQUATIONS
  CITATIONS
  REFERENCES
  LANGUAGE_QUALITY
  TERMINOLOGY
  RESEARCH_ETHICS
  DOCUMENT_METADATA
  FILE_TECHNICAL
}

enum RuleEvaluationMode {
  DETERMINISTIC
  AI_ASSISTED
  MANUAL
}

enum RuleOperator {
  EQUALS
  NOT_EQUALS
  GREATER_THAN
  GREATER_THAN_OR_EQUAL
  LESS_THAN
  LESS_THAN_OR_EQUAL
  BETWEEN
  IN
  NOT_IN
  CONTAINS
  NOT_CONTAINS
  MATCHES_PATTERN
  EXISTS
  NOT_EXISTS
}

enum RuleSeverity {
  INFO
  MINOR
  MAJOR
  CRITICAL
}

enum RuleAutofixCapability {
  NONE
  SAFE
  ADVANCED
}

enum RuleOrigin {
  ORGANIZATION_POLICY
  NATIONAL_REGULATION
  PUBLISHER_GUIDELINE
  STYLE_GUIDE
  ACCESSIBILITY_STANDARD
  PALCERT_TEMPLATE
  OTHER
}

enum RuleUnit {
  COUNT
  MILLIMETRE
  CENTIMETRE
  INCH
  POINT
  PIXEL
  PERCENT
  LINES
  WORDS
  CHARACTERS
  PAGES
  MEGABYTE
  DPI
}

/// What kind of document a standard applies to.
///
/// `systemCategory` is the closed PalCert vocabulary that pipelines key off;
/// `name` is whatever the organization calls it. Both are needed: one enum
/// would force organizations to adopt PalCert's words, one free-text field
/// would make every downstream feature string-match on user input.
model DocumentType {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  systemCategory DocumentSystemCategory @map("system_category")
  name           String
  nameAr         String?                @map("name_ar")
  description    String?
  descriptionAr  String?                @map("description_ar")

  status DocumentTypeStatus @default(ACTIVE)

  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  archivedAt      DateTime? @map("archived_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("DocumentTypeCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  standards    Standard[]

  /// Supports the composite foreign key from `standards`: a standard can only
  /// reference a document type belonging to the same organization.
  @@unique([id, organizationId], map: "document_types_id_org_key")
  @@index([organizationId, status])
  @@index([organizationId, name, id])
  @@map("document_types")
}

/// The stable identity of a set of requirements.
///
/// Nothing is ever checked against a `Standard`; checks reference a
/// `StandardVersion`. The standard is what people talk about, the version is
/// what was actually applied.
model Standard {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  documentTypeId String @map("document_type_id") @db.Uuid

  /// Organization-chosen stable handle, e.g. `IUG.THESIS.FORMAT`.
  code          String
  nameEn        String  @map("name_en")
  nameAr        String  @map("name_ar")
  descriptionEn String? @map("description_en")
  descriptionAr String? @map("description_ar")

  status StandardStatus @default(ACTIVE)

  /// Whether people outside the organization may check documents against this
  /// standard. PRIVATE by default and for every existing row: exposing an
  /// institution's standard is a deliberate act, never a migration side
  /// effect (ADR-0046).
  checkAvailability StandardCheckAvailability @default(PRIVATE) @map("check_availability")

  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  archivedAt      DateTime? @map("archived_at")

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentType DocumentType            @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  createdBy    User                    @relation("StandardCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  versions     StandardVersion[]
  imports      StandardVersionImport[]

  @@unique([organizationId, code])
  @@unique([id, organizationId], map: "standards_id_org_key")
  @@index([organizationId, status])
  @@index([organizationId, createdAt, id])
  @@index([documentTypeId])
  @@map("standards")
}

/// One concrete, dated expression of a standard.
///
/// A PUBLISHED version is frozen: `standard_versions_freeze` and
/// `standard_rules_freeze` (see the migration) reject every mutation the
/// lifecycle does not permit, so immutability survives a bug in the service
/// layer or a hand-run UPDATE.
model StandardVersion {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  standardId     String @map("standard_id") @db.Uuid

  /// Human label ("1.0", "2026 revision"). Unique per standard, but never an
  /// identity: nothing is ever resolved by it.
  versionLabel String @map("version_label")

  status StandardVersionStatus @default(DRAFT)

  /// The window in which this version is the one in force. Both optional: many
  /// standards simply apply from publication until replaced.
  effectiveFrom  DateTime? @map("effective_from")
  effectiveUntil DateTime? @map("effective_until")

  /// `sha256:<hex>` over the canonical snapshot. Set exactly once, at
  /// publication, and never changed.
  contentHash             String? @map("content_hash")
  canonicalizationVersion Int?    @map("canonicalization_version")
  ruleSchemaVersion       Int     @default(2) @map("rule_schema_version")

  /// Optimistic-concurrency token, surfaced as the version's ETag. Bumped by
  /// every accepted mutation, including mutations to its rules — the version is
  /// the aggregate root and its rules have no independent lifecycle.
  revision Int @default(1)

  publishedAt       DateTime? @map("published_at")
  publishedByUserId String?   @map("published_by_user_id") @db.Uuid
  archivedAt        DateTime? @map("archived_at")

  /// Set, together, when publishing a newer version replaces this one. Kept
  /// apart from `archivedAt`: being superseded is not being retired.
  supersededAt          DateTime? @map("superseded_at")
  supersededByVersionId String?   @map("superseded_by_version_id") @db.Uuid

  /// Provenance of the clone-to-edit workflow, which is the only supported way
  /// to change a published standard.
  clonedFromVersionId String? @map("cloned_from_version_id") @db.Uuid

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  standard       Standard                 @relation(fields: [standardId], references: [id], onDelete: Cascade)
  createdBy      User                     @relation("StandardVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  publishedBy    User?                    @relation("StandardVersionPublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  clonedFrom     StandardVersion?         @relation("StandardVersionClone", fields: [clonedFromVersionId], references: [id], onDelete: SetNull)
  clones         StandardVersion[]        @relation("StandardVersionClone")
  supersededBy   StandardVersion?         @relation("StandardVersionSupersession", fields: [supersededByVersionId], references: [id], onDelete: NoAction)
  supersedes     StandardVersion[]        @relation("StandardVersionSupersession")
  rules          StandardRule[]
  snapshot       StandardVersionSnapshot?
  documentChecks DocumentCheck[]
  sourceAssets   StandardSourceAsset[]
  extractionRuns RuleExtractionRun[]

  smartFixPlans    SmartFixPlan[]         @relation("SmartFixPlanStandardVersion")
  smartFixRequests SmartFixRequest[]      @relation("SmartFixRequestStandardVersion")
  importRecord     StandardVersionImport?

  @@unique([standardId, versionLabel])
  @@unique([id, organizationId], map: "standard_versions_id_org_key")
  @@index([organizationId, status])
  @@index([standardId, status])
  @@index([standardId, createdAt, id])
  @@index([contentHash])
  @@index([supersededByVersionId])
  @@map("standard_versions")
}

/// A single declarative requirement.
///
/// Relational columns carry everything that is queried or reported on
/// (category, severity, operator, evaluation mode). Only `scope` and
/// `expectedValue` are JSONB, because they are discriminated unions whose
/// shape depends on the discriminant — modelling them relationally would need
/// a dozen mostly-null columns. Both are validated against the versioned
/// contract in `@palcert/contracts` before they are ever written, so the JSONB
/// is a serialization format, not an escape hatch.
model StandardRule {
  id                String @id @default(uuid()) @db.Uuid
  organizationId    String @map("organization_id") @db.Uuid
  standardVersionId String @map("standard_version_id") @db.Uuid

  /// Stable, human-meaningful identity within the version. Findings quote it.
  ruleCode String @map("rule_code")

  category       RuleCategory
  evaluationMode RuleEvaluationMode @map("evaluation_mode")

  /// Discriminated on `kind` (DOCUMENT | SECTION | ELEMENT | METADATA | PAGE).
  scope Json

  operator      RuleOperator
  /// Discriminated on `type` (NUMBER | STRING | BOOLEAN | NUMBER_RANGE |
  /// STRING_LIST | NUMBER_LIST | PATTERN | NONE).
  expectedValue Json         @map("expected_value")

  unit      RuleUnit?
  /// Only permitted where the operator and value type make it meaningful.
  tolerance Decimal?  @db.Decimal(12, 4)

  severity RuleSeverity
  /// A blocking rule stops certification, so only a DETERMINISTIC rule may set
  /// it (ADR-0002). Enforced by validation and by a check constraint.
  blocking Boolean               @default(false)
  autofix  RuleAutofixCapability @default(NONE)

  origin          RuleOrigin @default(ORGANIZATION_POLICY)
  originReference String?    @map("origin_reference")

  titleEn       String  @map("title_en")
  titleAr       String  @map("title_ar")
  descriptionEn String? @map("description_en")
  descriptionAr String? @map("description_ar")
  guidanceEn    String? @map("guidance_en")
  guidanceAr    String? @map("guidance_ar")

  displayOrder      Int @map("display_order")
  /// The rule-schema version this rule was authored under. Never rewritten: a
  /// published v1 rule keeps v1 semantics and its standard keeps its original
  /// content hash (ADR-0030). New content defaults to the current version.
  ruleSchemaVersion Int @default(2) @map("rule_schema_version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  version      StandardVersion @relation(fields: [standardVersionId], references: [id], onDelete: Cascade)

  provenance       StandardRuleProvenance[]
  proposalDecision RuleProposalDecision[]   @relation("RuleProposalDecisionRule")

  @@unique([standardVersionId, ruleCode])
  @@unique([id, organizationId], map: "standard_rules_id_org_key")
  @@index([organizationId])
  @@index([standardVersionId, displayOrder, id])
  @@index([standardVersionId, category])
  @@map("standard_rules")
}

/// The frozen, canonical form of a version at the moment it was published.
///
/// Stored rather than recomputed on demand: recomputation depends on the live
/// tables and on today's canonicalizer, and the entire point is to have
/// something that does not. A verifier re-serializes `canonical` and checks the
/// hash without touching any other table. Append-only, at both layers.
model StandardVersionSnapshot {
  id                String @id @default(uuid()) @db.Uuid
  organizationId    String @map("organization_id") @db.Uuid
  standardVersionId String @unique @map("standard_version_id") @db.Uuid

  /// The exact object that was serialized to produce `contentHash`.
  canonical Json

  contentHash             String @map("content_hash")
  canonicalizationVersion Int    @map("canonicalization_version")
  ruleSchemaVersion       Int    @map("rule_schema_version")
  ruleCount               Int    @map("rule_count")

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  version      StandardVersion @relation(fields: [standardVersionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([contentHash])
  @@map("standard_version_snapshots")
}

// =============================================================================
// Phase 5 — Documents, versions, uploads and processing
//
// Documents are USER_SCOPED: owned by the person who uploaded them, never by an
// organization (ADR-0031). Row-level security confines every row to its owner
// via owner_user_id; the composite foreign keys that carry owner_user_id from a
// version to its document (and from a session or lock to its version) make a
// row that belongs to one user's document but another user's account
// unrepresentable. Those keys, the immutability triggers and the policies live
// in the migration, because Prisma cannot express them.
// =============================================================================

enum DocumentStatus {
  ACTIVE
  DELETED
}

enum DocumentVersionStatus {
  AWAITING_UPLOAD
  UPLOADED
  VALIDATING
  SCANNING
  READY
  REJECTED
  FAILED
  UPLOAD_EXPIRED
  CANCELLED
}

enum DocumentFormat {
  DOCX
  PDF
}

enum UploadSessionStatus {
  CREATED
  FINALIZED
  EXPIRED
  CANCELLED
}

enum ProcessingJobType {
  ATTESTATION_ARTIFACT_INGEST
  ATTESTATION_PAYMENT
  MANUAL_TOPUP_RECEIPT_INGEST
  MANUAL_PAYMENT_METHOD_LOGO_INGEST
  WITHDRAWAL_PROOF_INGEST
  DOCUMENT_INGEST
  DOCUMENT_PURGE
  DOCX_ANALYSIS
  PDF_ANALYSIS
  SUBMISSION_PREPARE
  CERTIFICATE_ISSUE
  CHECK_PREPARE
  CHECK_EVALUATION
  AI_REVIEW
  STANDARD_SOURCE_INGEST
  RULE_EXTRACTION
  PAYMENT_EVENT
  PAYMENT_RECONCILIATION
  SMARTFIX_EXECUTE
  SMARTFIX_FINALIZE
  NOTIFICATION_FANOUT
  NOTIFICATION_EMAIL_SEND
  WEBHOOK_FANOUT
  WEBHOOK_DELIVER
  WEBHOOK_ENDPOINT_VERIFY
}

enum ProcessingJobStatus {
  PENDING
  DISPATCHED
  RUNNING
  SUCCEEDED
  RETRY_PENDING
  DEAD
}

/// A person's logical document. Carries no academic or compliance state: the
/// standard it is checked against, scores, decisions and certificates belong
/// to later domains that reference an exact version.
model Document {
  id          String         @id @default(uuid()) @db.Uuid
  ownerUserId String         @map("owner_user_id") @db.Uuid
  displayName String         @map("display_name")
  status      DocumentStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  /// Set once every version's clean object has been confirmed deleted.
  purgedAt  DateTime? @map("purged_at")

  owner               User                 @relation("DocumentOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  versions            DocumentVersion[]
  sessions            UploadSession[]
  documentChecks      DocumentCheck[]
  officialSubmissions OfficialSubmission[]

  @@index([ownerUserId, status, updatedAt])
  @@map("documents")
}

/// One immutable uploaded file. The workflow columns (status, timestamps,
/// codes) change as PalCert processes it; the identity columns (owner, bytes,
/// SHA-256, size, format, clean object) are frozen by trigger once set.
model DocumentVersion {
  id            String                @id @default(uuid()) @db.Uuid
  documentId    String                @map("document_id") @db.Uuid
  ownerUserId   String                @map("owner_user_id") @db.Uuid
  versionNumber Int                   @map("version_number")
  status        DocumentVersionStatus @default(AWAITING_UPLOAD)

  /// Sanitized, user-facing only. Never a path, key or argument.
  originalFilename String          @map("original_filename")
  /// What the browser claimed. Advisory.
  declaredMimeType String?         @map("declared_mime_type")
  /// What the extension implies, fixed at creation; the content must agree.
  expectedFormat   DocumentFormat  @map("expected_format")
  /// What the bytes actually are, established by the worker.
  detectedFormat   DocumentFormat? @map("detected_format")
  detectedMimeType String?         @map("detected_mime_type")

  /// The size the authorization was issued for; the actual size must match.
  declaredSizeBytes Int     @map("declared_size_bytes")
  /// Authoritative, measured over the finalized bytes by the worker.
  sizeBytes         Int?    @map("size_bytes")
  /// Authoritative SHA-256 (lower-case hex), computed by PalCert over exact bytes.
  sha256            String?
  /// Optional client-supplied digest, for early mismatch detection only.
  clientSha256      String? @map("client_sha256")

  quarantineObjectKey       String    @map("quarantine_object_key")
  /// The exact object version finalized; the worker processes this and nothing newer.
  quarantineObjectVersionId String?   @map("quarantine_object_version_id")
  quarantineObjectEtag      String?   @map("quarantine_object_etag")
  quarantineDeletedAt       DateTime? @map("quarantine_deleted_at")

  cleanObjectKey       String?   @unique @map("clean_object_key")
  cleanObjectVersionId String?   @map("clean_object_version_id")
  cleanObjectEtag      String?   @map("clean_object_etag")
  /// Set once the clean object has been confirmed deleted after a soft delete.
  purgedAt             DateTime? @map("purged_at")

  rejectionCode String? @map("rejection_code")
  failureCode   String? @map("failure_code")
  /// Safe operational detail (never a stack trace, never document content).
  failureDetail String? @map("failure_detail")
  scanEngine    String? @map("scan_engine")
  scanSignature String? @map("scan_signature")

  /// Where this version's bytes came from (Phase 12 §2).
  ///
  /// A SmartFix correction is a *new version*, never a rewrite: the original
  /// is what the author uploaded and what every earlier check was run against,
  /// and PalCert has no business editing it.
  origin                  DocumentVersionOrigin @default(USER_UPLOAD)
  /// The version this one was corrected from. Set for SMARTFIX origin only.
  sourceDocumentVersionId String?               @map("source_document_version_id") @db.Uuid
  /// The correction that produced it. One request, one corrected version.
  smartFixRequestId       String?               @unique @map("smartfix_request_id") @db.Uuid

  /// Whether the owner may see this version at all (Phase 12 §84, §85).
  ///
  /// A correction is generated, ingested, analyzed and rechecked before
  /// anybody has paid for it, and during all of that it must not be visible or
  /// downloadable. Rather than inventing a second kind of document with its
  /// own storage and its own read paths — which would mean the recheck ran
  /// against something the check pipeline had never seen — the corrected file
  /// is an ordinary version that the owner cannot yet reach. Delivery flips
  /// this, in the same transaction that charges for it.
  visibleToOwner Boolean @default(true) @map("visible_to_owner")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  uploadedAt  DateTime? @map("uploaded_at")
  validatedAt DateTime? @map("validated_at")
  scannedAt   DateTime? @map("scanned_at")
  readyAt     DateTime? @map("ready_at")
  rejectedAt  DateTime? @map("rejected_at")
  failedAt    DateTime? @map("failed_at")

  document       Document                @relation(fields: [documentId], references: [id], onDelete: Cascade)
  owner          User                    @relation("DocumentVersionOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  uploadSession  UploadSession?
  retentionLocks DocumentRetentionLock[]
  analyses       DocumentAnalysis[]
  checks         DocumentCheck[]

  sourceVersion     DocumentVersion?  @relation("SmartFixLineage", fields: [sourceDocumentVersionId], references: [id], onDelete: Restrict)
  correctedVersions DocumentVersion[] @relation("SmartFixLineage")
  smartFixRequest   SmartFixRequest?  @relation("SmartFixCorrectedVersion", fields: [smartFixRequestId], references: [id], onDelete: Restrict)
  smartFixSources   SmartFixRequest[] @relation("SmartFixSourceVersion")
  smartFixPlans     SmartFixPlan[]    @relation("SmartFixPlanSourceVersion")

  @@unique([id, ownerUserId], map: "document_versions_id_owner_key")
  @@unique([documentId, versionNumber])
  @@index([ownerUserId, status])
  @@index([status, updatedAt])
  @@index([sourceDocumentVersionId])
  @@map("document_versions")
}

/// The authority for one browser upload. Created before any presigned URL is
/// generated; the URL is never the session identifier and is never stored.
model UploadSession {
  id                String              @id @default(uuid()) @db.Uuid
  ownerUserId       String              @map("owner_user_id") @db.Uuid
  documentId        String              @map("document_id") @db.Uuid
  documentVersionId String              @unique @map("document_version_id") @db.Uuid
  status            UploadSessionStatus @default(CREATED)

  /// The server-generated quarantine key; immutable.
  storageKey        String  @map("storage_key")
  /// Client-chosen key that makes create-version safe to retry.
  idempotencyKey    String? @map("idempotency_key")
  declaredSizeBytes Int     @map("declared_size_bytes")
  declaredMimeType  String? @map("declared_mime_type")
  clientSha256      String? @map("client_sha256")

  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  finalizedAt DateTime? @map("finalized_at")
  cancelledAt DateTime? @map("cancelled_at")
  expiredAt   DateTime? @map("expired_at")

  owner    User            @relation("UploadSessionOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  document Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version  DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, idempotencyKey])
  @@index([status, expiresAt])
  @@map("upload_sessions")
}

/// Durable processing intent (the transactional outbox, ADR-0036) and the
/// record of what happened to it. The queue carries only this row's id.
model ProcessingJob {
  id             String              @id @default(uuid()) @db.Uuid
  jobType        ProcessingJobType   @map("job_type")
  resourceType   String              @map("resource_type")
  resourceId     String              @map("resource_id") @db.Uuid
  ownerUserId    String?             @map("owner_user_id") @db.Uuid
  /// The tenant whose row this job processes, for organization-owned work
  /// (Phase 9). Null for the user-private work of Phases 5-8. A worker
  /// re-establishes its scope from this column rather than from the queue
  /// message, exactly as it does from `ownerUserId` (ADR-0018).
  organizationId String?             @map("organization_id") @db.Uuid
  /// `{jobType}:{resourceId}` — duplicate dispatch cannot create duplicate work.
  idempotencyKey String              @unique @map("idempotency_key")
  status         ProcessingJobStatus @default(PENDING)

  attemptCount   Int       @default(0) @map("attempt_count")
  maxAttempts    Int       @map("max_attempts")
  availableAt    DateTime  @default(now()) @map("available_at")
  dispatchedAt   DateTime? @map("dispatched_at")
  startedAt      DateTime? @map("started_at")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  completedAt    DateTime? @map("completed_at")
  deadAt         DateTime? @map("dead_at")

  lastFailureCode    String? @map("last_failure_code")
  /// Safe diagnostics for operators. Never a stack trace or document content.
  lastFailureMessage String? @map("last_failure_message")
  workerId           String? @map("worker_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner        User?         @relation("ProcessingJobOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([resourceType, resourceId])
  @@map("processing_jobs")
}

/// A reason a version's bytes must be kept. Later phases insert one for every
/// check, report, certificate, financial record or submission that references
/// the version; physical deletion refuses while any lock exists.
/// One reading of one immutable document version by one analyzer version.
///
/// Derived, private, user-scoped data. A successful analysis is immutable: a
/// new analyzer version produces a *new* row so that a check recorded months
/// ago still resolves to the exact facts that produced it (ADR-0041).
model DocumentAnalysis {
  id                String @id @default(uuid()) @db.Uuid
  documentVersionId String @map("document_version_id") @db.Uuid
  ownerUserId       String @map("owner_user_id") @db.Uuid

  /// Semantic analyzer identity, never a git commit (ADR-0039).
  analyzerName          String @map("analyzer_name")
  analyzerVersion       String @map("analyzer_version")
  factSchemaVersion     Int    @map("fact_schema_version")
  analysisSchemaVersion Int    @map("analysis_schema_version")

  status String @default("PENDING")

  /// The version's SHA-256 as it stood when this analysis was requested; the
  /// analyzer verifies the bytes against it before believing anything (§5).
  sourceSha256 String @map("source_sha256")

  /// The artifact in derived storage. Written once, on success.
  artifactObjectKey       String? @unique @map("artifact_object_key")
  artifactObjectVersionId String? @map("artifact_object_version_id")
  artifactSha256          String? @map("artifact_sha256")
  artifactSizeBytes       Int?    @map("artifact_size_bytes")

  factCount    Int?     @map("fact_count")
  warningCount Int?     @map("warning_count")
  /// Distinct warning codes, for operators. Never prose, never document text.
  warningCodes String[] @default([]) @map("warning_codes")
  /// Counters only (§113). No title, no filename, no text.
  summary      Json?

  failureCode   String? @map("failure_code")
  /// Operator-facing and content-free.
  failureDetail String? @map("failure_detail")
  durationMs    Int?    @map("duration_ms")

  /// Set when the derived artifact object has been deleted (Phase 7).
  /// The row itself survives: a report that cites this analysis must still be
  /// able to say which analyzer produced its evidence, even after the bytes
  /// are gone. Never set while a completed check holds a retention lock.
  artifactPurgedAt DateTime? @map("artifact_purged_at")

  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  failedAt    DateTime? @map("failed_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  version        DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  owner          User            @relation("DocumentAnalysisOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  documentChecks DocumentCheck[]
  checkRuns      CheckRun[]

  @@index([documentVersionId, status])
  @@index([ownerUserId])
  @@map("document_analyses")
}

model DocumentRetentionLock {
  id                String  @id @default(uuid()) @db.Uuid
  documentVersionId String  @map("document_version_id") @db.Uuid
  ownerUserId       String  @map("owner_user_id") @db.Uuid
  lockType          String  @map("lock_type")
  reference         String?

  createdAt DateTime @default(now()) @map("created_at")

  version DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  owner   User            @relation("DocumentRetentionLockOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([documentVersionId])
  @@map("document_retention_locks")
}

// =============================================================================
// Phase 7 — Document checks, results and reports
//
// Every table here is USER_SCOPED. A check references the organization whose
// standard it used, and that reference is metadata for reporting only: the
// organization gains no visibility of the user's document, findings or report.
// Official submission (Phase 14) is the explicit act that will grant access.
// =============================================================================

/// One user's request to check one document version against one standard
/// version. Its bindings are captured at creation and never change (ADR-0047).
model DocumentCheck {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @map("owner_user_id") @db.Uuid

  documentId        String @map("document_id") @db.Uuid
  documentVersionId String @map("document_version_id") @db.Uuid

  /// Reference metadata for the report and the catalogue. Not ownership.
  organizationId    String @map("organization_id") @db.Uuid
  documentTypeId    String @map("document_type_id") @db.Uuid
  standardId        String @map("standard_id") @db.Uuid
  standardVersionId String @map("standard_version_id") @db.Uuid

  /// Captured at creation, verified before evaluation. A check that cannot
  /// prove it read the same bytes and the same rules is not a check.
  documentSha256      String @map("document_sha256")
  standardContentHash String @map("standard_content_hash")

  /// Catalogue labels captured at creation.
  ///
  /// Denormalized on purpose. The owner is not a member of the organization
  /// that published the standard, so their session genuinely cannot read its
  /// tables — and must not be able to. Copying the public catalogue labels the
  /// user already saw when they chose the standard is what lets a check render
  /// without weakening that isolation, and what keeps a historical check
  /// readable after the standard is renamed or withdrawn (§46, §57).
  organizationName     String @map("organization_name")
  documentTypeName     String @map("document_type_name")
  standardCode         String @map("standard_code")
  standardName         String @map("standard_name")
  standardVersionLabel String @map("standard_version_label")

  status       CheckStatus @default(CREATED)
  currentRunId String?     @map("current_run_id") @db.Uuid

  /// Why this check exists (Phase 12 §95, §96).
  ///
  /// A SmartFix recheck is part of the correction the user already bought, so
  /// it carries no purchase of its own. Classifying it in the database rather
  /// than in a service is what stops that from becoming a free-check bypass:
  /// a SMARTFIX_RECHECK row must name a SmartFix request that owns it, and
  /// anything else must be paid for.
  purpose           CheckPurpose @default(USER_REQUESTED)
  /// The correction this recheck belongs to. Null for a user's own check.
  smartFixRequestId String?      @unique @map("smartfix_request_id") @db.Uuid

  /// The analysis this check is waiting on, once one exists.
  documentAnalysisId String? @map("document_analysis_id") @db.Uuid

  /// The purchase that paid for this check (Phase 11 §21).
  ///
  /// Nullable only for checks created before checks were paid for. A database
  /// trigger requires it on every new row, so the free path cannot come back
  /// by accident while historical checks stay readable for ever (§4).
  servicePurchaseId String? @unique @map("service_purchase_id") @db.Uuid

  /// Deduplicates a browser retry, never two intentional checks (§61).
  idempotencyKey String? @map("idempotency_key")

  failureCode   String? @map("failure_code")
  /// Operator-facing and content-free.
  failureDetail String? @map("failure_detail")

  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  failedAt    DateTime? @map("failed_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  owner           User              @relation("DocumentCheckOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  document        Document          @relation(fields: [documentId], references: [id], onDelete: Restrict)
  documentVersion DocumentVersion   @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  standardVersion StandardVersion   @relation(fields: [standardVersionId], references: [id], onDelete: Restrict)
  analysis        DocumentAnalysis? @relation(fields: [documentAnalysisId], references: [id], onDelete: SetNull)
  servicePurchase ServicePurchase?  @relation("DocumentCheckPurchase", fields: [servicePurchaseId], references: [id], onDelete: Restrict)
  runs            CheckRun[]
  reports         CheckReport[]
  aiReviews       AIReview[]

  smartFixRecheckOf            SmartFixRequest?              @relation("SmartFixRecheck", fields: [smartFixRequestId], references: [id], onDelete: Restrict)
  smartFixPlans                SmartFixPlan[]                @relation("SmartFixPlanCheck")
  smartFixPlanningReservations SmartFixPlanningReservation[] @relation("SmartFixPlanningCheck")
  smartFixRequests             SmartFixRequest[]             @relation("SmartFixRequestCheck")

  @@unique([ownerUserId, idempotencyKey], map: "document_checks_owner_idempotency_key")
  @@unique([id, ownerUserId], map: "document_checks_id_owner_key")
  @@index([ownerUserId, createdAt, id])
  @@index([documentVersionId])
  @@index([status, documentAnalysisId])
  @@map("document_checks")
}

/// One technical attempt at evaluating a check. A retry or an engine upgrade
/// creates another run; a succeeded run is never rewritten (§30, §37).
model CheckRun {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @map("owner_user_id") @db.Uuid
  checkId     String @map("check_id") @db.Uuid

  /// 1-based, so a report can say which attempt produced it.
  attemptNumber Int @map("attempt_number")

  documentAnalysisId     String? @map("document_analysis_id") @db.Uuid
  analysisArtifactSha256 String? @map("analysis_artifact_sha256")

  ruleEngineName      String? @map("rule_engine_name")
  ruleEngineVersion   String? @map("rule_engine_version")
  ruleSchemaVersion   Int?    @map("rule_schema_version")
  factSchemaVersion   Int?    @map("fact_schema_version")
  orchestratorVersion String  @map("orchestrator_version")

  status CheckRunStatus @default(PENDING)

  determination ComplianceDetermination? @map("determination")

  /// Exact decimal strings; the display rounding happens in the UI (§12).
  scoreValue       String?  @map("score_value")
  scoreCoverage    String?  @map("score_coverage")
  scoreComplete    Boolean? @map("score_complete")
  passedWeight     String?  @map("passed_weight")
  evaluatedWeight  String?  @map("evaluated_weight")
  unresolvedWeight String?  @map("unresolved_weight")

  /// Identifies the semantic outcome, independent of which check produced it.
  evaluationHash String? @map("evaluation_hash")

  /// Counters for lists, so a history page needs no joins.
  totalRules          Int? @map("total_rules")
  passedRules         Int? @map("passed_rules")
  failedRules         Int? @map("failed_rules")
  notApplicableRules  Int? @map("not_applicable_rules")
  reviewRequiredRules Int? @map("review_required_rules")
  indeterminateRules  Int? @map("indeterminate_rules")
  blockingFailures    Int? @map("blocking_failures")
  criticalFailures    Int? @map("critical_failures")
  majorFailures       Int? @map("major_failures")
  minorFailures       Int? @map("minor_failures")
  infoFailures        Int? @map("info_failures")
  totalViolations     Int? @map("total_violations")

  failureCode   String? @map("failure_code")
  failureDetail String? @map("failure_detail")
  durationMs    Int?    @map("duration_ms")

  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  failedAt    DateTime? @map("failed_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  owner     User              @relation("CheckRunOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  check     DocumentCheck     @relation(fields: [checkId], references: [id], onDelete: Cascade)
  analysis  DocumentAnalysis? @relation(fields: [documentAnalysisId], references: [id], onDelete: Restrict)
  results   CheckRuleResult[]
  reports   CheckReport[]
  aiReviews AIReview[]

  @@unique([checkId, attemptNumber])
  @@index([ownerUserId])
  @@index([checkId, createdAt])
  @@map("check_runs")
}

/// One rule, as evaluated by one run. Presentation fields are copied from the
/// immutable standard snapshot so a historical report renders without reading
/// a private organization table (§36).
model CheckRuleResult {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @map("owner_user_id") @db.Uuid
  checkRunId  String @map("check_run_id") @db.Uuid

  ruleCode       String
  category       String
  evaluationMode String  @map("evaluation_mode")
  severity       String
  blocking       Boolean
  displayOrder   Int     @map("display_order")

  outcome        String
  reasonCode     String  @map("reason_code")
  evidenceLevel  String  @map("evidence_level")
  requiresReview Boolean @map("requires_review")
  operator       String?

  matchedFactCount       Int @default(0) @map("matched_fact_count")
  evaluatedFactCount     Int @default(0) @map("evaluated_fact_count")
  passedFactCount        Int @default(0) @map("passed_fact_count")
  failedFactCount        Int @default(0) @map("failed_fact_count")
  indeterminateFactCount Int @default(0) @map("indeterminate_fact_count")

  totalViolationCount    Int     @default(0) @map("total_violation_count")
  returnedViolationCount Int     @default(0) @map("returned_violation_count")
  violationsTruncated    Boolean @default(false) @map("violations_truncated")

  titleEn    String? @map("title_en")
  titleAr    String? @map("title_ar")
  guidanceEn String? @map("guidance_en")
  guidanceAr String? @map("guidance_ar")

  createdAt DateTime @default(now()) @map("created_at")

  owner      User             @relation("CheckRuleResultOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  run        CheckRun         @relation(fields: [checkRunId], references: [id], onDelete: Cascade)
  violations CheckViolation[]

  @@unique([checkRunId, ruleCode])
  @@index([ownerUserId])
  @@index([checkRunId, outcome])
  @@map("check_rule_results")
}

/// One failing observation. Typed evidence, never evaluator prose (§38).
model CheckViolation {
  id                String @id @default(uuid()) @db.Uuid
  ownerUserId       String @map("owner_user_id") @db.Uuid
  checkRuleResultId String @map("check_rule_result_id") @db.Uuid

  /// Position within the rule's returned violations, so order is stable.
  ordinal Int

  reasonCode String @map("reason_code")

  nodeId          String?  @map("node_id")
  path            String[] @default([])
  elementType     String?  @map("element_type")
  sectionKey      String?  @map("section_key")
  locationOrdinal Int?     @map("location_ordinal")
  /// Only when the extractor genuinely knew it. DOCX analysis never does.
  page            Int?

  expectedValue String? @map("expected_value")
  expectedUnit  String? @map("expected_unit")
  actualValue   String? @map("actual_value")
  actualUnit    String? @map("actual_unit")
  tolerance     String?

  owner  User            @relation("CheckViolationOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  result CheckRuleResult @relation(fields: [checkRuleResultId], references: [id], onDelete: Cascade)

  @@unique([checkRuleResultId, ordinal])
  @@index([ownerUserId])
  @@map("check_violations")
}

/// The immutable machine report. The artifact lives in derived storage; this
/// row is its identity and integrity (§45).
model CheckReport {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @map("owner_user_id") @db.Uuid
  checkId     String @map("check_id") @db.Uuid
  checkRunId  String @unique @map("check_run_id") @db.Uuid

  reportSchemaVersion           Int @map("report_schema_version")
  reportCanonicalizationVersion Int @map("report_canonicalization_version")

  artifactObjectKey       String  @unique @map("artifact_object_key")
  artifactObjectVersionId String? @map("artifact_object_version_id")
  artifactSha256          String  @map("artifact_sha256")
  artifactSizeBytes       Int     @map("artifact_size_bytes")

  reportHash     String @map("report_hash")
  evaluationHash String @map("evaluation_hash")

  createdAt DateTime @default(now()) @map("created_at")

  owner     User          @relation("CheckReportOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  check     DocumentCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)
  run       CheckRun      @relation(fields: [checkRunId], references: [id], onDelete: Cascade)
  aiReviews AIReview[]

  @@index([ownerUserId, createdAt])
  @@index([checkId])
  @@map("check_reports")
}

enum AIReviewStatus {
  CREATED
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AIAssessment {
  SATISFIED
  NOT_SATISFIED
  INSUFFICIENT_EVIDENCE
}

/// A user's standing agreement that their document content may be processed by
/// the configured external AI provider (Phase 8, §14, §63).
///
/// User-scoped, always. An organization cannot opt somebody's private thesis
/// into third-party processing, however much it would like the data.
model AIConsent {
  id          String @id @default(uuid()) @db.Uuid
  /// Named like every other user-scoped table's owner column, because the
  /// row-level security coverage test reads the convention rather than a list.
  ownerUserId String @unique @map("owner_user_id") @db.Uuid

  consentVersion   String    @map("consent_version")
  providerCategory String    @map("provider_category")
  consentedAt      DateTime  @map("consented_at")
  /// Set when the user takes it back. The row survives, because "they agreed
  /// once and then withdrew" is a different fact from "they never agreed".
  withdrawnAt      DateTime? @map("withdrawn_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner User @relation("AIConsentUser", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@map("ai_consents")
}

/// One AI review of one completed check (Phase 8, §10, §12).
///
/// Binds immutably to every identity the deterministic evidence rests on, so a
/// review can always say exactly which document, which rules and which report
/// it was formed against — and so it can be refused outright if any of them
/// stopped matching.
model AIReview {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @map("owner_user_id") @db.Uuid

  /// ADR-0149: the purchase that pays for this review. NULL only on reviews
  /// created before AI billing existed; a trigger refuses NULL on new rows.
  servicePurchaseId String?          @unique @map("service_purchase_id") @db.Uuid
  servicePurchase   ServicePurchase? @relation("AIReviewPurchase", fields: [servicePurchaseId], references: [id], onDelete: Restrict)

  checkId    String @map("check_id") @db.Uuid
  checkRunId String @map("check_run_id") @db.Uuid
  reportId   String @map("report_id") @db.Uuid

  /// Captured at creation and verified before any content is sent (§85).
  reportHash             String @map("report_hash")
  evaluationHash         String @map("evaluation_hash")
  documentVersionId      String @map("document_version_id") @db.Uuid
  documentSha256         String @map("document_sha256")
  analysisId             String @map("analysis_id") @db.Uuid
  analysisArtifactSha256 String @map("analysis_artifact_sha256")
  standardVersionId      String @map("standard_version_id") @db.Uuid
  standardContentHash    String @map("standard_content_hash")

  /// Identity of what produced this review. A different model or prompt is a
  /// different review, never an overwrite (§11, §45).
  provider              String
  configuredModel       String  @map("configured_model")
  providerReturnedModel String? @map("provider_returned_model")
  promptVersion         String  @map("prompt_version")
  promptHash            String  @map("prompt_hash")
  contextBuilderVersion String  @map("context_builder_version")
  contextSchemaVersion  Int     @map("context_schema_version")
  contextHash           String? @map("context_hash")
  rulesHash             String? @map("rules_hash")

  aiReviewSchemaVersion           Int @map("ai_review_schema_version")
  aiReviewCanonicalizationVersion Int @map("ai_review_canonicalization_version")

  status AIReviewStatus @default(CREATED)

  /// Integrity of the completed structured output (§46, §78).
  aiReviewHash String? @map("ai_review_hash")

  /// Counters for lists, so a history page needs no joins.
  assessmentCount           Int? @map("assessment_count")
  humanReviewRequiredCount  Int? @map("human_review_required_count")
  insufficientEvidenceCount Int? @map("insufficient_evidence_count")

  contextTruncated Boolean @default(false) @map("context_truncated")

  /// Aggregated usage (§79). Never a money amount: prices change, and a cost
  /// baked into a row now would be wrong later.
  inputTokens      Int? @map("input_tokens")
  outputTokens     Int? @map("output_tokens")
  cacheReadTokens  Int? @map("cache_read_tokens")
  cacheWriteTokens Int? @map("cache_write_tokens")

  failureKind   String? @map("failure_kind")
  /// Operator-facing and content-free: never a prompt, never a response (§81).
  failureDetail String? @map("failure_detail")

  idempotencyKey String? @map("idempotency_key")

  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  failedAt    DateTime? @map("failed_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  owner       User                @relation("AIReviewOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  check       DocumentCheck       @relation(fields: [checkId], references: [id], onDelete: Cascade)
  run         CheckRun            @relation(fields: [checkRunId], references: [id], onDelete: Cascade)
  report      CheckReport         @relation(fields: [reportId], references: [id], onDelete: Restrict)
  assessments AIRuleAssessment[]
  invocations AIInvocation[]
  supplement  AIReportSupplement?

  @@unique([ownerUserId, idempotencyKey], map: "ai_reviews_owner_idempotency_key")
  @@index([ownerUserId, createdAt, id])
  @@index([checkId, createdAt])
  @@index([status])
  @@map("ai_reviews")
}

/// One provider call (§47).
///
/// The ledger of what was actually sent where, and what it cost. Never the API
/// key, never the prompt, never the raw response (§48).
model AIInvocation {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @map("owner_user_id") @db.Uuid
  aiReviewId  String @map("ai_review_id") @db.Uuid

  provider String
  purpose  String

  configuredModel       String  @map("configured_model")
  providerReturnedModel String? @map("provider_returned_model")

  promptVersion         String @map("prompt_version")
  promptHash            String @map("prompt_hash")
  contextBuilderVersion String @map("context_builder_version")
  /// Proves which normalized data was supplied, without storing it (§77).
  contextHash           String @map("context_hash")
  rulesHash             String @map("rules_hash")

  status  String
  attempt Int

  providerRequestId String? @map("provider_request_id")

  inputTokens      Int? @map("input_tokens")
  outputTokens     Int? @map("output_tokens")
  cacheReadTokens  Int? @map("cache_read_tokens")
  cacheWriteTokens Int? @map("cache_write_tokens")

  startedAt   DateTime  @map("started_at")
  completedAt DateTime? @map("completed_at")
  latencyMs   Int?      @map("latency_ms")

  failureKind   String? @map("failure_kind")
  failureDetail String? @map("failure_detail")

  createdAt DateTime @default(now()) @map("created_at")

  owner  User     @relation("AIInvocationOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  review AIReview @relation(fields: [aiReviewId], references: [id], onDelete: Cascade)

  @@unique([aiReviewId, purpose, attempt])
  @@index([ownerUserId])
  @@index([aiReviewId, startedAt])
  @@map("ai_invocations")
}

/// One rule, as the AI assessed it (§24, §28).
///
/// Deliberately a different table and a different vocabulary from
/// `check_rule_results`: an advisory assessment and a machine measurement must
/// never be confusable for one another in storage, let alone on a page.
model AIRuleAssessment {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @map("owner_user_id") @db.Uuid
  aiReviewId  String @map("ai_review_id") @db.Uuid

  ruleCode String  @map("rule_code")
  severity String
  blocking Boolean

  assessment          AIAssessment
  reasonCode          String       @map("reason_code")
  evidenceSufficiency String       @map("evidence_sufficiency")
  uncertaintyReasons  String[]     @default([]) @map("uncertainty_reasons")

  /// Validated against the ids actually supplied for this task (§29).
  evidenceNodeIds String[] @default([]) @map("evidence_node_ids")

  explanationEn String @map("explanation_en")
  explanationAr String @map("explanation_ar")

  /// Always true for a blocking rule, whatever the model concluded (§26).
  requiresHumanReview Boolean @map("requires_human_review")

  /// The Phase 7 outcome this sits beside, copied so a reader always sees both.
  deterministicOutcome String? @map("deterministic_outcome")

  createdAt DateTime @default(now()) @map("created_at")

  owner  User     @relation("AIRuleAssessmentOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  review AIReview @relation(fields: [aiReviewId], references: [id], onDelete: Cascade)

  @@unique([aiReviewId, ruleCode])
  @@index([ownerUserId])
  @@index([aiReviewId, assessment])
  @@map("ai_rule_assessments")
}

/// The user-facing narrative (§39).
///
/// Carries no score, no determination and no certification status — there is
/// no column in which one could be stored.
model AIReportSupplement {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @map("owner_user_id") @db.Uuid
  aiReviewId  String @unique @map("ai_review_id") @db.Uuid

  schemaVersion Int @map("schema_version")

  summaryEn String @map("summary_en")
  summaryAr String @map("summary_ar")

  /// Recommendations as validated structured JSON, plain text throughout (§91).
  priorityRecommendations Json @map("priority_recommendations")

  createdAt DateTime @default(now()) @map("created_at")

  owner  User     @relation("AIReportSupplementOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  review AIReview @relation(fields: [aiReviewId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
  @@map("ai_report_supplements")
}

// ===========================================================================
// Phase 9 — guideline sources, rule extraction and proposals
//
// The whole phase rests on one sentence: AI proposes, an authorized human
// decides. These tables are shaped so that sentence holds even if a service
// forgets it — AI output and human decisions are different rows, an accepted
// rule is an ordinary Phase 3 rule, and nothing here can reach a published
// version.
//
// Unlike documents (which are user-private, ADR-0031), every table here is
// ORGANIZATION-scoped: an institution's own guidelines belong to the
// institution.
// ===========================================================================

/// A guideline or template an organization uploaded for one draft version.
///
/// The Phase 5 upload session is folded in rather than modelled separately: a
/// source has exactly one upload for its whole life, because replacing a
/// guideline means uploading another source, never overwriting this one (§8).
model StandardSourceAsset {
  id                String @id @default(uuid()) @db.Uuid
  organizationId    String @map("organization_id") @db.Uuid
  standardVersionId String @map("standard_version_id") @db.Uuid

  sourceKind StandardSourceKind       @map("source_kind")
  status     StandardSourceStatus     @default(AWAITING_UPLOAD)
  /// What the institution says this source is worth. Never inferred (§64).
  authority  StandardSourceAuthority? @map("authority")

  originalFilename String          @map("original_filename")
  declaredMimeType String?         @map("declared_mime_type")
  detectedMimeType String?         @map("detected_mime_type")
  expectedFormat   DocumentFormat  @map("expected_format")
  detectedFormat   DocumentFormat? @map("detected_format")

  declaredSizeBytes Int     @map("declared_size_bytes")
  sizeBytes         Int?    @map("size_bytes")
  clientSha256      String? @map("client_sha256")
  sha256            String? @map("sha256")
  /// Pages, once known. Used to refuse a PDF the provider could not read (§89).
  pageCount         Int?    @map("page_count")

  quarantineObjectKey       String    @map("quarantine_object_key")
  quarantineObjectVersionId String?   @map("quarantine_object_version_id")
  quarantineObjectEtag      String?   @map("quarantine_object_etag")
  quarantineDeletedAt       DateTime? @map("quarantine_deleted_at")

  cleanObjectKey       String? @map("clean_object_key")
  cleanObjectVersionId String? @map("clean_object_version_id")
  cleanObjectEtag      String? @map("clean_object_etag")

  scanEngine          String? @map("scan_engine")
  scanSignature       String? @map("scan_signature")
  /// Legacy equation objects (MathType, Equation 3.0) accepted in safe mode:
  /// classified structurally and never executed. Immutable once READY.
  legacyEquationCount Int     @default(0) @map("legacy_equation_count")

  /// One source per key, so a retried create returns the same row (§113).
  idempotencyKey  String?  @map("idempotency_key")
  uploadExpiresAt DateTime @map("upload_expires_at")

  rejectionCode String? @map("rejection_code")
  failureCode   String? @map("failure_code")
  failureDetail String? @map("failure_detail")

  /// Set when an accepted rule's provenance depends on this source, after
  /// which it cannot be deleted: an explanation that points at a missing file
  /// is not an explanation (§101, §102).
  retentionLockedAt DateTime? @map("retention_locked_at")

  uploadedByUserId String?   @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  uploadedAt       DateTime? @map("uploaded_at")
  validatedAt      DateTime? @map("validated_at")
  scannedAt        DateTime? @map("scanned_at")
  readyAt          DateTime? @map("ready_at")
  rejectedAt       DateTime? @map("rejected_at")
  failedAt         DateTime? @map("failed_at")
  cancelledAt      DateTime? @map("cancelled_at")

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  standardVersion StandardVersion @relation(fields: [standardVersionId], references: [id], onDelete: Cascade)
  uploadedBy      User?           @relation("StandardSourceUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  runSources   RuleExtractionRunSource[]
  evidence     SourceEvidence[]
  observations TemplateObservation[]
  provenance   StandardRuleProvenance[]

  @@unique([organizationId, idempotencyKey], map: "standard_source_assets_org_idempotency_key")
  @@unique([id, organizationId], map: "standard_source_assets_id_org_key")
  @@index([standardVersionId, createdAt, id])
  @@index([organizationId, status])
  @@map("standard_source_assets")
}

/// An organization's agreement that its own documents may be processed by an
/// external AI provider.
///
/// Deliberately not the Phase 8 personal consent: a student agreeing about
/// their thesis says nothing about an institution's guidelines, and an
/// institution cannot agree on a student's behalf (§15, §157).
model OrganizationAIConsent {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @unique @map("organization_id") @db.Uuid

  consentVersion   String    @map("consent_version")
  providerCategory String    @map("provider_category")
  acceptedAt       DateTime  @map("accepted_at")
  acceptedByUserId String?   @map("accepted_by_user_id") @db.Uuid
  revokedAt        DateTime? @map("revoked_at")
  revokedByUserId  String?   @map("revoked_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  acceptedBy   User?        @relation("OrganizationAIConsentAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  revokedBy    User?        @relation("OrganizationAIConsentRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@map("organization_ai_consents")
}

/// One reading of one exact set of sources.
///
/// Binds the sources and their digests at creation, so "run the extraction
/// again" can never quietly mean "read whatever is there now" (§36).
model RuleExtractionRun {
  id                String @id @default(uuid()) @db.Uuid
  organizationId    String @map("organization_id") @db.Uuid
  standardVersionId String @map("standard_version_id") @db.Uuid

  /// ADR-0149: the purchase that pays for this run, owned by the member who
  /// started it — never by the organization. NULL only on runs created before
  /// AI billing existed; a trigger refuses NULL on new rows.
  servicePurchaseId String?          @unique @map("service_purchase_id") @db.Uuid
  servicePurchase   ServicePurchase? @relation("RuleExtractionRunPurchase", fields: [servicePurchaseId], references: [id], onDelete: Restrict)

  status RuleExtractionStatus @default(CREATED)

  /// The draft's revision when the run started. The draft may move while the
  /// provider works; acceptance re-checks the current revision rather than
  /// invalidating everything the run found (§71).
  baseStandardRevision Int @map("base_standard_revision")
  /// The rule schema the proposals were written against.
  ruleSchemaVersion    Int @map("rule_schema_version")

  provider              String
  configuredModel       String  @map("configured_model")
  providerReturnedModel String? @map("provider_returned_model")

  promptVersion         String @map("prompt_version")
  promptHash            String @map("prompt_hash")
  contextBuilderVersion String @map("context_builder_version")
  proposalSchemaVersion Int    @map("proposal_schema_version")

  /// Identity of the exact source set, independent of row order (§40).
  sourceSetHash     String  @map("source_set_hash")
  /// Identity of the finished run. Never mixed with a standard content hash (§121).
  extractionRunHash String? @map("extraction_run_hash")

  /// Counters, so a history page needs no joins (§92).
  sourcesProcessed                Int? @map("sources_processed")
  evidenceCount                   Int? @map("evidence_count")
  observationCount                Int? @map("observation_count")
  explicitRequirementCount        Int? @map("explicit_requirement_count")
  templateInferenceCount          Int? @map("template_inference_count")
  ambiguousRequirementCount       Int? @map("ambiguous_requirement_count")
  conflictingRequirementCount     Int? @map("conflicting_requirement_count")
  unrepresentableRequirementCount Int? @map("unrepresentable_requirement_count")
  invalidProposalCount            Int? @map("invalid_proposal_count")

  /// Tokens, never a money amount: prices change and a cost baked in now would
  /// be wrong later (§107).
  inputTokens     Int? @map("input_tokens")
  outputTokens    Int? @map("output_tokens")
  invocationCount Int  @default(0) @map("invocation_count")

  failureKind   String? @map("failure_kind")
  /// Operator-facing and content-free: never a prompt, a response or an
  /// excerpt of somebody's guideline (§150).
  failureDetail String? @map("failure_detail")

  idempotencyKey String? @map("idempotency_key")

  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  failedAt        DateTime? @map("failed_at")
  cancelledAt     DateTime? @map("cancelled_at")

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  standardVersion StandardVersion @relation(fields: [standardVersionId], references: [id], onDelete: Cascade)
  createdBy       User?           @relation("RuleExtractionRunCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  sources      RuleExtractionRunSource[]
  invocations  ExtractionInvocation[]
  evidence     SourceEvidence[]
  observations TemplateObservation[]
  proposals    RuleProposal[]
  provenance   StandardRuleProvenance[]

  @@unique([organizationId, idempotencyKey], map: "rule_extraction_runs_org_idempotency_key")
  @@unique([id, organizationId], map: "rule_extraction_runs_id_org_key")
  @@index([standardVersionId, createdAt, id])
  @@index([organizationId, status])
  @@map("rule_extraction_runs")
}

/// Exactly which sources a run read, and the bytes they were.
model RuleExtractionRunSource {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @map("organization_id") @db.Uuid
  extractionRunId String @map("extraction_run_id") @db.Uuid
  sourceAssetId   String @map("source_asset_id") @db.Uuid

  sourceKind   StandardSourceKind @map("source_kind")
  /// The digest at bind time. Re-verified before the source is read (§120).
  sourceSha256 String             @map("source_sha256")
  ordinal      Int

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run          RuleExtractionRun   @relation(fields: [extractionRunId], references: [id], onDelete: Cascade)
  source       StandardSourceAsset @relation(fields: [sourceAssetId], references: [id], onDelete: Restrict)

  @@unique([extractionRunId, sourceAssetId])
  @@index([organizationId])
  @@map("rule_extraction_run_sources")
}

/// One provider call inside an extraction. Opened before the call, so a crash
/// leaves a record rather than a silence (§79).
model ExtractionInvocation {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @map("organization_id") @db.Uuid
  extractionRunId String @map("extraction_run_id") @db.Uuid

  provider      String
  purpose       String
  /// Which source this call was about, when it was about one.
  sourceAssetId String? @map("source_asset_id") @db.Uuid

  configuredModel       String  @map("configured_model")
  providerReturnedModel String? @map("provider_returned_model")
  promptVersion         String  @map("prompt_version")
  promptHash            String  @map("prompt_hash")
  contextBuilderVersion String  @map("context_builder_version")

  status  String
  attempt Int

  providerRequestId String? @map("provider_request_id")

  inputTokens  Int? @map("input_tokens")
  outputTokens Int? @map("output_tokens")

  startedAt   DateTime  @map("started_at")
  completedAt DateTime? @map("completed_at")
  latencyMs   Int?      @map("latency_ms")

  failureKind   String? @map("failure_kind")
  failureDetail String? @map("failure_detail")

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run          RuleExtractionRun @relation(fields: [extractionRunId], references: [id], onDelete: Cascade)

  @@unique([extractionRunId, purpose, sourceAssetId, attempt], map: "extraction_invocations_call_identity")
  @@index([organizationId])
  @@map("extraction_invocations")
}

/// A passage of a source, grounded in a provider citation.
///
/// Never the model's prose: the citation is the part of a Pass A response that
/// can be checked against the document, and it is the only part stored (§25).
model SourceEvidence {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @map("organization_id") @db.Uuid
  extractionRunId String @map("extraction_run_id") @db.Uuid
  sourceAssetId   String @map("source_asset_id") @db.Uuid

  evidenceKind EvidenceKind        @map("evidence_kind")
  locatorType  EvidenceLocatorType @map("locator_type")

  startPage      Int?     @map("start_page")
  endPage        Int?     @map("end_page")
  /// PalCert node ids, for a DOCX citation mapped back from block indices (§29).
  nodeIds        String[] @map("node_ids")
  startCharIndex Int?     @map("start_char_index")
  endCharIndex   Int?     @map("end_char_index")

  /// Bounded (§135). Escaped on render; never treated as markup (§152).
  excerpt     String
  excerptHash String @map("excerpt_hash")
  /// Stable position, so lists and hashes do not depend on insertion order (§161).
  ordinal     Int

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run          RuleExtractionRun   @relation(fields: [extractionRunId], references: [id], onDelete: Cascade)
  source       StandardSourceAsset @relation(fields: [sourceAssetId], references: [id], onDelete: Restrict)

  proposalLinks RuleProposalEvidence[]

  @@unique([extractionRunId, excerptHash], map: "source_evidence_run_excerpt_key")
  @@unique([id, organizationId], map: "source_evidence_id_org_key")
  @@index([extractionRunId, ordinal])
  @@index([organizationId])
  @@map("source_evidence")
}

/// A deterministic measurement of a template.
///
/// Computed by PalCert from the Phase 6 fact set, never by a model. A template
/// that happens to use 12 pt is a fact about one document, and the distinction
/// from "the institution requires 12 pt" is the whole point (§4, §32).
model TemplateObservation {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @map("organization_id") @db.Uuid
  extractionRunId String @map("extraction_run_id") @db.Uuid
  sourceAssetId   String @map("source_asset_id") @db.Uuid

  /// Canonical "kind:qualifier:property" key, for grouping and for the hash.
  scopeKey String  @map("scope_key")
  /// The Phase 3 rule scope this observation would translate into.
  scope    Json
  property String
  unit     String?

  /// The most common observed value, as an exact string. Not a requirement
  /// until a person says it is (§33).
  modalValue         String?               @map("modal_value")
  occurrenceCount    Int                   @map("occurrence_count")
  matchingCount      Int                   @map("matching_count")
  distinctValueCount Int                   @map("distinct_value_count")
  uniformity         ObservationUniformity
  /// The top few values and their counts. Bounded (§135).
  distribution       Json

  observationHash String @map("observation_hash")
  ordinal         Int

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run          RuleExtractionRun   @relation(fields: [extractionRunId], references: [id], onDelete: Cascade)
  source       StandardSourceAsset @relation(fields: [sourceAssetId], references: [id], onDelete: Restrict)

  proposalLinks RuleProposalEvidence[]

  @@unique([extractionRunId, observationHash], map: "template_observations_run_hash_key")
  @@unique([id, organizationId], map: "template_observations_id_org_key")
  @@index([extractionRunId, ordinal])
  @@index([organizationId])
  @@map("template_observations")
}

/// What the AI suggested. Immutable once written (§65, §153).
model RuleProposal {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @map("organization_id") @db.Uuid
  extractionRunId String @map("extraction_run_id") @db.Uuid

  /// The model's own handle, kept so relationships inside one response survive.
  proposalKey String             @map("proposal_key")
  kind        RuleProposalKind
  status      RuleProposalStatus @default(PENDING_REVIEW)

  /// PalCert's verdict on the AI's rule definition, from the ordinary Phase 3
  /// validator at the draft's own schema version. AI gets no bypass (§58).
  validationStatus ProposalValidationStatus @map("validation_status")
  validationIssues Json?                    @map("validation_issues")

  /// Whether PalCert can measure this today. PalCert-derived, never the
  /// model's opinion (§52).
  automationSupport AutomationSupport @map("automation_support")

  conflictStatus           ProposalConflictStatus @map("conflict_status")
  conflictExistingRuleId   String?                @map("conflict_existing_rule_id") @db.Uuid
  conflictExistingRuleCode String?                @map("conflict_existing_rule_code")
  conflictDetail           String?                @map("conflict_detail")
  /// Other proposals in the same run this one disagrees or overlaps with (§62).
  relatedProposalKeys      String[]               @map("related_proposal_keys")

  /// Exactly as proposed. A human edit lives on the decision, never here (§68).
  suggestedRule     Json?   @map("suggested_rule")
  suggestedRuleCode String? @map("suggested_rule_code")

  interpretationEn      String  @map("interpretation_en")
  interpretationAr      String  @map("interpretation_ar")
  ambiguityNote         String? @map("ambiguity_note")
  requiresClarification Boolean @map("requires_clarification")

  displayOrder Int @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run          RuleExtractionRun @relation(fields: [extractionRunId], references: [id], onDelete: Cascade)

  evidenceLinks RuleProposalEvidence[]
  decision      RuleProposalDecision?
  provenance    StandardRuleProvenance[]

  @@unique([extractionRunId, proposalKey])
  @@unique([id, organizationId], map: "rule_proposals_id_org_key")
  @@index([extractionRunId, displayOrder])
  @@index([organizationId, status])
  @@map("rule_proposals")
}

/// What one proposal rests on. Exactly one of the two links is set.
model RuleProposalEvidence {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  proposalId     String @map("proposal_id") @db.Uuid

  sourceEvidenceId      String? @map("source_evidence_id") @db.Uuid
  templateObservationId String? @map("template_observation_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposal     RuleProposal         @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  evidence     SourceEvidence?      @relation(fields: [sourceEvidenceId], references: [id], onDelete: Cascade)
  observation  TemplateObservation? @relation(fields: [templateObservationId], references: [id], onDelete: Cascade)

  @@unique([proposalId, sourceEvidenceId], map: "rule_proposal_evidence_proposal_evidence_key")
  @@unique([proposalId, templateObservationId], map: "rule_proposal_evidence_proposal_observation_key")
  @@index([organizationId])
  @@map("rule_proposal_evidence")
}

/// What a person decided about a proposal.
///
/// A separate row from the proposal on purpose: rewriting AI history to look
/// like the model proposed what the human chose would destroy the only record
/// of who actually decided (§66).
model RuleProposalDecision {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  proposalId     String @unique @map("proposal_id") @db.Uuid

  decision         RuleProposalStatus
  reviewedByUserId String?            @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime           @map("reviewed_at")

  resultingRuleId String? @map("resulting_rule_id") @db.Uuid
  rejectionReason String? @map("rejection_reason")
  reviewNotes     String? @map("review_notes")
  /// The rule as the human actually accepted it, when they changed it (§68).
  acceptedRule    Json?   @map("accepted_rule")

  createdAt DateTime @default(now()) @map("created_at")

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposal      RuleProposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  resultingRule StandardRule? @relation("RuleProposalDecisionRule", fields: [resultingRuleId], references: [id], onDelete: SetNull)
  reviewedBy    User?         @relation("RuleProposalDecisionReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, decision])
  @@map("rule_proposal_decisions")
}

/// Where an accepted rule came from.
///
/// Provenance metadata only. It deliberately does not participate in the Phase
/// 3 canonical snapshot, so adding it changes no published content hash (§77).
model StandardRuleProvenance {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  standardRuleId  String @map("standard_rule_id") @db.Uuid
  extractionRunId String @map("extraction_run_id") @db.Uuid
  proposalId      String @map("proposal_id") @db.Uuid
  sourceAssetId   String @map("source_asset_id") @db.Uuid
  sourceSha256    String @map("source_sha256")

  evidenceKind EvidenceKind        @map("evidence_kind")
  locatorType  EvidenceLocatorType @map("locator_type")
  startPage    Int?                @map("start_page")
  endPage      Int?                @map("end_page")
  nodeIds      String[]            @map("node_ids")

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule         StandardRule        @relation(fields: [standardRuleId], references: [id], onDelete: Cascade)
  run          RuleExtractionRun   @relation(fields: [extractionRunId], references: [id], onDelete: Restrict)
  proposal     RuleProposal        @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  source       StandardSourceAsset @relation(fields: [sourceAssetId], references: [id], onDelete: Restrict)

  @@index([standardRuleId])
  @@index([organizationId])
  @@index([sourceAssetId])
  @@map("standard_rule_provenance")
}

enum StandardSourceKind {
  GUIDELINE_PDF
  GUIDELINE_DOCX
  TEMPLATE_DOCX
}

enum StandardSourceStatus {
  AWAITING_UPLOAD
  UPLOADED
  VALIDATING
  SCANNING
  READY
  REJECTED
  FAILED
  CANCELLED
  UPLOAD_EXPIRED
}

enum StandardSourceAuthority {
  PRIMARY
  SUPPLEMENTARY
  REFERENCE
}

enum RuleExtractionStatus {
  CREATED
  QUEUED
  DISCOVERING_EVIDENCE
  GENERATING_PROPOSALS
  VALIDATING
  COMPLETED
  FAILED
  CANCELLED
}

enum EvidenceKind {
  EXPLICIT_TEXT
  VISUAL_EVIDENCE
  TEMPLATE_OBSERVATION
}

enum EvidenceLocatorType {
  PDF_PAGE
  DOCX_NODE
  TEXT_CHAR
  FACT_SCOPE
  NONE
}

enum ObservationUniformity {
  UNIFORM
  MOSTLY_UNIFORM
  MIXED
  INSUFFICIENT_SAMPLE
}

enum RuleProposalKind {
  EXPLICIT_REQUIREMENT
  TEMPLATE_INFERENCE
  AMBIGUOUS_REQUIREMENT
  CONFLICTING_REQUIREMENT
  UNREPRESENTABLE_REQUIREMENT
}

enum RuleProposalStatus {
  PENDING_REVIEW
  ACCEPTED
  MODIFIED_AND_ACCEPTED
  REJECTED
  SUPERSEDED
}

enum ProposalValidationStatus {
  VALID
  INVALID
  NOT_APPLICABLE
}

enum ProposalConflictStatus {
  NONE
  EXISTING_RULE_CODE
  EXISTING_RULE_EXPECTATION
  CROSS_SOURCE
}

enum AutomationSupport {
  SUPPORTED_DOCX
  PARTIAL_DOCX
  NOT_CURRENTLY_MEASURABLE
  NOT_APPLICABLE
}

// ===========================================================================
// Phase 10 — Customer credit balance, payments, pricing and refunds
//
// The whole subsystem rests on one decision: a balance is not a column, it is
// the sum of an append-only ledger (ADR-0069). Every model below exists to
// make that sum trustworthy — accounts to group entries, holds to reserve
// against them without spending, and payment records to explain where the
// money came from and where it went.
//
// Money is BIGINT minor units with an ISO 4217 currency, never a float and
// never a Decimal (ADR-0068).
// ===========================================================================

enum CreditClass {
  CASH
  PROMOTIONAL
}

enum LedgerEntryType {
  TOP_UP_CREDIT
  SERVICE_CHARGE
  SERVICE_REFUND
  PAYMENT_REFUND_DEBIT
  PROMOTIONAL_CREDIT
  ADMIN_CREDIT
  ADMIN_DEBIT
  CHARGEBACK_DEBIT
  CHARGEBACK_REVERSAL
  MANUAL_TOPUP_CREDIT
  WITHDRAWAL_DEBIT
}

enum LedgerReferenceType {
  BALANCE_TOP_UP
  CREDIT_HOLD
  PAYMENT_REFUND
  LEDGER_ENTRY
  ADMIN_ADJUSTMENT
  PAYMENT_DISPUTE
  SERVICE_PURCHASE
  ATTESTATION_REQUEST
  MANUAL_TOPUP_REQUEST
  WITHDRAWAL_REQUEST
}

enum LedgerReasonCode {
  TOP_UP_VERIFIED
  SERVICE_CAPTURED
  SERVICE_FAILED
  SERVICE_CANCELLED
  CUSTOMER_REQUEST
  GOODWILL
  PROMOTION
  BILLING_CORRECTION
  PROVIDER_DISPUTE
  PROVIDER_DISPUTE_WON
  EXTERNAL_REFUND
  ATTESTATION_FEE
  MANUAL_TOPUP_APPROVED
  WITHDRAWAL_PAID
}

enum CreditHoldStatus {
  ACTIVE
  CAPTURED
  RELEASED
  EXPIRED
}

enum CreditHoldPurpose {
  SERVICE
  EXTERNAL_REFUND
  WITHDRAWAL
}

enum ServiceResourceType {
  DOCUMENT_CHECK
  SMARTFIX
  AI_REVIEW
  AI_RULE_EXTRACTION
}

enum ServicePurchaseStatus {
  RESERVED
  PROCESSING
  DELIVERED
  RELEASED
  REFUNDED
  RECONCILIATION_REQUIRED
}

enum ServiceProductCode {
  DOCUMENT_CHECK
  SMARTFIX
  EXPERTFIX
  AI_REVIEW
  AI_RULE_EXTRACTION
}

enum PriceVersionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum TopUpStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  RECONCILIATION_REQUIRED
}

enum PaymentRefundStatus {
  REQUESTED
  PENDING
  SUCCEEDED
  FAILED
  RECONCILIATION_REQUIRED
}

enum PaymentRefundReason {
  REQUESTED_BY_CUSTOMER
  DUPLICATE
  FRAUDULENT
  SERVICE_NOT_DELIVERED
  GOODWILL
}

enum PaymentEventKind {
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  PAYMENT_CANCELLED
  PAYMENT_EXPIRED
  REFUND_SUCCEEDED
  REFUND_FAILED
  PAYMENT_DISPUTED
  DISPUTE_REVERSED
  UNSUPPORTED
}

enum ProviderEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum PaymentObjectKind {
  TOP_UP
  REFUND
  DISPUTE
  UNKNOWN
}

enum PaymentDisputeStatus {
  OPEN
  LOST
  WON
}

/// One customer's credit in one currency and one class.
///
/// Identity is `(ownerUserId, currency, creditClass)`. Splitting cash from
/// promotional at the account level rather than tagging entries means "how
/// much of this is refundable?" is a balance query, not an audit.
model CustomerCreditAccount {
  id          String      @id @default(uuid()) @db.Uuid
  ownerUserId String      @map("owner_user_id") @db.Uuid
  currency    String      @db.VarChar(3)
  creditClass CreditClass @map("credit_class")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner   User                @relation("CreditAccountOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  entries CreditLedgerEntry[] @relation("LedgerEntryAccount")
  holds   CreditHold[]        @relation("CreditHoldAccount")

  @@unique([ownerUserId, currency, creditClass], map: "credit_accounts_identity")
  @@index([ownerUserId])
  @@map("customer_credit_accounts")
}

/// One immutable movement of credit.
///
/// Never updated, never deleted — enforced by triggers, not by discipline
/// (§12, §129). A correction is another row pointing back at this one.
model CreditLedgerEntry {
  id          String      @id @default(uuid()) @db.Uuid
  ownerUserId String      @map("owner_user_id") @db.Uuid
  accountId   String      @map("account_id") @db.Uuid
  currency    String      @db.VarChar(3)
  creditClass CreditClass @map("credit_class")

  entryType         LedgerEntryType @map("entry_type")
  /// Signed minor units. Negative is a debit. Never zero.
  amountMinorSigned BigInt          @map("amount_minor_signed")

  referenceType LedgerReferenceType? @map("reference_type")
  referenceId   String?              @map("reference_id") @db.Uuid

  /// Scoped to the owner, so one user's key cannot block another's write.
  idempotencyKey String? @map("idempotency_key") @db.VarChar(200)

  reversalOfEntryId String?           @map("reversal_of_entry_id") @db.Uuid
  reasonCode        LedgerReasonCode? @map("reason_code")
  /// Who caused it, when a person did. Null for automatic entries.
  createdByUserId   String?           @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner      User                  @relation("LedgerEntryOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  account    CustomerCreditAccount @relation("LedgerEntryAccount", fields: [accountId], references: [id], onDelete: Cascade)
  reversalOf CreditLedgerEntry?    @relation("LedgerEntryReversal", fields: [reversalOfEntryId], references: [id], onDelete: Restrict)
  reversals  CreditLedgerEntry[]   @relation("LedgerEntryReversal")
  createdBy  User?                 @relation("LedgerEntryCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([ownerUserId, idempotencyKey], map: "ledger_entries_owner_idempotency")
  @@index([accountId, createdAt, id])
  @@index([ownerUserId, createdAt, id])
  @@index([referenceType, referenceId])
  @@index([reversalOfEntryId])
  @@map("credit_ledger_entries")
}

/// Credit reserved but not yet spent.
///
/// The lifecycle is one-way: an ACTIVE hold becomes CAPTURED, RELEASED or
/// EXPIRED and never moves again (§21, §101).
model CreditHold {
  id          String      @id @default(uuid()) @db.Uuid
  ownerUserId String      @map("owner_user_id") @db.Uuid
  accountId   String      @map("account_id") @db.Uuid
  currency    String      @db.VarChar(3)
  creditClass CreditClass @map("credit_class")

  purpose     CreditHoldPurpose
  status      CreditHoldStatus  @default(ACTIVE)
  /// Positive minor units. A hold for nothing reserves nothing (§101).
  amountMinor BigInt            @map("amount_minor")

  /// What the hold is for, so Phase 11 can find its own.
  referenceType LedgerReferenceType? @map("reference_type")
  referenceId   String?              @map("reference_id") @db.Uuid

  idempotencyKey String? @map("idempotency_key") @db.VarChar(200)

  /// The ledger entry created when it was captured. Null until then.
  capturedEntryId String? @unique @map("captured_entry_id") @db.Uuid

  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  capturedAt DateTime? @map("captured_at") @db.Timestamptz(6)
  releasedAt DateTime? @map("released_at") @db.Timestamptz(6)
  expiredAt  DateTime? @map("expired_at") @db.Timestamptz(6)

  owner      User                       @relation("CreditHoldOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  account    CustomerCreditAccount      @relation("CreditHoldAccount", fields: [accountId], references: [id], onDelete: Cascade)
  refund     PaymentRefund?             @relation("PaymentRefundHold")
  allocation ServicePurchaseAllocation? @relation("PurchaseAllocationHold")

  @@unique([ownerUserId, idempotencyKey], map: "credit_holds_owner_idempotency")
  @@index([accountId, status])
  @@index([ownerUserId, createdAt, id])
  @@index([status, expiresAt])
  @@map("credit_holds")
}

/// A sellable PalCert service. Global: an organization never owns one (§24).
model ServiceProduct {
  productCode   ServiceProductCode @id @map("product_code")
  active        Boolean            @default(false)
  nameEn        String             @map("name_en") @db.VarChar(120)
  nameAr        String             @map("name_ar") @db.VarChar(120)
  descriptionEn String?            @map("description_en") @db.VarChar(500)
  descriptionAr String?            @map("description_ar") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  priceVersions PriceVersion[]    @relation("PriceVersionProduct")
  quotes        PriceQuote[]      @relation("PriceQuoteProduct")
  purchases     ServicePurchase[] @relation("ServicePurchaseProduct")

  @@map("service_products")
}

/// One price, for one product, currency and market, over one period.
///
/// Once ACTIVE its financial fields are frozen (§28): a price change is a new
/// row, so a charge from last year is still explainable by the row it used.
model PriceVersion {
  id          String             @id @default(uuid()) @db.Uuid
  productCode ServiceProductCode @map("product_code")
  /// A future geographic dimension, single-valued for now (§33).
  marketCode  String             @default("GLOBAL") @map("market_code") @db.VarChar(16)
  currency    String             @db.VarChar(3)
  amountMinor BigInt             @map("amount_minor")

  status         PriceVersionStatus @default(DRAFT)
  effectiveFrom  DateTime?          @map("effective_from") @db.Timestamptz(6)
  effectiveUntil DateTime?          @map("effective_until") @db.Timestamptz(6)

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  activatedAt     DateTime? @map("activated_at") @db.Timestamptz(6)
  retiredAt       DateTime? @map("retired_at") @db.Timestamptz(6)

  product   ServiceProduct    @relation("PriceVersionProduct", fields: [productCode], references: [productCode], onDelete: Restrict)
  createdBy User?             @relation("PriceVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  quotes    PriceQuote[]      @relation("PriceQuotePriceVersion")
  purchases ServicePurchase[] @relation("ServicePurchasePriceVersion")

  @@index([productCode, currency, marketCode, status])
  @@map("price_versions")
}

/// An immutable capture of what a service costs one customer, right now.
///
/// The client never states a price; it asks for one (§31). The amount is
/// copied here so a later price change cannot rewrite what was quoted (§32).
/// One customer buying one deliverable service (Phase 11 §5, §6).
///
/// Deliberately generic: `productCode` says what was bought and
/// `(resourceType, resourceId)` says which instance of it. Phase 11 sells
/// document checks and nothing else, but a later phase selling something else
/// reuses reservation, capture, release and refund rather than rebuilding
/// them — which is the whole reason this is not a `check_payments` table.
///
/// The financial identity — owner, product, resource, quote, price version,
/// currency and amount — is immutable once written, enforced by
/// `service_purchases_guard` rather than by hoping no service updates it.
model ServicePurchase {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @map("owner_user_id") @db.Uuid

  productCode  ServiceProductCode  @map("product_code")
  resourceType ServiceResourceType @map("resource_type")
  /// The thing bought. No foreign key on purpose: the purchase is written
  /// first, with the id the resource is about to be created under (§20).
  resourceId   String              @map("resource_id") @db.Uuid

  /// The quote that fixed the price, and the price version behind it. A quote
  /// funds at most one purchase (§16).
  priceQuoteId   String @unique @map("price_quote_id") @db.Uuid
  priceVersionId String @map("price_version_id") @db.Uuid

  currency    String @db.VarChar(3)
  amountMinor BigInt @map("amount_minor")

  status ServicePurchaseStatus @default(RESERVED)

  /// Why it ended without delivery. Never a compliance outcome (§31).
  failureCode String? @map("failure_code")

  /// Deduplicates the whole commercial request, not just the check (§18).
  idempotencyKey String? @map("idempotency_key") @db.VarChar(200)

  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  reservedAt   DateTime  @default(now()) @map("reserved_at") @db.Timestamptz(6)
  processingAt DateTime? @map("processing_at") @db.Timestamptz(6)
  deliveredAt  DateTime? @map("delivered_at") @db.Timestamptz(6)
  releasedAt   DateTime? @map("released_at") @db.Timestamptz(6)
  refundedAt   DateTime? @map("refunded_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner            User                         @relation("ServicePurchaseOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  product          ServiceProduct               @relation("ServicePurchaseProduct", fields: [productCode], references: [productCode], onDelete: Restrict)
  priceQuote       PriceQuote                   @relation("ServicePurchaseQuote", fields: [priceQuoteId], references: [id], onDelete: Restrict)
  priceVersion     PriceVersion                 @relation("ServicePurchasePriceVersion", fields: [priceVersionId], references: [id], onDelete: Restrict)
  allocations      ServicePurchaseAllocation[]  @relation("PurchaseAllocations")
  check            DocumentCheck?               @relation("DocumentCheckPurchase")
  smartFix         SmartFixRequest?             @relation("SmartFixRequestPurchase")
  smartFixPlanning SmartFixPlanningReservation? @relation("SmartFixPlanningPurchase")
  aiReview         AIReview?                    @relation("AIReviewPurchase")
  ruleExtraction   RuleExtractionRun?           @relation("RuleExtractionRunPurchase")

  @@unique([id, ownerUserId], map: "service_purchases_id_owner_key")
  @@unique([ownerUserId, idempotencyKey], map: "service_purchases_owner_idempotency")
  @@unique([resourceType, resourceId], map: "service_purchases_resource_key")
  @@index([ownerUserId, createdAt, id])
  @@index([status, reservedAt])
  @@map("service_purchases")
}

/// How one purchase was funded (Phase 11 §9).
///
/// A $5 check bought with $2 of promotional credit and $3 of cash is one
/// purchase and two allocations against two holds. Nothing assumes a purchase
/// maps to a single hold, because promotional-first funding means it usually
/// does not.
model ServicePurchaseAllocation {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @map("owner_user_id") @db.Uuid
  purchaseId  String @map("purchase_id") @db.Uuid
  /// One hold funds one allocation. Sharing one would let two purchases spend it.
  holdId      String @unique @map("hold_id") @db.Uuid

  creditClass CreditClass @map("credit_class")
  currency    String      @db.VarChar(3)
  amountMinor BigInt      @map("amount_minor")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner    User            @relation("PurchaseAllocationOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  purchase ServicePurchase @relation("PurchaseAllocations", fields: [purchaseId], references: [id], onDelete: Cascade)
  hold     CreditHold      @relation("PurchaseAllocationHold", fields: [holdId], references: [id], onDelete: Restrict)

  @@unique([purchaseId, creditClass], map: "purchase_allocations_one_per_class")
  @@index([ownerUserId, createdAt, id])
  @@index([purchaseId])
  @@map("service_purchase_allocations")
}

model PriceQuote {
  id             String             @id @default(uuid()) @db.Uuid
  ownerUserId    String             @map("owner_user_id") @db.Uuid
  productCode    ServiceProductCode @map("product_code")
  priceVersionId String             @map("price_version_id") @db.Uuid
  currency       String             @db.VarChar(3)
  amountMinor    BigInt             @map("amount_minor")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  owner        User             @relation("PriceQuoteOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  product      ServiceProduct   @relation("PriceQuoteProduct", fields: [productCode], references: [productCode], onDelete: Restrict)
  priceVersion PriceVersion     @relation("PriceQuotePriceVersion", fields: [priceVersionId], references: [id], onDelete: Restrict)
  purchase     ServicePurchase? @relation("ServicePurchaseQuote")

  @@index([ownerUserId, createdAt, id])
  @@index([expiresAt])
  @@map("price_quotes")
}

/// One attempt to add credit through the payment provider.
///
/// The amount here is authoritative: the provider is asked for exactly this,
/// and a provider reporting anything else is a mismatch, never a new truth
/// (§43, §56, §57).
model BalanceTopUp {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @map("owner_user_id") @db.Uuid
  currency    String @db.VarChar(3)
  amountMinor BigInt @map("amount_minor")

  provider           String  @db.VarChar(40)
  /// The provider API version this record was created under (§139).
  providerApiVersion String? @map("provider_api_version") @db.VarChar(40)
  providerSessionId  String? @map("provider_session_id") @db.VarChar(255)
  providerPaymentId  String? @map("provider_payment_id") @db.VarChar(255)

  status      TopUpStatus @default(CREATED)
  failureCode String?     @map("failure_code") @db.VarChar(64)

  idempotencyKey String? @map("idempotency_key") @db.VarChar(200)

  /// The ledger credit this produced. Unique, so a top-up can credit once.
  creditEntryId String? @unique @map("credit_entry_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  succeededAt DateTime? @map("succeeded_at") @db.Timestamptz(6)
  failedAt    DateTime? @map("failed_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)

  owner    User             @relation("BalanceTopUpOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  refunds  PaymentRefund[]  @relation("PaymentRefundTopUp")
  disputes PaymentDispute[] @relation("PaymentDisputeTopUp")

  @@unique([ownerUserId, idempotencyKey], map: "balance_topups_owner_idempotency")
  @@unique([provider, providerSessionId], map: "balance_topups_provider_session")
  @@unique([provider, providerPaymentId], map: "balance_topups_provider_payment")
  @@index([ownerUserId, createdAt, id])
  @@index([status, createdAt])
  @@map("balance_topups")
}

/// Cash returned to the customer through the payment provider.
///
/// Distinct from a service refund, which never touches the provider (§65).
model PaymentRefund {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @map("owner_user_id") @db.Uuid
  topUpId     String @map("top_up_id") @db.Uuid
  currency    String @db.VarChar(3)
  amountMinor BigInt @map("amount_minor")

  provider         String  @db.VarChar(40)
  providerRefundId String? @map("provider_refund_id") @db.VarChar(255)

  status      PaymentRefundStatus  @default(REQUESTED)
  reason      PaymentRefundReason?
  failureCode String?              @map("failure_code") @db.VarChar(64)

  /// The reservation taken before the provider was called (§71).
  holdId       String? @unique @map("hold_id") @db.Uuid
  /// The debit written on success. Unique, so a refund debits once.
  debitEntryId String? @unique @map("debit_entry_id") @db.Uuid

  idempotencyKey    String? @map("idempotency_key") @db.VarChar(200)
  requestedByUserId String? @map("requested_by_user_id") @db.Uuid

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  succeededAt DateTime? @map("succeeded_at") @db.Timestamptz(6)
  failedAt    DateTime? @map("failed_at") @db.Timestamptz(6)

  owner       User         @relation("PaymentRefundOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  topUp       BalanceTopUp @relation("PaymentRefundTopUp", fields: [topUpId], references: [id], onDelete: Restrict)
  hold        CreditHold?  @relation("PaymentRefundHold", fields: [holdId], references: [id], onDelete: SetNull)
  requestedBy User?        @relation("PaymentRefundRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@unique([provider, providerRefundId], map: "payment_refunds_provider_refund")
  @@index([ownerUserId, createdAt, id])
  @@index([topUpId])
  @@index([status, createdAt])
  @@map("payment_refunds")
}

/// A provider dispute against a settled payment.
///
/// Modelled separately from the top-up so a dispute can be opened, lost and
/// later won without rewriting the payment's own history (§83, §86).
model PaymentDispute {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @map("owner_user_id") @db.Uuid
  topUpId     String @map("top_up_id") @db.Uuid
  currency    String @db.VarChar(3)
  amountMinor BigInt @map("amount_minor")

  provider          String @db.VarChar(40)
  providerDisputeId String @map("provider_dispute_id") @db.VarChar(255)

  status PaymentDisputeStatus @default(OPEN)

  /// The debit taken when the dispute arrived, and the credit if it was won.
  debitEntryId    String? @unique @map("debit_entry_id") @db.Uuid
  reversalEntryId String? @unique @map("reversal_entry_id") @db.Uuid

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)

  owner User         @relation("PaymentDisputeOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  topUp BalanceTopUp @relation("PaymentDisputeTopUp", fields: [topUpId], references: [id], onDelete: Restrict)

  @@unique([provider, providerDisputeId], map: "payment_disputes_provider_dispute")
  @@index([ownerUserId, createdAt, id])
  @@index([topUpId])
  @@map("payment_disputes")
}

/// A receipt for one provider webhook.
///
/// SYSTEM-classified: it records that an external system said something, and
/// is authenticated by signature rather than by a user session (§98, §150).
/// The raw payload is deliberately not stored — only its digest (§81).
model PaymentProviderEvent {
  id                String            @id @default(uuid()) @db.Uuid
  provider          String            @db.VarChar(40)
  providerEventId   String            @map("provider_event_id") @db.VarChar(255)
  /// The provider's own type string. Recorded for support; never branched on.
  providerEventType String            @map("provider_event_type") @db.VarChar(120)
  /// PalCert's own reading of it (§87).
  eventKind         PaymentEventKind  @map("event_kind")
  objectKind        PaymentObjectKind @map("object_kind")
  providerObjectId  String?           @map("provider_object_id") @db.VarChar(255)

  /// The payment a dispute claws back. Null for every other event kind (§84).
  relatedPaymentId String? @map("related_payment_id") @db.VarChar(255)

  /// What the provider said the event was worth, where it said anything.
  /// Needed to write a chargeback, and useful evidence when state disagrees.
  currency    String? @db.VarChar(3)
  amountMinor BigInt? @map("amount_minor")

  /// Proof of what arrived, without keeping what arrived (§81).
  payloadSha256 String @map("payload_sha256") @db.Char(64)

  processingStatus ProviderEventStatus @default(RECEIVED) @map("processing_status")
  failureCode      String?             @map("failure_code") @db.VarChar(64)
  attemptCount     Int                 @default(0) @map("attempt_count")

  occurredAt  DateTime  @map("occurred_at") @db.Timestamptz(6)
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  @@unique([provider, providerEventId], map: "payment_provider_events_identity")
  @@index([processingStatus, receivedAt])
  @@index([provider, providerObjectId])
  @@map("payment_provider_events")
}

// ===========================================================================
// Phase 12 — SmartFix: deterministic DOCX correction
//
// PalCert may change deterministic document formatting, but it must never
// silently change academic meaning. Three tables hold that line.
//
// A `SmartFixPlan` is what PalCert *would* change, computed for free from a
// completed check. The user reads it and decides. A `SmartFixRequest` is the
// paid execution of one approved plan, and it is the row every guarantee
// hangs off: it names the purchase that reserved the balance, the corrected
// version it produced, the recheck it ran, and the manifest that proves what
// changed. A `SmartFixManifest` is that proof, computed from the corrected
// bytes rather than copied from the plan.
// ===========================================================================

/// Where a document version's bytes came from (§2).
enum DocumentVersionOrigin {
  /// Somebody uploaded it. The original, and immutable for ever.
  USER_UPLOAD
  /// PalCert generated it by applying an approved fix plan.
  SMARTFIX
}

/// Why a check exists (§95).
enum CheckPurpose {
  /// Somebody asked for it and paid for it.
  USER_REQUESTED
  /// It is the automatic recheck inside a SmartFix correction, already paid
  /// for as part of that correction.
  SMARTFIX_RECHECK
}

/// The life of one paid correction (§59, §79, §80).
enum SmartFixRequestStatus {
  /// Balance reserved, nothing written yet.
  RESERVED
  /// Transforming the document and ingesting the result.
  PROCESSING
  /// The automatic recheck is running against the corrected version.
  RECHECKING
  /// The recheck finished; verifying the targets and looking for regressions.
  VALIDATING
  /// Corrected version, manifest and updated report are the user's, and the
  /// reservation has been charged.
  DELIVERED
  /// Something went wrong. The reservation was released and nothing charged.
  FAILED
  /// The user stopped it before delivery. Released, nothing charged.
  CANCELLED
}

/// What SmartFix would change in one document, and what it would not (§3, §72).
///
/// Free, immutable and hashed. The user approves *this* plan, and execution
/// uses the approved plan rather than a freshly generated one — otherwise the
/// list of changes somebody agreed to and the list PalCert makes could differ
/// without anybody noticing.
model SmartFixPlan {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @map("owner_user_id") @db.Uuid

  /// The completed check this plan was computed from.
  checkId    String  @map("check_id") @db.Uuid
  checkRunId String? @map("check_run_id") @db.Uuid

  documentId        String @map("document_id") @db.Uuid
  documentVersionId String @map("document_version_id") @db.Uuid
  standardVersionId String @map("standard_version_id") @db.Uuid

  /// Every input the plan was computed from, so execution can prove it is
  /// acting on the same document, the same analysis and the same rules (§58).
  documentSha256         String @map("document_sha256") @db.Char(64)
  analysisArtifactSha256 String @map("analysis_artifact_sha256") @db.Char(64)
  standardContentHash    String @map("standard_content_hash")
  reportHash             String @map("report_hash") @db.Char(64)

  planSchemaVersion         Int    @map("plan_schema_version")
  fixEngineName             String @map("fix_engine_name") @db.VarChar(80)
  fixEngineVersion          String @map("fix_engine_version") @db.VarChar(40)
  capabilityRegistryVersion Int    @map("capability_registry_version")

  /// The plan's identity, over its canonical JSON. Recomputed by the engine
  /// before a byte is written; a mismatch refuses the correction.
  planHash String @map("plan_hash") @db.Char(64)

  /// Set when the document cannot be edited at all — tracked changes, document
  /// protection, a digital signature. The plan then carries no actions.
  refusalCode String? @map("refusal_code") @db.VarChar(64)

  /// Summary counters, so a list of plans renders without reading the
  /// artifact. The artifact stays authoritative.
  ruleCount        Int @map("rule_count")
  fixableRuleCount Int @map("fixable_rule_count")
  actionCount      Int @map("action_count")

  /// The plan document itself, in the derived bucket beside analyses and
  /// reports: private, no public URL, never a raw key in an API response.
  artifactObjectKey       String  @unique @map("artifact_object_key")
  artifactObjectVersionId String? @map("artifact_object_version_id")
  artifactSizeBytes       Int     @map("artifact_size_bytes")

  /// A plan is a snapshot of a document and its rules, and both move on.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner               User                         @relation("SmartFixPlanOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  check               DocumentCheck                @relation("SmartFixPlanCheck", fields: [checkId], references: [id], onDelete: Cascade)
  documentVersion     DocumentVersion              @relation("SmartFixPlanSourceVersion", fields: [documentVersionId], references: [id], onDelete: Restrict)
  standardVersion     StandardVersion              @relation("SmartFixPlanStandardVersion", fields: [standardVersionId], references: [id], onDelete: Restrict)
  requests            SmartFixRequest[]            @relation("SmartFixRequestPlan")
  planningReservation SmartFixPlanningReservation? @relation("SmartFixPlanningPlan")

  @@unique([id, ownerUserId], map: "smartfix_plans_id_owner_key")
  @@index([ownerUserId, createdAt, id])
  @@index([checkId, createdAt])
  @@map("smartfix_plans")
}

/// Durable reservation before external AI planning; the same purchase pays
/// for execution after the user approves the immutable plan. No preview charge.
model SmartFixPlanningReservation {
  id                String          @id @db.Uuid
  ownerUserId       String          @map("owner_user_id") @db.Uuid
  checkId           String          @map("check_id") @db.Uuid
  servicePurchaseId String          @unique @map("service_purchase_id") @db.Uuid
  planId            String?         @unique @map("plan_id") @db.Uuid
  status            String          @default("PLANNING") @db.VarChar(20)
  expiresAt         DateTime        @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner             User            @relation("SmartFixPlanningOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  check             DocumentCheck   @relation("SmartFixPlanningCheck", fields: [checkId], references: [id], onDelete: Restrict)
  servicePurchase   ServicePurchase @relation("SmartFixPlanningPurchase", fields: [servicePurchaseId], references: [id], onDelete: Restrict)
  plan              SmartFixPlan?   @relation("SmartFixPlanningPlan", fields: [planId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@map("smartfix_planning_reservations")
}

/// One paid correction, from reservation to delivery (§59).
model SmartFixRequest {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @map("owner_user_id") @db.Uuid

  planId   String @map("plan_id") @db.Uuid
  planHash String @map("plan_hash") @db.Char(64)

  checkId                 String @map("check_id") @db.Uuid
  documentId              String @map("document_id") @db.Uuid
  sourceDocumentVersionId String @map("source_document_version_id") @db.Uuid
  standardVersionId       String @map("standard_version_id") @db.Uuid

  /// The purchase that reserved the balance. Required on every row: unlike a
  /// check, SmartFix never had a free era to stay compatible with (§73, §74).
  servicePurchaseId String @unique @map("service_purchase_id") @db.Uuid

  status SmartFixRequestStatus @default(RESERVED)

  /// Why it ended without delivery. Never a compliance outcome.
  failureCode   String? @map("failure_code") @db.VarChar(64)
  /// Operator-facing and content-free.
  failureDetail String? @map("failure_detail")

  /// What it produced. All three are required before delivery (§79).
  correctedDocumentVersionId String? @unique @map("corrected_document_version_id") @db.Uuid
  recheckCheckId             String? @unique @map("recheck_check_id") @db.Uuid

  /// Deduplicates the whole commercial request, not just the correction.
  idempotencyKey String? @map("idempotency_key") @db.VarChar(200)

  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  reservedAt   DateTime  @default(now()) @map("reserved_at") @db.Timestamptz(6)
  processingAt DateTime? @map("processing_at") @db.Timestamptz(6)
  recheckingAt DateTime? @map("rechecking_at") @db.Timestamptz(6)
  validatingAt DateTime? @map("validating_at") @db.Timestamptz(6)
  deliveredAt  DateTime? @map("delivered_at") @db.Timestamptz(6)
  failedAt     DateTime? @map("failed_at") @db.Timestamptz(6)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner            User              @relation("SmartFixRequestOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  plan             SmartFixPlan      @relation("SmartFixRequestPlan", fields: [planId], references: [id], onDelete: Restrict)
  check            DocumentCheck     @relation("SmartFixRequestCheck", fields: [checkId], references: [id], onDelete: Restrict)
  sourceVersion    DocumentVersion   @relation("SmartFixSourceVersion", fields: [sourceDocumentVersionId], references: [id], onDelete: Restrict)
  standardVersion  StandardVersion   @relation("SmartFixRequestStandardVersion", fields: [standardVersionId], references: [id], onDelete: Restrict)
  servicePurchase  ServicePurchase   @relation("SmartFixRequestPurchase", fields: [servicePurchaseId], references: [id], onDelete: Restrict)
  correctedVersion DocumentVersion?  @relation("SmartFixCorrectedVersion")
  recheck          DocumentCheck?    @relation("SmartFixRecheck")
  manifest         SmartFixManifest? @relation("SmartFixRequestManifest")

  @@unique([id, ownerUserId], map: "smartfix_requests_id_owner_key")
  @@unique([ownerUserId, idempotencyKey], map: "smartfix_requests_owner_idempotency")
  @@index([ownerUserId, createdAt, id])
  @@index([status, reservedAt])
  @@index([checkId])
  @@map("smartfix_requests")
}

/// What SmartFix actually changed, with the proofs that it changed nothing
/// else (§110, §111).
///
/// Produced by the mutation engine from the corrected package, never copied
/// from the plan: a planned action is an intention, and only the output is
/// evidence. The integrity digests are the reason a corrected document may be
/// delivered at all.
model SmartFixManifest {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @map("owner_user_id") @db.Uuid
  requestId   String @unique @map("request_id") @db.Uuid

  manifestSchemaVersion Int    @map("manifest_schema_version")
  fixEngineName         String @map("fix_engine_name") @db.VarChar(80)
  fixEngineVersion      String @map("fix_engine_version") @db.VarChar(40)

  planHash     String @map("plan_hash") @db.Char(64)
  sourceSha256 String @map("source_sha256") @db.Char(64)
  outputSha256 String @map("output_sha256") @db.Char(64)
  manifestHash String @map("manifest_hash") @db.Char(64)

  entryCount   Int      @map("entry_count")
  changedParts String[] @map("changed_parts")

  /// The four proofs, stored rather than recomputed: an auditor asking "did
  /// this correction change the text?" gets an answer from the record, not
  /// from re-running an engine that has since been upgraded.
  sourceVisibleTextHash      String @map("source_visible_text_hash") @db.Char(64)
  outputVisibleTextHash      String @map("output_visible_text_hash") @db.Char(64)
  sourceMediaSetHash         String @map("source_media_set_hash") @db.Char(64)
  outputMediaSetHash         String @map("output_media_set_hash") @db.Char(64)
  sourceFieldInstructionHash String @map("source_field_instruction_hash") @db.Char(64)
  outputFieldInstructionHash String @map("output_field_instruction_hash") @db.Char(64)
  sourceRelationshipHash     String @map("source_relationship_hash") @db.Char(64)
  outputRelationshipHash     String @map("output_relationship_hash") @db.Char(64)

  artifactObjectKey       String  @unique @map("artifact_object_key")
  artifactObjectVersionId String? @map("artifact_object_version_id")
  artifactSizeBytes       Int     @map("artifact_size_bytes")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner   User            @relation("SmartFixManifestOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  request SmartFixRequest @relation("SmartFixRequestManifest", fields: [requestId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, createdAt, id])
  @@map("smartfix_manifests")
}

// =============================================================================
// Phase 14 — Official institution submissions
//
// The first domain where two unrelated parties legitimately read the same row:
// the author who submitted, and the organization they submitted to. Every
// earlier domain is owned by exactly one of them, and Phase 14 does not change
// that — documents, checks, analyses, AI reviews, SmartFix and finance keep
// their private scopes untouched (ADR-0031, ADR-0051).
//
// What makes that safe is that an organization never receives access to those
// tables. It receives access to a *snapshot*: exact copies of the submitted
// document and its canonical report, written once, verified byte for byte, and
// reachable only through the submission's own routes. The boundary is
//
//     user private storage  --explicit submit-->  submission snapshot  -->  organization
//
// and there is no second way in.
//
// These four tables are classified DUAL_PARTY_SCOPED rather than mechanically
// labelled USER_SCOPED or ORGANIZATION_SCOPED, because neither describes them
// and a classification that lies is worse than none.
// =============================================================================

/// The long-lived case: one author, one organization, one logical document.
///
/// Its identity is immutable once created (§124). A different document starts
/// a different case, which is what stops one institution's case from silently
/// switching to unrelated bytes (§9).
model OfficialSubmission {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @map("owner_user_id") @db.Uuid

  organizationId String @map("organization_id") @db.Uuid
  documentTypeId String @map("document_type_id") @db.Uuid
  documentId     String @map("document_id") @db.Uuid

  /// The revision an organization would act on. Null only while the very first
  /// revision is still preparing: until then nothing has been handed over.
  currentRevisionId String? @unique @map("current_revision_id") @db.Uuid

  /// Denormalized for the author's list. The authority is the revision.
  organizationName String @map("organization_name")
  documentTypeName String @map("document_type_name")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner     User                 @relation("OfficialSubmissionOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  document  Document             @relation(fields: [documentId], references: [id], onDelete: Restrict)
  revisions SubmissionRevision[] @relation("SubmissionRevisions")

  /// One case per (author, organization, document): a resubmission is a new
  /// revision of this case, never a second case (§6).
  @@unique([ownerUserId, organizationId, documentId])
  @@index([organizationId, updatedAt, id])
  @@index([ownerUserId, updatedAt, id])
  @@map("official_submissions")
}

/// One immutable official handoff.
///
/// Every source identity and hash on this row is captured at creation and
/// never looked up again: there is no "latest report", no "latest version" and
/// no "latest standard" after this row exists (§11).
model SubmissionRevision {
  id             String @id @default(uuid()) @db.Uuid
  submissionId   String @map("submission_id") @db.Uuid
  ownerUserId    String @map("owner_user_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  revisionNumber Int @map("revision_number")

  /// The exact bytes, and the digest the check measured them at.
  sourceDocumentVersionId String @map("source_document_version_id") @db.Uuid
  sourceDocumentSha256    String @map("source_document_sha256") @db.Char(64)
  sourceDocumentFormat    String @map("source_document_format")
  documentVersionNumber   Int    @map("document_version_number")

  /// The exact technical result.
  sourceCheckId        String @map("source_check_id") @db.Uuid
  sourceCheckRunId     String @map("source_check_run_id") @db.Uuid
  sourceReportId       String @map("source_report_id") @db.Uuid
  sourceReportHash     String @map("source_report_hash") @db.Char(64)
  sourceEvaluationHash String @map("source_evaluation_hash") @db.Char(64)

  /// The exact rules.
  standardId           String @map("standard_id") @db.Uuid
  standardVersionId    String @map("standard_version_id") @db.Uuid
  /// Prefixed, as Phase 3 stores it: `sha256:` and 64 hex characters.
  standardContentHash  String @map("standard_content_hash")
  standardCode         String @map("standard_code")
  standardName         String @map("standard_name")
  standardVersionLabel String @map("standard_version_label")

  /// The technical determination as the completed run recorded it. Copied for
  /// queue display; the report snapshot and its hash remain the authority
  /// (§84, §145).
  determination       String  @map("determination")
  scoreValue          String? @map("score_value")
  scoreCoverage       String? @map("score_coverage")
  scoreComplete       Boolean @map("score_complete")
  totalRules          Int     @map("total_rules")
  passedRules         Int     @map("passed_rules")
  failedRules         Int     @map("failed_rules")
  reviewRequiredRules Int     @map("review_required_rules")
  indeterminateRules  Int     @map("indeterminate_rules")
  notApplicableRules  Int     @map("not_applicable_rules")

  /// Snapshot identity. Write-once, enforced by trigger (§120).
  documentSnapshotKey       String? @unique @map("document_snapshot_key")
  documentSnapshotVersionId String? @map("document_snapshot_version_id")
  documentSnapshotSha256    String? @map("document_snapshot_sha256") @db.Char(64)
  documentSnapshotSizeBytes Int?    @map("document_snapshot_size_bytes")

  reportSnapshotKey       String? @unique @map("report_snapshot_key")
  reportSnapshotVersionId String? @map("report_snapshot_version_id")
  reportSnapshotSha256    String? @map("report_snapshot_sha256") @db.Char(64)
  reportSnapshotSizeBytes Int?    @map("report_snapshot_size_bytes")

  /// The semantic identity of this handoff, over sources and hashes only —
  /// never the institution's decision, which would otherwise rewrite it on
  /// every click (§137, §138).
  evidenceSchemaVersion           Int?    @map("evidence_schema_version")
  evidenceCanonicalizationVersion Int?    @map("evidence_canonicalization_version")
  evidenceHash                    String? @map("evidence_hash") @db.Char(64)

  processingStatus String  @default("PREPARING") @map("processing_status")
  failureCode      String? @map("failure_code")
  /// Operator-facing and content-free: never a review comment, never a title.
  failureDetail    String? @map("failure_detail")

  /// Null until preparation succeeds: an organization has not been told
  /// anything about a revision that is still being copied.
  institutionDecisionStatus String? @map("institution_decision_status")

  idempotencyKey String? @map("idempotency_key")

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz(6)
  reviewStartedAt DateTime? @map("review_started_at") @db.Timestamptz(6)
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  submission  OfficialSubmission        @relation("SubmissionRevisions", fields: [submissionId], references: [id], onDelete: Restrict)
  owner       User                      @relation("SubmissionRevisionOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  events      SubmissionDecisionEvent[] @relation("RevisionDecisionEvents")
  certificate ComplianceCertificate?    @relation("RevisionCertificate")
  comments    SubmissionComment[]       @relation("RevisionComments")

  @@unique([submissionId, revisionNumber])
  /// §95: one check is one revision's evidence. Submitting the same report
  /// twice would be two official handoffs claiming to be new.
  @@unique([submissionId, sourceCheckId])
  @@unique([ownerUserId, idempotencyKey])
  @@index([organizationId, institutionDecisionStatus, submittedAt, id])
  @@index([submissionId, revisionNumber])
  @@map("submission_revisions")
}

/// One entry in the append-only institution decision history (§42, §44).
///
/// The revision carries a current status as a denormalized convenience; this
/// table is the authority. Rewriting institutional history is refused by
/// trigger, not by convention.
model SubmissionDecisionEvent {
  id                   String @id @default(uuid()) @db.Uuid
  submissionRevisionId String @map("submission_revision_id") @db.Uuid
  ownerUserId          String @map("owner_user_id") @db.Uuid
  organizationId       String @map("organization_id") @db.Uuid

  /// SYSTEM for PalCert's own `null -> SUBMITTED` handoff event, ORGANIZATION
  /// for a named reviewer's decision. The database refuses any other shape.
  eventSource String @map("event_source")

  /// Null for the first event: nothing preceded SUBMITTED.
  fromStatus String? @map("from_status")
  toStatus   String  @map("to_status")

  reasonCode  String? @map("reason_code")
  /// Null for the SUBMITTED event, which PalCert writes rather than a person.
  actorUserId String? @map("actor_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  revision SubmissionRevision @relation("RevisionDecisionEvents", fields: [submissionRevisionId], references: [id], onDelete: Restrict)

  @@index([submissionRevisionId, createdAt, id])
  @@index([organizationId, createdAt, id])
  @@map("submission_decision_events")
}

/// An immutable review comment from the organization to the author (§65, §66).
///
/// Plain text, bounded, never HTML. Phase 14 models the institution side only:
/// a comment thread that grows into a messaging system is a product decision
/// nobody has made yet (§68).
model SubmissionComment {
  id                   String @id @default(uuid()) @db.Uuid
  submissionRevisionId String @map("submission_revision_id") @db.Uuid
  ownerUserId          String @map("owner_user_id") @db.Uuid
  organizationId       String @map("organization_id") @db.Uuid

  authorSide   String @map("author_side")
  authorUserId String @map("author_user_id") @db.Uuid

  body String @map("body")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  revision SubmissionRevision @relation("RevisionComments", fields: [submissionRevisionId], references: [id], onDelete: Restrict)

  @@index([submissionRevisionId, createdAt, id])
  @@map("submission_comments")
}

/// A PalCert technical compliance certificate (Phase 15).
///
/// Exists only where PalCert found a submission COMPLIANT *and* the receiving
/// organization recorded APPROVED for that same immutable revision. It is a
/// derived consequence of the two authorities agreeing, never a third status
/// that replaces either.
model ComplianceCertificate {
  id          String @id @default(uuid()) @db.Uuid
  ownerUserId String @map("owner_user_id") @db.Uuid

  organizationId       String @map("organization_id") @db.Uuid
  submissionId         String @map("submission_id") @db.Uuid
  /// One certificate per official revision, enforced by a unique index.
  submissionRevisionId String @unique @map("submission_revision_id") @db.Uuid

  /// The exact organization-sourced APPROVED event that made this eligible.
  approvalDecisionEventId String @map("approval_decision_event_id") @db.Uuid

  /// SHA-256 of the canonical verification code, and the only lookup
  /// authority. One-way, so a read of this table discloses no capability.
  verificationCodeHash String @unique @map("verification_code_hash") @db.Char(64)

  /// Issuance staging material, and nothing else.
  ///
  /// The worker needs the plaintext code to build the claim and render the
  /// PDF, and it runs after the transaction that scheduled it — so the code
  /// has to survive the gap somehow. Sealed with AES-256-GCM under a key the
  /// application holds and PostgreSQL does not, then erased in the same
  /// statement that marks the certificate ISSUED (or permanently failed).
  ///
  /// Never logged, never audited, and never present in any API view.
  verificationCodeCiphertext String? @map("verification_code_ciphertext")

  issuanceStatus String @default("PENDING") @map("issuance_status")

  claimSchemaVersion           Int?    @map("claim_schema_version")
  claimCanonicalizationVersion Int?    @map("claim_canonicalization_version")
  claimHash                    String? @map("claim_hash") @db.Char(64)

  claimObjectKey       String? @map("claim_object_key")
  claimObjectVersionId String? @map("claim_object_version_id")
  claimObjectSha256    String? @map("claim_object_sha256") @db.Char(64)

  certificateObjectKey       String? @map("certificate_object_key")
  certificateObjectVersionId String? @map("certificate_object_version_id")
  certificateObjectSha256    String? @map("certificate_object_sha256") @db.Char(64)

  rendererName    String? @map("renderer_name")
  rendererVersion String? @map("renderer_version")
  templateVersion String? @map("template_version")

  issuedAt   DateTime? @map("issued_at") @db.Timestamptz(6)
  /// Null means no automatic expiry, which is the Phase 15 default.
  validUntil DateTime? @map("valid_until") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  revocationReason String? @map("revocation_reason")

  failureCode   String? @map("failure_code")
  failureDetail String? @map("failure_detail")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner    User               @relation("ComplianceCertificateOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  revision SubmissionRevision @relation("RevisionCertificate", fields: [submissionRevisionId], references: [id], onDelete: Restrict)
  events   CertificateEvent[] @relation("CertificateEvents")

  @@index([organizationId, issuedAt, id])
  @@index([ownerUserId, createdAt, id])
  @@index([issuanceStatus, updatedAt])
  @@map("compliance_certificates")
}

/// Append-only certificate history. Issuance and revocation, and nothing else.
model CertificateEvent {
  id             String @id @default(uuid()) @db.Uuid
  certificateId  String @map("certificate_id") @db.Uuid
  ownerUserId    String @map("owner_user_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  eventType   String @map("event_type")
  /// SYSTEM for PalCert's own issuance, ORGANIZATION or PALCERT_ADMIN for a
  /// named person withdrawing one. The database refuses any other shape.
  eventSource String @map("event_source")

  /// The reviewer who revoked. Null for the system's issuance event.
  actorUserId String? @map("actor_user_id") @db.Uuid
  reasonCode  String? @map("reason_code")
  /// Private. Never reaches public verification.
  comment     String? @map("comment")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  certificate ComplianceCertificate @relation("CertificateEvents", fields: [certificateId], references: [id], onDelete: Restrict)

  @@index([certificateId, createdAt, id])
  @@index([organizationId, createdAt, id])
  @@map("certificate_events")
}

// ===========================================================================
// Phase 16 — notifications and reliable event delivery
//
// The rule the whole phase is built around:
//
//     a notification reports an authoritative event.
//     it never becomes the authoritative record itself.
//
// Nothing below may be consulted to decide whether a submission was approved
// or a certificate is valid. Phase 14's SubmissionDecisionEvent and Phase 15's
// ComplianceCertificate/CertificateEvent remain the authorities; these rows are
// derived, and could be deleted entirely without changing a single business
// answer.
// ===========================================================================

/// The nine workflow events Phase 16 recognises. One vocabulary serves both the
/// durable event and the notification it produces: two parallel enums would be
/// two things to keep in lockstep, and the first drift between them would be a
/// notification type with no event, or an event nothing listens to.
enum NotificationType {
  SUBMISSION_READY
  SUBMISSION_REVISION_READY
  SUBMISSION_UNDER_REVIEW
  SUBMISSION_APPROVED
  SUBMISSION_REJECTED
  SUBMISSION_REVISION_REQUESTED
  SUBMISSION_COMMENT_ADDED
  CERTIFICATE_ISSUED
  CERTIFICATE_REVOKED
  ATTESTATION_SUBMITTED
  ATTESTATION_READY_FOR_REVIEW
  ATTESTATION_INFORMATION_REQUESTED
  ATTESTATION_INFORMATION_PROVIDED
  ATTESTATION_APPROVED
  ATTESTATION_REJECTED
  ATTESTATION_REVOKED
  ATTESTATION_EXPIRING
  ATTESTATION_EXPIRED
  MANUAL_TOPUP_SUBMITTED
  MANUAL_TOPUP_APPROVED
  MANUAL_TOPUP_REJECTED
  WITHDRAWAL_PENDING_REVIEW
  WITHDRAWAL_SUBMITTED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  WITHDRAWAL_PAID
  WITHDRAWAL_FAILED
}

/// The authoritative row an event was derived from. Every emitter takes one of
/// these ids and derives everything else, so no caller can manufacture an
/// owner, an organization or a decision.
enum DomainEventSourceType {
  SUBMISSION_REVISION
  SUBMISSION_DECISION_EVENT
  SUBMISSION_COMMENT
  CERTIFICATE_EVENT
  ATTESTATION_REQUEST_EVENT
  ATTESTATION_REMINDER
  MANUAL_TOPUP_REQUEST_EVENT
  WITHDRAWAL_REQUEST_EVENT
}

/// What the event is about, and therefore what its deep link opens.
enum DomainAggregateType {
  OFFICIAL_SUBMISSION
  COMPLIANCE_CERTIFICATE
  ATTESTATION_REQUEST
  MANUAL_TOPUP_REQUEST
  WITHDRAWAL_REQUEST
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  SENDING
  DELIVERED
  FAILED_RETRYABLE
  FAILED_PERMANENT
  SKIPPED
}

enum NotificationSkipReason {
  PREFERENCE_DISABLED
  NO_VERIFIED_EMAIL
  AUTHORIZATION_REVOKED
  CHANNEL_DISABLED
  ACCOUNT_INELIGIBLE
}

enum NotificationAttemptOutcome {
  SUCCEEDED
  FAILED_RETRYABLE
  FAILED_PERMANENT
}

/// One immutable record that an authoritative business transition happened.
///
/// Written *inside* the transaction that made the change, so the invariant
/// holds without a sweeper to rescue it:
///
///     authoritative transition commits
///     -> DomainEvent exists
///     -> durable NOTIFICATION_FANOUT job exists
///
/// This is a historical event log, not a second outbox. `ProcessingJob` remains
/// the one dispatch/retry mechanism; these rows are the source identity the
/// jobs refer to.
model DomainEvent {
  id                 String           @id @default(uuid()) @db.Uuid
  eventType          NotificationType @map("event_type")
  eventSchemaVersion Int              @map("event_schema_version")

  /// The authoritative row this was derived from. Together with `eventType`
  /// these are the producer-level idempotency root: one committed source row
  /// can produce at most one matching event, however many times a job, a
  /// handler or a transaction is retried.
  sourceType DomainEventSourceType @map("source_type")
  sourceId   String                @map("source_id") @db.Uuid

  aggregateType DomainAggregateType @map("aggregate_type")
  aggregateId   String              @map("aggregate_id") @db.Uuid

  /// Derived from the source row, never supplied by a caller. The owner is
  /// always present. The organization is present for every organization-scoped
  /// type and absent exactly for the platform-scoped manual top-up types — a
  /// database CHECK holds both directions.
  ownerUserId    String  @map("owner_user_id") @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid

  /// When the *business* event happened, taken from the authoritative row —
  /// not when this record was written. A retried emission reproduces the same
  /// value, which is what makes rendered output deterministic.
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)

  /// Identifiers and decision status only. Never document text, filenames,
  /// findings, comment bodies, addresses, verification codes or money.
  payload Json

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Whether this event may be projected outward as a webhook (Phase 17).
  ///
  /// The cutover is structural rather than temporal. Phase 16's rows are false
  /// for ever, and a replay of a historical source returns its existing row —
  /// still false — so no submission approved last year is announced to an
  /// integration today. A timestamp rule could not promise that, because the
  /// replayed row's timestamp is not the replay's.
  webhookEligible Boolean @default(true) @map("webhook_eligible")

  /// Restrict, not Cascade: the log is append-only, so nothing may delete a row
  /// out of it — not even a cascade from the actor it belongs to.
  owner        User          @relation("DomainEventOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  organization Organization? @relation("DomainEventOrganization", fields: [organizationId], references: [id], onDelete: Restrict)

  notifications UserNotification[]
  webhookEvent  WebhookEvent?

  @@unique([id, organizationId], map: "domain_events_id_organization_key")
  @@unique([sourceType, sourceId, eventType], map: "domain_events_source_identity")
  @@index([eventType, createdAt, id], map: "domain_events_type_created_idx")
  @@index([aggregateType, aggregateId, occurredAt], map: "domain_events_aggregate_idx")
  @@map("domain_events")
}

/// One recipient's copy of one event.
///
/// User-scoped: visible to its recipient and to nobody else, including every
/// other member of the organization whose context it carries. An organization
/// id here is context, not a grant.
model UserNotification {
  id              String  @id @default(uuid()) @db.Uuid
  sourceEventId   String  @map("source_event_id") @db.Uuid
  recipientUserId String  @map("recipient_user_id") @db.Uuid
  /// Context, not a grant: it records which tenant the event happened in so the
  /// inbox can label it. It never widens who may read the row. Null exactly for
  /// platform-scoped types (manual top-ups), which happen to no organization.
  organizationId  String? @map("organization_id") @db.Uuid

  notificationType NotificationType @map("notification_type")

  /// The copy as it was rendered, with the template version that produced it,
  /// so later wording changes never rewrite what somebody was actually told.
  templateVersion String @map("template_version")
  locale          String
  title           String
  body            String
  /// An application route. Never a bearer link, never a storage URL.
  deepLink        String @map("deep_link")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)

  event        DomainEvent   @relation(fields: [sourceEventId], references: [id], onDelete: Restrict)
  recipient    User          @relation("UserNotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  organization Organization? @relation("UserNotificationOrganization", fields: [organizationId], references: [id], onDelete: Restrict)

  deliveries NotificationDelivery[]

  @@unique([sourceEventId, recipientUserId, notificationType], map: "user_notifications_logical_identity")
  @@index([recipientUserId, createdAt, id], map: "user_notifications_inbox_idx")
  @@map("user_notifications")
}

/// One logical delivery of one notification on one channel.
///
/// Unique per (notification, channel): duplicate events or duplicate jobs
/// cannot schedule two logical emails. What is *not* claimed is external
/// exactly-once — see the attempt table.
model NotificationDelivery {
  id             String                     @id @default(uuid()) @db.Uuid
  notificationId String                     @map("notification_id") @db.Uuid
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(PENDING)
  skipReason     NotificationSkipReason?    @map("skip_reason")

  provider          String
  providerMessageId String? @map("provider_message_id")

  attemptCount  Int       @default(0) @map("attempt_count")
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(6)
  /// A normalized code. Never a provider banner, an address or a message body.
  lastErrorCode String?   @map("last_error_code")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)

  notification UserNotification              @relation(fields: [notificationId], references: [id], onDelete: Restrict)
  attempts     NotificationDeliveryAttempt[]

  @@unique([notificationId, channel], map: "notification_deliveries_logical_identity")
  @@index([status, nextAttemptAt], map: "notification_deliveries_due_idx")
  @@map("notification_deliveries")
}

/// Append-only history of what was tried and how it ended.
///
/// Carries no message content and no address: enough to answer "was it
/// attempted, and what happened" without anyone reading somebody's mail.
model NotificationDeliveryAttempt {
  id            String @id @default(uuid()) @db.Uuid
  deliveryId    String @map("delivery_id") @db.Uuid
  attemptNumber Int    @map("attempt_number")

  startedAt  DateTime                    @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime?                   @map("finished_at") @db.Timestamptz(6)
  outcome    NotificationAttemptOutcome?

  providerMessageId String? @map("provider_message_id")
  errorCode         String? @map("error_code")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  delivery NotificationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)

  @@unique([deliveryId, attemptNumber], map: "notification_delivery_attempts_identity")
  @@map("notification_delivery_attempts")
}

/// A person's email choice for one notification type.
///
/// Normalized rather than a JSON blob, so the database can hold the one rule
/// that matters: a revocation email cannot be switched off. A missing row means
/// the product default, so a new account needs no rows at all.
model NotificationPreference {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  notificationType NotificationType @map("notification_type")
  emailEnabled     Boolean          @default(true) @map("email_enabled")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation("NotificationPreferenceUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationType], map: "notification_preferences_identity")
  @@map("notification_preferences")
}

// =============================================================================
// Phase 17 — organization integrations and secure outbound webhooks
//
//     A webhook is an external projection of an authoritative DomainEvent.
//     It never becomes the authoritative record itself.
//
// No customer-controlled URL and no signing secret appears in plaintext in any
// model below, and no text a remote endpoint produced is stored at all.
// =============================================================================

enum WebhookEndpointStatus {
  PENDING_VERIFICATION
  ACTIVE
  PAUSED
  DISABLED
}

enum WebhookConfigStatus {
  PENDING
  VERIFIED
  RETIRED
  SUPERSEDED
}

/// The public event vocabulary, in the dotted form that is actually sent.
enum WebhookEventType {
  submission_ready              @map("submission.ready")
  submission_revision_ready     @map("submission.revision_ready")
  submission_under_review       @map("submission.under_review")
  submission_approved           @map("submission.approved")
  submission_rejected           @map("submission.rejected")
  submission_revision_requested @map("submission.revision_requested")
  submission_comment_added      @map("submission.comment_added")
  certificate_issued            @map("certificate.issued")
  certificate_revoked           @map("certificate.revoked")
}

enum WebhookDeliveryKind {
  ORIGINAL
  REPLAY
  TEST
}

enum WebhookDeliveryStatus {
  PENDING
  SENDING
  DELIVERED
  FAILED_RETRYABLE
  FAILED_PERMANENT
  SKIPPED
}

enum WebhookSkipReason {
  ENDPOINT_INACTIVE
  UNSUBSCRIBED
}

enum WebhookAttemptOutcome {
  SUCCEEDED
  FAILED_RETRYABLE
  FAILED_PERMANENT
}

enum WebhookManagementOperationType {
  CREATE_ENDPOINT
  UPDATE_URL
  VERIFY_CONFIG
  TEST_ENDPOINT
  ROTATE_SECRET
  REPLAY_DELIVERY
}

/// An organization's outbound integration.
///
/// Holds no URL and no secret: those live in immutable configuration versions,
/// and this row points at the one that is live and at the one waiting to be
/// proved reachable.
model WebhookEndpoint {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  description String
  status      WebhookEndpointStatus @default(PENDING_VERIFICATION)

  currentConfigVersionId String? @map("current_config_version_id") @db.Uuid
  pendingConfigVersionId String? @map("pending_config_version_id") @db.Uuid

  /// 1–10 while the endpoint is live, NULL once disabled. The ten-endpoint
  /// limit is a unique index on (organization, slot) rather than a count an
  /// application performs: two concurrent creates at the boundary both read
  /// "nine" and both pass a check, but they cannot both take slot ten.
  slot Int? @db.SmallInt

  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  disabledAt      DateTime? @map("disabled_at") @db.Timestamptz(6)

  organization Organization @relation("WebhookEndpointOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("WebhookEndpointCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  configVersions WebhookEndpointConfigVersion[]
  subscriptions  WebhookSubscription[]
  deliveries     WebhookDelivery[]

  @@unique([organizationId, slot], map: "webhook_endpoints_slot_key")
  @@unique([id, organizationId], map: "webhook_endpoints_id_organization_key")
  @@index([organizationId, createdAt, id], map: "webhook_endpoints_organization_idx")
  @@map("webhook_endpoints")
}

/// Immutable configuration: where events go and what signs them.
///
/// The URL's SHA-256, host and port sit beside the ciphertext and are
/// recomputed from the decrypted URL before every network attempt. That turns
/// an edited ciphertext from an undetectable redirection into a permanent
/// failure with no packet sent.
model WebhookEndpointConfigVersion {
  id            String              @id @default(uuid()) @db.Uuid
  endpointId    String              @map("endpoint_id") @db.Uuid
  versionNumber Int                 @map("version_number")
  status        WebhookConfigStatus @default(PENDING)

  urlCiphertext      String @map("url_ciphertext")
  urlIv              String @map("url_iv")
  urlAuthTag         String @map("url_auth_tag")
  urlEncryptionKeyId String @map("url_encryption_key_id")

  urlSha256 String @map("url_sha256") @db.Char(64)
  host      String
  port      Int

  secretCiphertext      String @map("secret_ciphertext")
  secretIv              String @map("secret_iv")
  secretAuthTag         String @map("secret_auth_tag")
  secretEncryptionKeyId String @map("secret_encryption_key_id")
  secretFingerprint     String @map("secret_fingerprint") @db.Char(64)

  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  verifiedAt            DateTime? @map("verified_at") @db.Timestamptz(6)
  retiredAt             DateTime? @map("retired_at") @db.Timestamptz(6)
  lastVerificationError String?   @map("last_verification_error")
  lastVerificationAt    DateTime? @map("last_verification_at") @db.Timestamptz(6)

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Restrict)

  deliveries           WebhookDelivery[]
  verificationAttempts WebhookVerificationAttempt[]

  @@unique([endpointId, versionNumber], map: "webhook_config_versions_identity")
  @@unique([id, endpointId], map: "webhook_config_versions_id_endpoint_key")
  @@index([urlEncryptionKeyId], map: "webhook_config_versions_key_idx")
  @@index([secretEncryptionKeyId], map: "webhook_config_versions_secret_key_idx")
  @@map("webhook_endpoint_config_versions")
}

/// Which event types one endpoint receives. No wildcard; a missing row means
/// not subscribed, so a type added later reaches nobody until asked for.
model WebhookSubscription {
  id             String           @id @default(uuid()) @db.Uuid
  endpointId     String           @map("endpoint_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  eventType      WebhookEventType @map("event_type")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Restrict)

  @@unique([endpointId, eventType], map: "webhook_subscriptions_identity")
  @@index([eventType, organizationId], map: "webhook_subscriptions_event_idx")
  @@map("webhook_subscriptions")
}

/// PalCert's external projection of one DomainEvent. One per event, for ever.
model WebhookEvent {
  id             String @id @default(uuid()) @db.Uuid
  domainEventId  String @unique @map("domain_event_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  eventType     WebhookEventType @map("event_type")
  schemaVersion Int              @map("schema_version")
  occurredAt    DateTime         @map("occurred_at") @db.Timestamptz(6)

  /// Identifiers and decision status only, asserted so by a sentinel test.
  data Json

  /// Over the full canonical envelope. Verified before every attempt, so an
  /// automatic retry sends the same bytes and a receiver's signature check
  /// cannot fail for a reason nobody can reproduce.
  bodySha256 String @map("body_sha256") @db.Char(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  domainEvent  DomainEvent  @relation(fields: [domainEventId], references: [id], onDelete: Restrict)
  organization Organization @relation("WebhookEventOrganization", fields: [organizationId], references: [id], onDelete: Restrict)

  deliveries WebhookDelivery[]

  @@unique([id, organizationId], map: "webhook_events_id_organization_key")
  @@index([organizationId, createdAt, id], map: "webhook_events_organization_idx")
  @@map("webhook_events")
}

/// One body, to one endpoint, under one configuration.
model WebhookDelivery {
  id                      String  @id @default(uuid()) @db.Uuid
  webhookEventId          String? @map("webhook_event_id") @db.Uuid
  endpointId              String  @map("endpoint_id") @db.Uuid
  endpointConfigVersionId String  @map("endpoint_config_version_id") @db.Uuid
  organizationId          String  @map("organization_id") @db.Uuid

  kind       WebhookDeliveryKind
  status     WebhookDeliveryStatus @default(PENDING)
  skipReason WebhookSkipReason?    @map("skip_reason")

  attemptCount   Int       @default(0) @map("attempt_count")
  nextAttemptAt  DateTime? @map("next_attempt_at") @db.Timestamptz(6)
  lastErrorCode  String?   @map("last_error_code")
  lastHttpStatus Int?      @map("last_http_status")

  replayOfDeliveryId String? @map("replay_of_delivery_id") @db.Uuid

  /// TEST only: the immutable timestamp its body is built from, so every retry
  /// reproduces the same bytes instead of re-reading the clock.
  controlOccurredAt DateTime? @map("control_occurred_at") @db.Timestamptz(6)
  bodySha256        String?   @map("body_sha256") @db.Char(64)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)

  webhookEvent  WebhookEvent?                @relation(fields: [webhookEventId], references: [id], onDelete: Restrict)
  endpoint      WebhookEndpoint              @relation(fields: [endpointId], references: [id], onDelete: Restrict)
  configVersion WebhookEndpointConfigVersion @relation(fields: [endpointConfigVersionId], references: [id], onDelete: Restrict)

  replayOf WebhookDelivery?  @relation("WebhookDeliveryReplay", fields: [replayOfDeliveryId], references: [id], onDelete: Restrict)
  replays  WebhookDelivery[] @relation("WebhookDeliveryReplay")

  attempts WebhookDeliveryAttempt[]

  @@unique([id, organizationId], map: "webhook_deliveries_id_organization_key")
  @@index([status, nextAttemptAt], map: "webhook_deliveries_due_idx")
  @@index([endpointId, createdAt, id], map: "webhook_deliveries_endpoint_idx")
  @@map("webhook_deliveries")
}

/// Append-only wire history. Normalized codes only; no remote text ever.
model WebhookDeliveryAttempt {
  id            String @id @default(uuid()) @db.Uuid
  deliveryId    String @map("delivery_id") @db.Uuid
  attemptNumber Int    @map("attempt_number")

  startedAt  DateTime               @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime?              @map("finished_at") @db.Timestamptz(6)
  outcome    WebhookAttemptOutcome?
  errorCode  String?                @map("error_code")
  httpStatus Int?                   @map("http_status")
  durationMs Int?                   @map("duration_ms")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  delivery WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)

  @@unique([deliveryId, attemptNumber], map: "webhook_delivery_attempts_identity")
  @@map("webhook_delivery_attempts")
}

/// Append-only verification history.
///
/// Deliberately holds no challenge. A persisted challenge is a persisted
/// answer key, and the value exists only inside the attempt that generated it.
model WebhookVerificationAttempt {
  id              String @id @default(uuid()) @db.Uuid
  operationId     String @map("operation_id") @db.Uuid
  configVersionId String @map("config_version_id") @db.Uuid
  endpointId      String @map("endpoint_id") @db.Uuid
  attemptNumber   Int    @map("attempt_number")

  startedAt  DateTime               @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime?              @map("finished_at") @db.Timestamptz(6)
  outcome    WebhookAttemptOutcome?
  errorCode  String?                @map("error_code")
  httpStatus Int?                   @map("http_status")
  durationMs Int?                   @map("duration_ms")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  operation     WebhookManagementOperation   @relation(fields: [operationId], references: [id], onDelete: Restrict)
  configVersion WebhookEndpointConfigVersion @relation(fields: [configVersionId], references: [id], onDelete: Restrict)

  @@unique([operationId, attemptNumber], map: "webhook_verification_attempts_identity")
  @@index([configVersionId, startedAt], map: "webhook_verification_attempts_config_idx")
  @@map("webhook_verification_attempts")
}

/// The durable identity of one HTTP mutation.
///
/// Stores the idempotency key's hash and never the key itself: a key travels
/// in a header, and keeping it would put a client-supplied string in the
/// database beside the resources it can re-address.
model WebhookManagementOperation {
  id             String                         @id @default(uuid()) @db.Uuid
  organizationId String                         @map("organization_id") @db.Uuid
  operation      WebhookManagementOperationType

  idempotencyKeyHash String @map("idempotency_key_hash") @db.Char(64)
  requestFingerprint String @map("request_fingerprint") @db.Char(64)
  actorUserId        String @map("actor_user_id") @db.Uuid

  endpointId      String? @map("endpoint_id") @db.Uuid
  configVersionId String? @map("config_version_id") @db.Uuid
  deliveryId      String? @map("delivery_id") @db.Uuid

  /// Secret-bearing operations only, and never erased merely because a
  /// response was written: an HTTP write is not a client receipt, so a caller
  /// who never saw the body has to be able to ask again within the window.
  revealCiphertext      String?   @map("reveal_ciphertext")
  revealIv              String?   @map("reveal_iv")
  revealAuthTag         String?   @map("reveal_auth_tag")
  revealEncryptionKeyId String?   @map("reveal_encryption_key_id")
  revealExpiresAt       DateTime? @map("reveal_expires_at") @db.Timestamptz(6)

  settledAt        DateTime? @map("settled_at") @db.Timestamptz(6)
  settledErrorCode String?   @map("settled_error_code")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation("WebhookOperationOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User         @relation("WebhookOperationActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  verificationAttempts WebhookVerificationAttempt[]

  @@unique([organizationId, operation, idempotencyKeyHash], map: "webhook_management_operations_identity")
  @@index([revealExpiresAt], map: "webhook_management_operations_reveal_expiry_idx")
  @@map("webhook_management_operations")
}

// =============================================================================
// Phase 19 — Organization-owned API clients and machine authentication
//
// Three models, split so that rotation is expressible. An overlap is two live
// secret rows with different statuses; with a secret column on the client there
// would be nowhere to put the second one, and "rotation" would mean "overwrite
// and hope the deploy was quick".
// =============================================================================

enum ApiClientStatus {
  ACTIVE
  DISABLED
  REVOKED
}

enum ApiClientSecretStatus {
  ACTIVE
  ROTATING_OUT
  RETIRED
}

/// A machine credential holder, belonging to exactly one organization.
///
/// Carries the public client id, the scopes and the lifecycle — and no secret
/// material of any kind. There is deliberately no column a secret could be put
/// in by a later change that meant well.
model ApiClient {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// The public identifier a caller presents. Unique platform-wide, because it
  /// arrives before any tenant is known.
  clientId String @map("client_id")

  displayName String  @map("display_name")
  description String?

  status ApiClientStatus @default(ACTIVE)

  /// A closed vocabulary the application validates, stored sorted and distinct
  /// so two clients with the same authority have the same stored value.
  scopes String[]

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6)
  disabledAt      DateTime? @map("disabled_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId String?   @map("revoked_by_user_id") @db.Uuid

  /// Truncated to the minute before it is written: second-level usage across a
  /// set of clients describes a customer's internal schedule.
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)

  organization Organization @relation("ApiClientOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("ApiClientCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revokedBy    User?        @relation("ApiClientRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  secrets     ApiClientSecret[]
  operations  ApiClientOperation[]
  auditEvents AuditEvent[]         @relation("ApiClientAuditActor")

  @@unique([clientId], map: "api_clients_client_id_key")
  @@index([organizationId, createdAt(sort: Desc)], map: "api_clients_organization_idx")
  @@map("api_clients")
}

/// One secret ever issued to a client, represented only by a one-way verifier.
///
/// There is no ciphertext and no decrypt path. A signing secret must be *used*
/// again to sign, so Phase 17 seals one; an inbound credential only ever has to
/// be *compared*, so this is hashed and PalCert genuinely cannot show it again.
model ApiClientSecret {
  id          String @id @default(uuid()) @db.Uuid
  apiClientId String @map("api_client_id") @db.Uuid

  /// PHC-format Argon2id string: algorithm, parameters, salt and tag.
  secretVerifier String @map("secret_verifier")

  /// Eight hex characters of the secret's random part, so an administrator can
  /// tell two secrets apart without anybody pasting a credential.
  secretHint String @map("secret_hint")

  status ApiClientSecretStatus @default(ACTIVE)

  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByUserId String   @map("created_by_user_id") @db.Uuid

  /// When a ROTATING_OUT secret stops verifying. The application refuses it
  /// past this instant; the sweeper is hygiene, not the authority for expiry.
  overlapEndsAt DateTime? @map("overlap_ends_at") @db.Timestamptz(6)
  retiredAt     DateTime? @map("retired_at") @db.Timestamptz(6)

  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)

  apiClient ApiClient @relation(fields: [apiClientId], references: [id], onDelete: Restrict)
  createdBy User      @relation("ApiClientSecretCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([apiClientId, createdAt(sort: Desc)], map: "api_client_secrets_client_idx")
  @@index([overlapEndsAt], map: "api_client_secrets_overlap_due_idx")
  @@map("api_client_secrets")
}

/// The durable identity of a management mutation.
///
/// Stores the idempotency key's hash and never the key. The secret-bearing
/// operations carry a bounded sealed reveal, because writing an HTTP response
/// is not the same as a client receiving one — without it a lost 201 means a
/// credential that exists and that nobody holds.
model ApiClientOperation {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  operation          String
  idempotencyKeyHash String @map("idempotency_key_hash") @db.Char(64)
  requestFingerprint String @map("request_fingerprint") @db.Char(64)

  actorUserId String  @map("actor_user_id") @db.Uuid
  apiClientId String? @map("api_client_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  revealCiphertext String?   @map("reveal_ciphertext")
  revealIv         String?   @map("reveal_iv")
  revealAuthTag    String?   @map("reveal_auth_tag")
  revealExpiresAt  DateTime? @map("reveal_expires_at") @db.Timestamptz(6)

  organization Organization @relation("ApiClientOperationOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User         @relation("ApiClientOperationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  apiClient    ApiClient?   @relation(fields: [apiClientId], references: [id], onDelete: Restrict)

  @@unique([organizationId, operation, idempotencyKeyHash], map: "api_client_operations_key")
  @@index([revealExpiresAt], map: "api_client_operations_reveal_due_idx")
  @@map("api_client_operations")
}

/// Where an imported draft came from (portable standard packages). Written
/// once, beside the version, so nothing foreign enters the columns the content
/// hash is built from. Never holds an identifier from the source installation.
model StandardVersionImport {
  id                      String                @id @default(uuid()) @db.Uuid
  organizationId          String                @map("organization_id") @db.Uuid
  standardId              String                @map("standard_id") @db.Uuid
  standardVersionId       String                @unique @map("standard_version_id") @db.Uuid
  importedByUserId        String?               @map("imported_by_user_id") @db.Uuid
  importedAt              DateTime              @default(now()) @map("imported_at")
  packageHash             String                @map("package_hash")
  formatVersion           Int                   @map("format_version")
  sourceOrganizationName  String                @map("source_organization_name")
  sourceStandardCode      String                @map("source_standard_code")
  sourceStandardNameEn    String                @map("source_standard_name_en")
  sourceStandardNameAr    String                @map("source_standard_name_ar")
  sourceVersionLabel      String                @map("source_version_label")
  sourceVersionStatus     StandardVersionStatus @map("source_version_status")
  sourceRuleSchemaVersion Int                   @map("source_rule_schema_version")
  importRuleSchemaVersion Int                   @map("import_rule_schema_version")
  ruleCount               Int                   @map("rule_count")
  createdStandard         Boolean               @map("created_standard")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  standard     Standard        @relation(fields: [standardId], references: [id], onDelete: Cascade)
  version      StandardVersion @relation(fields: [standardVersionId], references: [id], onDelete: Cascade)
  importedBy   User?           @relation("StandardVersionImportedBy", fields: [importedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, packageHash])
  @@index([standardId])
  @@map("standard_version_imports")
}

// ===========================================================================
// Certificate attestation
//
// A user uploads a certificate they already hold; an institution reviews that
// exact file; on approval PalCert records an immutable attestation over the
// file's SHA-256. PalCert attests a submitted artifact — it does not claim to
// have issued the external certificate.
//
// Money reuses the Phase 10 ledger and holds. The only new financial tables
// record where a captured fee went: the institution's share and PalCert's
// commission, which must sum to the capture.
// ===========================================================================

enum AttestationRequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  NEEDS_INFORMATION
  APPROVED
  REJECTED
  CANCELLED
}

enum AttestationArtifactStatus {
  AWAITING_UPLOAD
  UPLOADED
  VALIDATING
  SCANNING
  READY
  REJECTED
  FAILED
  UPLOAD_EXPIRED
  CANCELLED
}

enum AttestationArtifactFormat {
  PDF
  PNG
  JPEG
  WEBP
}

enum AttestationPaymentStatus {
  NOT_REQUIRED
  UNPAID
  RESERVED
  SETTLED
  RELEASED
}

enum AttestationRequestEventType {
  CREATED
  SUBMITTED
  REVIEW_STARTED
  ASSIGNED
  INFORMATION_REQUESTED
  INFORMATION_PROVIDED
  APPROVED
  REJECTED
  CANCELLED
  REVOKED
  PAYMENT_RESERVED
  PAYMENT_SETTLED
  PAYMENT_RELEASED
}

enum AttestationActorSide {
  OWNER
  ORGANIZATION
  SYSTEM
}

/// One kind of certificate an institution will attest, with its fee and policy.
model AttestationType {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  nameEn         String  @map("name_en")
  nameAr         String  @map("name_ar")
  descriptionEn  String? @map("description_en")
  descriptionAr  String? @map("description_ar")
  instructionsEn String? @map("instructions_en")
  instructionsAr String? @map("instructions_ar")

  enabled Boolean @default(true)

  feeMinor BigInt @default(0) @map("fee_minor")
  currency String @db.VarChar(3)

  defaultValidityDays         Int?    @map("default_validity_days")
  allowNoExpiry               Boolean @default(false) @map("allow_no_expiry")
  reviewerMayOverrideValidity Boolean @default(true) @map("reviewer_may_override_validity")

  requiredFields String[]                    @default([]) @map("required_fields")
  allowedFormats AttestationArtifactFormat[] @default([PDF, PNG, JPEG, WEBP]) @map("allowed_formats")
  maxFileBytes   Int                         @default(20971520) @map("max_file_bytes")
  reminderDays   Int[]                       @default([30, 14, 7, 1]) @map("reminder_days")

  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  requests AttestationRequest[]

  @@unique([id, organizationId], map: "attestation_types_id_org_key")
  @@index([organizationId, enabled], map: "attestation_types_org_idx")
  @@map("attestation_types")
}

/// PalCert's commission on one institution's attestation fees. Append-only.
model OrganizationAttestationCommission {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  commissionBps   Int      @map("commission_bps")
  effectiveFrom   DateTime @map("effective_from") @db.Timestamptz(6)
  changedByUserId String   @map("changed_by_user_id") @db.Uuid
  changeReason    String   @map("change_reason")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, effectiveFrom(sort: Desc), createdAt(sort: Desc)], map: "organization_attestation_commissions_current_idx")
  @@map("organization_attestation_commissions")
}

/// One user's request that one institution attest a certificate.
model AttestationRequest {
  id                String                   @id @default(uuid()) @db.Uuid
  ownerUserId       String                   @map("owner_user_id") @db.Uuid
  organizationId    String                   @map("organization_id") @db.Uuid
  attestationTypeId String                   @map("attestation_type_id") @db.Uuid
  status            AttestationRequestStatus @default(DRAFT)

  organizationName String @map("organization_name")
  typeNameEn       String @map("type_name_en")
  typeNameAr       String @map("type_name_ar")

  certificateTitle    String    @map("certificate_title")
  certificateType     String?   @map("certificate_type")
  issuingOrganization String?   @map("issuing_organization")
  issueDate           DateTime? @map("issue_date") @db.Date
  referenceNumber     String?   @map("reference_number")
  recipientName       String?   @map("recipient_name")
  description         String?
  notesForReviewer    String?   @map("notes_for_reviewer")

  currentArtifactId String? @map("current_artifact_id") @db.Uuid

  defaultValidityDays         Int?     @map("default_validity_days")
  allowNoExpiry               Boolean? @map("allow_no_expiry")
  reviewerMayOverrideValidity Boolean? @map("reviewer_may_override_validity")
  reminderDays                Int[]    @map("reminder_days")

  currency              String?   @db.VarChar(3)
  grossFeeMinor         BigInt?   @map("gross_fee_minor")
  platformCommissionBps Int?      @map("platform_commission_bps")
  platformFeeMinor      BigInt?   @map("platform_fee_minor")
  institutionNetMinor   BigInt?   @map("institution_net_minor")
  commissionId          String?   @map("commission_id") @db.Uuid
  pricedAt              DateTime? @map("priced_at") @db.Timestamptz(6)

  paymentStatus     AttestationPaymentStatus @default(UNPAID) @map("payment_status")
  holdId            String?                  @unique(map: "attestation_requests_hold_key") @map("hold_id") @db.Uuid
  captureEntryId    String?                  @map("capture_entry_id") @db.Uuid
  paymentSettledAt  DateTime?                @map("payment_settled_at") @db.Timestamptz(6)
  paymentReleasedAt DateTime?                @map("payment_released_at") @db.Timestamptz(6)

  assignedReviewerUserId String? @map("assigned_reviewer_user_id") @db.Uuid
  previousAttestationId  String? @map("previous_attestation_id") @db.Uuid

  openInformationRequest String? @map("open_information_request")
  rejectionReason        String? @map("rejection_reason")

  idempotencyKey String? @map("idempotency_key") @db.VarChar(200)

  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz(6)
  reviewStartedAt DateTime? @map("review_started_at") @db.Timestamptz(6)
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(6)
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(6)

  type        AttestationType           @relation(fields: [attestationTypeId], references: [id], onDelete: Restrict)
  artifacts   AttestationArtifact[]
  events      AttestationRequestEvent[]
  attestation Attestation?
  settlement  AttestationSettlement?

  @@unique([id, ownerUserId], map: "attestation_requests_id_owner_key")
  @@unique([id, organizationId], map: "attestation_requests_id_org_key")
  @@unique([ownerUserId, idempotencyKey], map: "attestation_requests_owner_idempotency")
  @@index([ownerUserId, updatedAt(sort: Desc), id], map: "attestation_requests_owner_idx")
  @@index([organizationId, status, submittedAt, id], map: "attestation_requests_queue_idx")
  @@index([attestationTypeId], map: "attestation_requests_type_idx")
  @@map("attestation_requests")
}

/// The exact bytes a user submitted. Frozen once READY.
model AttestationArtifact {
  id             String                    @id @default(uuid()) @db.Uuid
  requestId      String                    @map("request_id") @db.Uuid
  ownerUserId    String                    @map("owner_user_id") @db.Uuid
  organizationId String                    @map("organization_id") @db.Uuid
  status         AttestationArtifactStatus @default(AWAITING_UPLOAD)

  originalFilename String                     @map("original_filename")
  declaredMimeType String?                    @map("declared_mime_type")
  expectedFormat   AttestationArtifactFormat  @map("expected_format")
  detectedFormat   AttestationArtifactFormat? @map("detected_format")
  detectedMimeType String?                    @map("detected_mime_type")

  declaredSizeBytes Int     @map("declared_size_bytes")
  maxFileBytes      Int     @map("max_file_bytes")
  sizeBytes         Int?    @map("size_bytes")
  clientSha256      String? @map("client_sha256") @db.Char(64)
  sha256            String? @db.Char(64)

  quarantineObjectKey       String    @map("quarantine_object_key")
  quarantineObjectVersionId String?   @map("quarantine_object_version_id")
  quarantineObjectEtag      String?   @map("quarantine_object_etag")
  quarantineDeletedAt       DateTime? @map("quarantine_deleted_at") @db.Timestamptz(6)

  cleanObjectKey       String?   @unique(map: "attestation_artifacts_clean_key") @map("clean_object_key")
  cleanObjectVersionId String?   @map("clean_object_version_id")
  cleanObjectEtag      String?   @map("clean_object_etag")
  purgedAt             DateTime? @map("purged_at") @db.Timestamptz(6)

  scanEngine    String? @map("scan_engine")
  scanSignature String? @map("scan_signature")
  rejectionCode String? @map("rejection_code")
  failureCode   String? @map("failure_code")
  failureDetail String? @map("failure_detail")

  idempotencyKey  String?  @map("idempotency_key") @db.VarChar(200)
  uploadExpiresAt DateTime @map("upload_expires_at") @db.Timestamptz(6)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  uploadedAt  DateTime? @map("uploaded_at") @db.Timestamptz(6)
  validatedAt DateTime? @map("validated_at") @db.Timestamptz(6)
  scannedAt   DateTime? @map("scanned_at") @db.Timestamptz(6)
  readyAt     DateTime? @map("ready_at") @db.Timestamptz(6)
  rejectedAt  DateTime? @map("rejected_at") @db.Timestamptz(6)
  failedAt    DateTime? @map("failed_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)

  request AttestationRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@unique([id, requestId], map: "attestation_artifacts_id_request_key")
  @@unique([ownerUserId, idempotencyKey], map: "attestation_artifacts_owner_idempotency")
  @@index([requestId, createdAt], map: "attestation_artifacts_request_idx")
  @@index([organizationId, sha256], map: "attestation_artifacts_org_sha_idx")
  @@index([status, uploadExpiresAt], map: "attestation_artifacts_status_idx")
  @@map("attestation_artifacts")
}

/// Append-only request history.
model AttestationRequestEvent {
  id             String                      @id @default(uuid()) @db.Uuid
  requestId      String                      @map("request_id") @db.Uuid
  ownerUserId    String                      @map("owner_user_id") @db.Uuid
  organizationId String                      @map("organization_id") @db.Uuid
  eventType      AttestationRequestEventType @map("event_type")
  actorSide      AttestationActorSide        @map("actor_side")
  actorUserId    String?                     @map("actor_user_id") @db.Uuid
  fromStatus     AttestationRequestStatus?   @map("from_status")
  toStatus       AttestationRequestStatus?   @map("to_status")
  message        String?
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)

  request AttestationRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt, id], map: "attestation_request_events_request_idx")
  @@index([organizationId, createdAt, id], map: "attestation_request_events_org_idx")
  @@map("attestation_request_events")
}

/// The immutable attestation record. Only a single revocation may follow.
model Attestation {
  id                String @id @default(uuid()) @db.Uuid
  requestId         String @unique(map: "attestations_request_key") @map("request_id") @db.Uuid
  ownerUserId       String @map("owner_user_id") @db.Uuid
  organizationId    String @map("organization_id") @db.Uuid
  attestationTypeId String @map("attestation_type_id") @db.Uuid

  reference         String @unique(map: "attestations_reference_key")
  publicTokenHash   String @unique(map: "attestations_token_key") @map("public_token_hash") @db.Char(64)
  publicTokenSealed String @map("public_token_sealed")

  artifactId                   String  @map("artifact_id") @db.Uuid
  artifactSha256               String  @map("artifact_sha256") @db.Char(64)
  artifactSizeBytes            Int     @map("artifact_size_bytes")
  artifactMimeType             String  @map("artifact_mime_type")
  artifactCleanObjectKey       String  @map("artifact_clean_object_key")
  artifactCleanObjectVersionId String? @map("artifact_clean_object_version_id")

  organizationName               String  @map("organization_name")
  organizationVerifiedAtApproval Boolean @map("organization_verified_at_approval")
  typeNameEn                     String  @map("type_name_en")
  typeNameAr                     String  @map("type_name_ar")

  certificateTitle      String    @map("certificate_title")
  certificateType       String?   @map("certificate_type")
  holderName            String?   @map("holder_name")
  issuingOrganization   String?   @map("issuing_organization")
  issueDate             DateTime? @map("issue_date") @db.Date
  referenceNumber       String?   @map("reference_number")
  holderNamePublic      Boolean   @default(true) @map("holder_name_public")
  referenceNumberPublic Boolean   @default(true) @map("reference_number_public")
  institutionNote       String?   @map("institution_note")

  validFrom    DateTime  @map("valid_from") @db.Timestamptz(6)
  validUntil   DateTime? @map("valid_until") @db.Timestamptz(6)
  reminderDays Int[]     @map("reminder_days")

  approvedByUserId String   @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime @map("approved_at") @db.Timestamptz(6)

  manifestVersion Int    @map("manifest_version")
  attestationHash String @map("attestation_hash") @db.Char(64)

  previousAttestationId String? @map("previous_attestation_id") @db.Uuid

  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId  String?   @map("revoked_by_user_id") @db.Uuid
  revocationReason String?   @map("revocation_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  request   AttestationRequest    @relation(fields: [requestId], references: [id], onDelete: Restrict)
  reminders AttestationReminder[]

  @@index([ownerUserId, approvedAt(sort: Desc)], map: "attestations_owner_idx")
  @@index([organizationId, approvedAt(sort: Desc)], map: "attestations_org_idx")
  @@index([artifactSha256], map: "attestations_artifact_sha_idx")
  @@map("attestations")
}

/// Where one approved request's captured fee went. Append-only.
model AttestationSettlement {
  id                    String   @id @default(uuid()) @db.Uuid
  requestId             String   @unique(map: "attestation_settlements_request_key") @map("request_id") @db.Uuid
  ownerUserId           String   @map("owner_user_id") @db.Uuid
  organizationId        String   @map("organization_id") @db.Uuid
  currency              String   @db.VarChar(3)
  grossMinor            BigInt   @map("gross_minor")
  platformCommissionBps Int      @map("platform_commission_bps")
  platformFeeMinor      BigInt   @map("platform_fee_minor")
  institutionNetMinor   BigInt   @map("institution_net_minor")
  holdId                String   @map("hold_id") @db.Uuid
  captureEntryId        String   @unique(map: "attestation_settlements_capture_key") @map("capture_entry_id") @db.Uuid
  settledAt             DateTime @map("settled_at") @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  request AttestationRequest        @relation(fields: [requestId], references: [id], onDelete: Restrict)
  entries AttestationRevenueEntry[]

  @@index([organizationId, settledAt, id], map: "attestation_settlements_org_idx")
  @@map("attestation_settlements")
}

/// The institution's share or PalCert's commission of one settlement.
model AttestationRevenueEntry {
  id             String   @id @default(uuid()) @db.Uuid
  settlementId   String   @map("settlement_id") @db.Uuid
  requestId      String   @map("request_id") @db.Uuid
  ownerUserId    String   @map("owner_user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  account        String
  currency       String   @db.VarChar(3)
  amountMinor    BigInt   @map("amount_minor")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  settlement AttestationSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  @@unique([settlementId, account], map: "attestation_revenue_entries_one_per_account")
  @@index([organizationId, account, createdAt], map: "attestation_revenue_entries_org_idx")
  @@map("attestation_revenue_entries")
}

/// One expiry reminder stage recorded for one attestation.
model AttestationReminder {
  id             String   @id @default(uuid()) @db.Uuid
  attestationId  String   @map("attestation_id") @db.Uuid
  requestId      String   @map("request_id") @db.Uuid
  ownerUserId    String   @map("owner_user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  stage          Int
  recordedAt     DateTime @map("recorded_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  attestation Attestation @relation(fields: [attestationId], references: [id], onDelete: Restrict)

  @@unique([attestationId, stage], map: "attestation_reminders_identity")
  @@map("attestation_reminders")
}

// =============================================================================
// Admin-managed transactional email (ADR-0146)
//
// Foreign keys to `users` and `notification_deliveries` exist in SQL; they are
// left out of the data model so this feature adds no relation fields to
// existing models.
// =============================================================================

/// The one platform-wide email configuration. A missing row means "never
/// configured", which behaves exactly as PalCert did before the feature.
///
/// The provider credential and the webhook signing secret are AES-256-GCM
/// ciphertext under a key held outside the database. Never plaintext.
model PlatformEmailSettings {
  id       Int     @id @default(1) @db.SmallInt
  provider String  @default("DISABLED")
  enabled  Boolean @default(false)

  sendingDomain String  @default("palcert.com") @map("sending_domain")
  fromEmail     String  @default("no-reply@palcert.com") @map("from_email")
  fromName      String  @default("PalCert") @map("from_name")
  replyToEmail  String? @map("reply_to_email")

  authVerificationEnabled  Boolean @default(true) @map("auth_verification_enabled")
  authPasswordResetEnabled Boolean @default(true) @map("auth_password_reset_enabled")
  authInvitationEnabled    Boolean @default(true) @map("auth_invitation_enabled")
  workflowEmailEnabled     Boolean @default(true) @map("workflow_email_enabled")
  deliveryTrackingEnabled  Boolean @default(true) @map("delivery_tracking_enabled")

  apiKeyCiphertext  String? @map("api_key_ciphertext")
  apiKeyIv          String? @map("api_key_iv")
  apiKeyAuthTag     String? @map("api_key_auth_tag")
  apiKeyKid         String? @map("api_key_kid")
  apiKeyDisplayHint String? @map("api_key_display_hint")

  webhookSecretCiphertext  String? @map("webhook_secret_ciphertext")
  webhookSecretIv          String? @map("webhook_secret_iv")
  webhookSecretAuthTag     String? @map("webhook_secret_auth_tag")
  webhookSecretKid         String? @map("webhook_secret_kid")
  webhookSecretDisplayHint String? @map("webhook_secret_display_hint")

  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid

  @@map("platform_email_settings")
}

/// Metadata of one message handed (or deliberately not handed) to the
/// admin-managed provider. No subject, body, link, header, token or credential.
model EmailDelivery {
  id                     String    @id @default(uuid()) @db.Uuid
  category               String
  template               String
  provider               String
  providerMessageId      String?   @map("provider_message_id")
  recipient              String
  status                 String    @default("QUEUED")
  skipReason             String?   @map("skip_reason")
  failureCode            String?   @map("failure_code")
  failureSummary         String?   @map("failure_summary")
  attemptCount           Int       @default(0) @map("attempt_count")
  notificationDeliveryId String?   @unique(map: "email_deliveries_notification_delivery") @map("notification_delivery_id") @db.Uuid
  requestedByUserId      String?   @map("requested_by_user_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  acceptedAt             DateTime? @map("accepted_at") @db.Timestamptz(6)
  deliveredAt            DateTime? @map("delivered_at") @db.Timestamptz(6)
  failedAt               DateTime? @map("failed_at") @db.Timestamptz(6)
  lastEventAt            DateTime? @map("last_event_at") @db.Timestamptz(6)

  @@unique([provider, providerMessageId], map: "email_deliveries_provider_message")
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "email_deliveries_created_idx")
  @@index([status, createdAt(sort: Desc)], map: "email_deliveries_status_idx")
  @@map("email_deliveries")
}

/// Append-only receipt of a signed provider webhook. Keeps a hash of the
/// payload, never the payload.
model EmailProviderEvent {
  id                String    @id @default(uuid()) @db.Uuid
  provider          String
  eventId           String    @map("event_id")
  eventType         String    @map("event_type")
  providerMessageId String?   @map("provider_message_id")
  payloadSha256     String    @map("payload_sha256")
  outcome           String
  occurredAt        DateTime? @map("occurred_at") @db.Timestamptz(6)
  receivedAt        DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)

  @@unique([provider, eventId], map: "email_provider_events_identity")
  @@index([provider, providerMessageId], map: "email_provider_events_message_idx")
  @@map("email_provider_events")
}

// =============================================================================
// Manual top-ups and human payment verification
//
// A person pays PalCert by bank or wallet transfer outside PalCert and reports
// it; PalCert finance credits the balance after matching the transfer. Credit
// is created only by an approval, as exactly one MANUAL_TOPUP_CREDIT entry in
// credit_ledger_entries — there is no second wallet and no balance column.
//
// The partial unique index on (payment_method_id, reference_normalized), the
// state-machine triggers and the CHECK constraints live in the migration;
// Prisma's schema language cannot express them.
// =============================================================================

enum ManualPaymentMethodType {
  MOBILE_WALLET
  BANK_ACCOUNT
  OTHER
}

enum ManualTopUpStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum ManualTopUpRejectionReason {
  REFERENCE_NOT_FOUND
  AMOUNT_MISMATCH
  DUPLICATE_REFERENCE
  RECEIPT_UNCLEAR
  PAYMENT_NOT_RECEIVED
  INVALID_PAYMENT_METHOD
  OTHER
}

enum ManualTopUpEventType {
  CREATED
  UPDATED
  RECEIPT_ATTACHED
  SUBMITTED
  REVIEW_STARTED
  APPROVED
  REJECTED
  CANCELLED
}

enum ManualTopUpActorSide {
  OWNER
  FINANCE
}

enum ManualTopUpFileStatus {
  AWAITING_UPLOAD
  UPLOADED
  VALIDATING
  SCANNING
  READY
  REJECTED
  FAILED
  UPLOAD_EXPIRED
}

enum ManualTopUpFileFormat {
  PDF
  PNG
  JPEG
  WEBP
}

/// Where PalCert asks people to send money. Never hard-deleted; archiving is final.
model ManualPaymentMethod {
  id            String                  @id @default(uuid()) @db.Uuid
  code          String                  @unique(map: "manual_payment_methods_code_key") @db.VarChar(40)
  type          ManualPaymentMethodType
  nameEn        String                  @map("name_en") @db.VarChar(120)
  nameAr        String                  @map("name_ar") @db.VarChar(120)
  descriptionEn String?                 @map("description_en") @db.VarChar(500)
  descriptionAr String?                 @map("description_ar") @db.VarChar(500)
  currency      String                  @db.Char(3)

  recipientName String? @map("recipient_name") @db.VarChar(140)
  mobileNumber  String? @map("mobile_number") @db.VarChar(16)
  iban          String? @db.VarChar(34)
  bankName      String? @map("bank_name") @db.VarChar(140)
  accountNumber String? @map("account_number") @db.VarChar(40)
  branchName    String? @map("branch_name") @db.VarChar(140)

  instructionsEn String? @map("instructions_en") @db.VarChar(2000)
  instructionsAr String? @map("instructions_ar") @db.VarChar(2000)

  minAmountMinor BigInt @map("min_amount_minor")
  maxAmountMinor BigInt @map("max_amount_minor")

  logoId       String? @map("logo_id") @db.Uuid
  enabled      Boolean @default(false)
  displayOrder Int     @default(0) @map("display_order")
  version      Int     @default(1)

  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  updatedByUserId String?   @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(6)

  logo      ManualPaymentMethodLogo?      @relation("ManualPaymentMethodCurrentLogo", fields: [logoId, id], references: [id, paymentMethodId], onDelete: Restrict, map: "manual_payment_methods_logo_fkey")
  logos     ManualPaymentMethodLogo[]     @relation("ManualPaymentMethodLogos")
  requests  ManualTopUpRequest[]
  reviewers ManualPaymentMethodReviewer[]

  @@map("manual_payment_methods")
}

/// Finance staff assigned to review top-ups sent through one method (ADR-0148).
/// Assignment grants nothing: a reviewer must still hold
/// finance:manual-topup:review through a GLOBAL role, which the database
/// checks on insert and the notification pipeline re-checks at fan-out and send.
model ManualPaymentMethodReviewer {
  paymentMethodId String   @map("payment_method_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdByUserId String?  @map("created_by_user_id") @db.Uuid

  paymentMethod ManualPaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict, map: "manual_payment_method_reviewers_method_fkey")

  @@id([paymentMethodId, userId], map: "manual_payment_method_reviewers_pkey")
  @@index([userId], map: "manual_payment_method_reviewers_user_idx")
  @@map("manual_payment_method_reviewers")
}

/// A scanned raster logo for one payment method.
model ManualPaymentMethodLogo {
  id               String                @id @default(uuid()) @db.Uuid
  paymentMethodId  String                @map("payment_method_id") @db.Uuid
  uploadedByUserId String?               @map("uploaded_by_user_id") @db.Uuid
  status           ManualTopUpFileStatus @default(AWAITING_UPLOAD)

  originalFilename String                 @map("original_filename")
  declaredMimeType String?                @map("declared_mime_type")
  expectedFormat   ManualTopUpFileFormat  @map("expected_format")
  detectedFormat   ManualTopUpFileFormat? @map("detected_format")
  detectedMimeType String?                @map("detected_mime_type")

  declaredSizeBytes Int     @map("declared_size_bytes")
  maxFileBytes      Int     @map("max_file_bytes")
  sizeBytes         Int?    @map("size_bytes")
  clientSha256      String? @map("client_sha256") @db.Char(64)
  sha256            String? @db.Char(64)

  quarantineObjectKey       String    @map("quarantine_object_key")
  quarantineObjectVersionId String?   @map("quarantine_object_version_id")
  quarantineObjectEtag      String?   @map("quarantine_object_etag")
  quarantineDeletedAt       DateTime? @map("quarantine_deleted_at") @db.Timestamptz(6)

  cleanObjectKey       String? @unique(map: "manual_payment_method_logos_clean_key") @map("clean_object_key")
  cleanObjectVersionId String? @map("clean_object_version_id")
  cleanObjectEtag      String? @map("clean_object_etag")

  scanEngine    String? @map("scan_engine")
  scanSignature String? @map("scan_signature")
  rejectionCode String? @map("rejection_code")
  failureCode   String? @map("failure_code")
  failureDetail String? @map("failure_detail")

  idempotencyKey  String?  @map("idempotency_key") @db.VarChar(200)
  uploadExpiresAt DateTime @map("upload_expires_at") @db.Timestamptz(6)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  uploadedAt  DateTime? @map("uploaded_at") @db.Timestamptz(6)
  validatedAt DateTime? @map("validated_at") @db.Timestamptz(6)
  scannedAt   DateTime? @map("scanned_at") @db.Timestamptz(6)
  readyAt     DateTime? @map("ready_at") @db.Timestamptz(6)
  rejectedAt  DateTime? @map("rejected_at") @db.Timestamptz(6)
  failedAt    DateTime? @map("failed_at") @db.Timestamptz(6)

  paymentMethod ManualPaymentMethod   @relation("ManualPaymentMethodLogos", fields: [paymentMethodId], references: [id], onDelete: Restrict, map: "manual_payment_method_logos_method_fkey")
  currentOf     ManualPaymentMethod[] @relation("ManualPaymentMethodCurrentLogo")

  @@unique([id, paymentMethodId], map: "manual_payment_method_logos_id_method_key")
  @@unique([uploadedByUserId, idempotencyKey], map: "manual_payment_method_logos_uploader_idempotency")
  @@index([paymentMethodId, createdAt], map: "manual_payment_method_logos_method_idx")
  @@map("manual_payment_method_logos")
}

/// One person's report of one transfer, and finance's decision on it.
model ManualTopUpRequest {
  id                    String            @id @default(uuid()) @db.Uuid
  ownerUserId           String            @map("owner_user_id") @db.Uuid
  paymentMethodId       String            @map("payment_method_id") @db.Uuid
  currency              String            @db.Char(3)
  amountMinor           BigInt?           @map("amount_minor")
  referenceOriginal     String?           @map("reference_original") @db.VarChar(100)
  referenceNormalized   String?           @map("reference_normalized") @db.VarChar(64)
  status                ManualTopUpStatus @default(DRAFT)
  /// The destination the person was shown. Frozen from creation.
  paymentMethodSnapshot Json              @map("payment_method_snapshot")
  customerNote          String?           @map("customer_note") @db.VarChar(500)
  receiptId             String?           @map("receipt_id") @db.Uuid
  idempotencyKey        String?           @map("idempotency_key") @db.VarChar(200)

  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                    @default(now()) @map("updated_at") @db.Timestamptz(6)
  submittedAt           DateTime?                   @map("submitted_at") @db.Timestamptz(6)
  reviewStartedAt       DateTime?                   @map("review_started_at") @db.Timestamptz(6)
  reviewStartedByUserId String?                     @map("review_started_by_user_id") @db.Uuid
  decidedAt             DateTime?                   @map("decided_at") @db.Timestamptz(6)
  approvedByUserId      String?                     @map("approved_by_user_id") @db.Uuid
  rejectedByUserId      String?                     @map("rejected_by_user_id") @db.Uuid
  rejectionReason       ManualTopUpRejectionReason? @map("rejection_reason")
  rejectionNote         String?                     @map("rejection_note") @db.VarChar(1000)
  cancelledAt           DateTime?                   @map("cancelled_at") @db.Timestamptz(6)
  /// The one ledger entry an approval wrote. Write-once.
  creditEntryId         String?                     @unique(map: "manual_topup_requests_credit_entry_key") @map("credit_entry_id") @db.Uuid

  paymentMethod ManualPaymentMethod       @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict, map: "manual_topup_requests_method_fkey")
  receipt       ManualTopUpReceipt?       @relation("ManualTopUpCurrentReceipt", fields: [receiptId, id], references: [id, requestId], onDelete: Restrict, map: "manual_topup_requests_receipt_fkey")
  receipts      ManualTopUpReceipt[]      @relation("ManualTopUpReceipts")
  events        ManualTopUpRequestEvent[]

  @@unique([id, ownerUserId], map: "manual_topup_requests_id_owner_key")
  @@unique([ownerUserId, idempotencyKey], map: "manual_topup_requests_owner_idempotency")
  @@index([ownerUserId, createdAt(sort: Desc), id], map: "manual_topup_requests_owner_idx")
  @@index([status, submittedAt, id], map: "manual_topup_requests_queue_idx")
  @@map("manual_topup_requests")
}

/// Optional proof of payment. Private to its owner and PalCert finance.
model ManualTopUpReceipt {
  id          String                @id @default(uuid()) @db.Uuid
  requestId   String                @map("request_id") @db.Uuid
  ownerUserId String                @map("owner_user_id") @db.Uuid
  status      ManualTopUpFileStatus @default(AWAITING_UPLOAD)

  originalFilename String                 @map("original_filename")
