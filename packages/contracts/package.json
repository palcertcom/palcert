{
  "name": "@palcert/contracts",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./auth/roles": {
      "types": "./dist/auth/roles.d.ts",
      "require": "./dist/auth/roles.js",
      "default": "./dist/auth/roles.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "require": "./dist/email/index.js",
      "default": "./dist/email/index.js"
    },
    "./finance/manual-topups": {
      "types": "./dist/finance/manual-topups.d.ts",
      "require": "./dist/finance/manual-topups.js",
      "default": "./dist/finance/manual-topups.js"
    },
    "./finance/withdrawals": {
      "types": "./dist/finance/withdrawals.d.ts",
      "require": "./dist/finance/withdrawals.js",
      "default": "./dist/finance/withdrawals.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate:evaluation": "node scripts/generate-evaluation-types.mjs",
    "check:evaluation": "node scripts/generate-evaluation-types.mjs --check",
    "verify:report-golden": "node scripts/verify-report-golden.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  }
}
