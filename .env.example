# =============================================================================
# PalCert — example environment configuration
#
# Copy to `.env` and fill in local values:  cp .env.example .env
#
# THIS FILE MUST NEVER CONTAIN A REAL SECRET.
# Every value below is a local-development placeholder. Production values are
# supplied by the deployment secret manager, never by a committed file.
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development
APP_NAME=palcert-api
APP_VERSION=0.1.0

# --- Logging -----------------------------------------------------------------
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
# Human-readable logs for local work. MUST be false in production.
LOG_PRETTY=true

# --- Telemetry (Phase 20) ----------------------------------------------------
# Each PalCert process exposes Prometheus metrics at /metrics on its own port:
# API 4000, worker 4100, document engine 8000, web 3000.
#
# The endpoint is internal. The release proxy has no route to it, so an
# external request never reaches a process; a scraper runs on the deployment
# network and reads each one directly.
METRICS_ENABLED=true
# Optional second lock, for a deployment whose internal network is shared.
# When set, a scrape must present `Authorization: Bearer <token>`. Leave it
# empty and the endpoint sits at the same trust level as /health.
METRICS_TOKEN=

# --- API ---------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated browser origin allow-list. Wildcards are rejected in production.
API_CORS_ORIGINS=http://localhost:3000

# Which upstream addresses may set X-Forwarded-For (Phase 20 Checkpoint 7).
#
# Empty means trust nothing: the client address is the socket address and a
# forwarded header is ignored. That is correct for local development, where
# nothing sits in front of the API. Production must set it — the per-IP login
# throttle, the public-verification guard and every audit record depend on it,
# and leaving it unset behind a proxy throttles the whole world as one client.
#
# Accepts addresses, CIDR blocks, and the names loopback, linklocal and
# uniquelocal. Name the load balancer's addresses where you can.
API_TRUSTED_PROXIES=
API_RATE_LIMIT_TTL_SECONDS=60
API_RATE_LIMIT_LIMIT=120
# Swagger explorer at /api/docs. MUST be false in production.
API_DOCS_ENABLED=true

# --- Database (PostgreSQL) ---------------------------------------------------
# TWO identities, deliberately (ADR-0018):
#
#   DATABASE_URL        the request path. A least-privileged role that is NOT a
#                       superuser, does NOT hold BYPASSRLS, and does NOT own the
#                       schema. The API asserts this at boot and refuses to
#                       start otherwise — every row-level security policy is
#                       decoration if the application can bypass it.
#
#   DATABASE_ADMIN_URL  migrations only, used by the Prisma CLI. Owns the schema.
#                       The running application never connects with it.
DATABASE_URL=postgresql://palcert_app:palcert_app_local_dev_password@localhost:5432/palcert?schema=public
DATABASE_ADMIN_URL=postgresql://palcert:palcert_local_dev@localhost:5432/palcert?schema=public
DATABASE_POOL_MAX=10
# Never set this to false outside a local experiment; production rejects it.
DATABASE_ENFORCE_LEAST_PRIVILEGE=true

# Password for the request-path role, applied by `pnpm db:provision-app-role`.
# The migration creates the role with NOLOGIN and no password, because a
# committed migration must never contain a secret.
APP_DB_PASSWORD=palcert_app_local_dev_password

# --- Cache / queue (Redis) ---------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible; MinIO locally) ---------------------------
# Two buckets (ADR-0033): uploads land in the quarantine bucket and only a
# validated, scanned copy is promoted into the clean bucket. Both must have
# object versioning enabled; `pnpm storage:provision` creates and configures
# them idempotently. Users never see bucket names or object keys.
STORAGE_ENDPOINT=http://localhost:9000
# Endpoint the *browser* uses for presigned uploads and downloads, when it
# differs from the one the API uses (e.g. the API talks to a compose hostname).
# In production it is required and must be the origin of APP_PUBLIC_WEB_URL:
# the web app's CSP only lets a browser connect to its own origin, so the edge
# proxy routes the bucket paths to storage (docs/operations/deployment.md).
# STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=palcert-documents
STORAGE_QUARANTINE_BUCKET=palcert-quarantine
# Derived artifacts: PalCert's own analysis of a user's document (Phase 6).
# Written only by workers; no browser ever reaches it.
STORAGE_DERIVED_BUCKET=palcert-derived
STORAGE_ACCESS_KEY_ID=palcert_local_dev
STORAGE_SECRET_ACCESS_KEY=palcert_local_dev_secret
STORAGE_FORCE_PATH_STYLE=true
# none | AES256 | aws:kms — production requires AES256 or aws:kms.
STORAGE_SERVER_SIDE_ENCRYPTION=none
# STORAGE_KMS_KEY_ID=
# Presigned URL lifetimes (seconds).
STORAGE_UPLOAD_URL_TTL_SECONDS=900
STORAGE_DOWNLOAD_URL_TTL_SECONDS=120

# --- Document upload and processing (Phase 5) -------------------------------
# Size ceilings per format, in bytes (100 MiB / 200 MiB).
UPLOAD_MAX_DOCX_BYTES=104857600
UPLOAD_MAX_PDF_BYTES=209715200
# How long an upload authorization stays valid before the version expires.
UPLOAD_SESSION_TTL_SECONDS=3600
# Archive safety limits applied to every DOCX (a ZIP) without extraction.
INGEST_MAX_ARCHIVE_ENTRIES=2000
INGEST_MAX_ARCHIVE_ENTRY_BYTES=268435456
INGEST_MAX_ARCHIVE_TOTAL_BYTES=1073741824
INGEST_MAX_COMPRESSION_RATIO=100
INGEST_VALIDATION_TIMEOUT_MS=60000
INGEST_SCAN_TIMEOUT_MS=120000
# Retry policy for the processing ledger (attempts, exponential backoff with jitter).
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_BASE_MS=5000
QUEUE_BACKOFF_MAX_MS=300000
QUEUE_LEASE_SECONDS=300
WORKER_CONCURRENCY=2
WORKER_PORT=4100

# --- Malware scanning --------------------------------------------------------
# clamav streams every upload to clamd; `fake` exists for tests only and is
# refused in production.
MALWARE_SCANNER=clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=120000

# --- Authentication ----------------------------------------------------------
# Minimum 32 characters. Generate with: openssl rand -base64 48

# AES-256-GCM key protecting TOTP secrets at rest. Exactly 32 bytes, base64.
# Generate your own with: openssl rand -base64 32
#
# Deliberately empty. Any value valid here is 32 base64 bytes, which is
# indistinguishable from real key material to a reader and to a secret
# scanner alike — so the template ships none rather than a shared "dev key"
# that works well enough to be pasted somewhere it should not be. Startup
# fails with a clear message until you generate one.
#
# Rotating this key makes every enrolled authenticator unreadable — users would
# have to re-enrol, so treat it as long-lived key material.
AUTH_MFA_SECRET_KEY=

# AES-256-GCM key sealing a verification code between scheduling and issuance.
# 32 bytes, base64. Generate with: openssl rand -base64 32
CERTIFICATE_VERIFICATION_SECRET_KEY=
AUTH_MFA_ISSUER=PalCert
AUTH_MFA_RECOVERY_CODE_COUNT=10

# Session lifetimes, in minutes. Privileged roles get the stricter pair.
AUTH_SESSION_IDLE_MINUTES=60
AUTH_SESSION_ABSOLUTE_MINUTES=720
AUTH_PRIVILEGED_SESSION_IDLE_MINUTES=15
AUTH_PRIVILEGED_SESSION_ABSOLUTE_MINUTES=480
# Lifetime of the constrained session issued between password and MFA.
AUTH_MFA_PENDING_MINUTES=5
# How recently a user must have authenticated for a sensitive action.
AUTH_REAUTH_WINDOW_MINUTES=15

# Cookie policy. SameSite=None is rejected in production.
AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=.palcert.com

# Credential token lifetimes, in minutes.
AUTH_EMAIL_VERIFICATION_TTL_MINUTES=1440
AUTH_PASSWORD_RESET_TTL_MINUTES=30

# Password policy. Length over composition rules (NIST SP 800-63B).
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_MAX_LENGTH=256
# Enable once a breached-credential provider is configured (Phase 1 ships the
# abstraction and a no-op implementation).
AUTH_BREACHED_PASSWORD_CHECK_ENABLED=false

# Argon2id parameters. Production validation enforces a floor of 19456/2/1.
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1

# Authentication throttling. Counters expire on their own — there is
# deliberately no permanent account lockout, which would be a denial-of-service
# weapon against any known email address.
AUTH_LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=10
AUTH_LOGIN_MAX_ATTEMPTS_PER_IP=50
AUTH_LOGIN_THROTTLE_WINDOW_MINUTES=15
AUTH_MFA_MAX_ATTEMPTS=5
AUTH_PASSWORD_RESET_MAX_REQUESTS=5

# Public origin of the web app, used to build verification and reset links.
# Must be https in production.
APP_PUBLIC_WEB_URL=http://localhost:3000

# --- Document engine ---------------------------------------------------------
DOCUMENT_ENGINE_URL=http://localhost:8000
# --- Document analysis (Phase 6) --------------------------------------------
# Where the API and workers reach the Python analyzer. Internal only.
DOC_ENGINE_URL=http://localhost:8000
DOC_ENGINE_ANALYSIS_TIMEOUT_MS=300000
DOC_ENGINE_READINESS_TIMEOUT_MS=2000
ANALYSIS_MAX_SOURCE_BYTES=209715200
ANALYSIS_MAX_ARTIFACT_BYTES=134217728

DOC_ENGINE_ENVIRONMENT=development
DOC_ENGINE_PORT=8000
DOC_ENGINE_LOG_LEVEL=info
DOC_ENGINE_LOG_JSON=false
# The engine has its own copies, prefixed like the rest of its configuration.
DOC_ENGINE_METRICS_ENABLED=true
DOC_ENGINE_METRICS_TOKEN=

# --- AI review (Phase 8) -----------------------------------------------------
# Off by default. Sending someone's unpublished thesis to a third party is a
# capability that should require a deliberate act to turn on.
AI_ENABLED=false
AI_PRIMARY_PROVIDER=anthropic

# Server secret. Never reaches a browser, a response, a log, an audit row, a
# queue payload or the database. Placeholder only — real keys come from the
# deployment secret manager.
ANTHROPIC_API_KEY=
# The exact model is configuration, not PalCert's identity.
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_OUTPUT_TOKENS=8000
ANTHROPIC_TIMEOUT_MS=120000
# ANTHROPIC_EFFORT=            # optional; unset unless the model accepts it
# ANTHROPIC_BASE_URL=          # adapter tests against a controlled mock server

# Budgets. An academic document is never sent unbounded.
AI_MAX_INPUT_TOKENS=60000
AI_MAX_OUTPUT_TOKENS=8000
AI_MAX_RULES_PER_REQUEST=10
AI_MAX_CONTEXT_CHARS=60000
AI_MAX_NODE_CHARS=2000
AI_MAX_CONTEXT_NODES=120

# Bounded retries; never indefinite.
AI_MAX_ATTEMPTS=3
AI_RETRY_BASE_MS=1000
AI_RETRY_MAX_MS=30000

# What PalCert tells users about the provider's data handling. Set
# ZERO_DATA_RETENTION only if this deployment genuinely has that contractual
# configuration — promising it otherwise would be a lie to the document's owner.
AI_PROVIDER_RETENTION_POLICY=PROVIDER_STANDARD
# AI_PROVIDER_POLICY_URL=

# --- Rule extraction from guidelines and templates (Phase 9) -----------------
# Bounds on what one reading may send. These are separate from the Phase 8
# review budgets on purpose: a 200-page guideline is a perfectly acceptable
# thing to store and a completely different thing to send to a model.
AI_EXTRACTION_MAX_SOURCES=10
# The provider's own PDF request ceiling is 32 MB; stay well inside it.
AI_EXTRACTION_MAX_PDF_BYTES=20971520
AI_EXTRACTION_MAX_SOURCE_PAGES=200
AI_EXTRACTION_MAX_DOCX_TEXT_CHARS=400000
AI_EXTRACTION_MAX_DOCX_BLOCKS=1200
AI_EXTRACTION_MAX_EVIDENCE_BLOCKS=400
AI_EXTRACTION_MAX_EVIDENCE_CHARS=2000
AI_EXTRACTION_MAX_TEMPLATE_OBSERVATIONS=200
AI_EXTRACTION_MAX_PROPOSALS=150
AI_EXTRACTION_MAX_CONTEXT_CHARS=120000

# --- Customer credit, payments and pricing (Phase 10) ------------------------
# PalCert Balance is customer credit held with PalCert. It is not a wallet and
# has nothing to do with crypto. Money is always an integer count of minor
# units: 2000 is $20.00, never 20.00.
PAYMENTS_ENABLED=true
# 'stripe' in any real deployment. 'fake' is for tests and is refused outright
# when NODE_ENV=production.
PAYMENT_PROVIDER=fake

# Currencies this installation accepts, from the canonical registry. The
# default must be one of them. Phase 10 performs no conversion between them.
PALCERT_ENABLED_CURRENCIES=USD
PALCERT_DEFAULT_CURRENCY=USD

# Provider credentials. Required when PAYMENTS_ENABLED=true and the provider is
# stripe. Never commit real values; these are placeholders.
# STRIPE_SECRET_KEY=sk_test_replace_me_with_a_real_test_key_value
# STRIPE_WEBHOOK_SECRET=whsec_replace_me_with_the_endpoint_signing_secret
# Pinned deliberately: the SDK's default moves when the SDK is upgraded.
STRIPE_API_VERSION=2026-08-26.dahlia
# Test-only override for pointing the adapter at a local mock. Refused in
# production.
# STRIPE_BASE_URL=

# Where the provider's hosted page sends the browser back to. Neither URL has
# any authority: credit is applied by a verified provider event, never because
# a browser arrived here.
PAYMENT_SUCCESS_URL=http://localhost:3000/en/balance/payment-return
PAYMENT_CANCEL_URL=http://localhost:3000/en/balance/payment-cancelled

# Top-up limits, in minor units: $5.00 to $2,000.00.
TOPUP_MIN_MINOR=500
TOPUP_MAX_MINOR=200000
TOPUP_SESSION_TTL_SECONDS=3600

# How long reserved credit stays reserved before a sweeper releases it, so a
# crashed worker cannot strand a customer's money.
CREDIT_HOLD_TTL_SECONDS=900
# How long a paid check's reservation stands (Phase 11). Deliberately separate
# from the generic hold above: a check queues, is analyzed, is evaluated and
# has a report stored, and fifteen minutes is nowhere near long enough. Still a
# hard bound — past it the reservation is released and the check fails, so a
# late worker can never deliver a report nobody paid for.
CHECK_RESERVATION_TTL_SECONDS=3600
# ADR-0149: how long an AI review or rule extraction reservation stands.
AI_RESERVATION_TTL_SECONDS=7200
# How long a quoted price is honoured.
PRICE_QUOTE_TTL_SECONDS=1800
# How long a top-up may stay open before PalCert re-queries the provider
# itself. This is why credit still arrives when a webhook never does.
PAYMENT_RECONCILE_AFTER_SECONDS=300
PAYMENT_PROVIDER_TIMEOUT_MS=20000

# --- Notifications (Phase 16) ------------------------------------------------
# Workflow notification mail, deliberately separate from the AUTH_* settings
# above. Verification and reset mail carries single-use credentials and
# notification mail must never be able to; keeping the transports independent
# means workflow mail can be switched off without disabling account recovery.
#
# `disabled` is the default and a legitimate production choice: PalCert is
# usable with in-app notifications alone, and a deployment without a relay
# records CHANNEL_DISABLED skips rather than retrying against a transport that
# was never going to exist. `fake` is for tests and is refused in production.
NOTIFICATION_EMAIL_PROVIDER=disabled
# Required when the provider is smtp. A bare address; the display name is
# separate and is validated for CR/LF at boot.
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_FROM_NAME=PalCert
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_SECURE=false
NOTIFICATION_SMTP_USER=
NOTIFICATION_SMTP_PASSWORD=
# Bounded, so one unreachable relay cannot hold a worker's lease open until it
# expires and the job is redelivered to a second worker.
NOTIFICATION_SMTP_TIMEOUT_MS=15000
# How many recipients one fan-out page resolves. Matches the SQL bound.
NOTIFICATION_FANOUT_PAGE_SIZE=100

# --- Admin-managed transactional email (ADR-0146) ---------------------------
#
# The provider (Resend), sender and API key are configured by a platform
# administrator in the dashboard, never here. This keyring is the root key
# that seals the stored API key and webhook secret (AES-256-GCM). Same format
# as the webhook keyring: kid:base64key, comma-separated, 32 bytes per key.
# Generate one with: openssl rand -base64 32
#
# Leave both blank to run without admin-managed email: PalCert behaves as it
# did before and the dashboard refuses to store a credential. Back this key up
# separately from the database; a restored database needs it to send mail.
EMAIL_SETTINGS_ENCRYPTION_ACTIVE_KID=
EMAIL_SETTINGS_ENCRYPTION_KEYS=
# Withdrawals (ADR-0150): the AES-256-GCM keyring that seals payout
# destinations — IBANs, account numbers and wallet numbers. Its own key,
# never the email one: payout details rotate on a different schedule. Same
# format: kid:base64key, comma-separated, 32 bytes per key.
#
# Leave both blank and PalCert still boots and shows payout history, but
# refuses to create or change a payout destination. Back this key up
# separately from the database; finance needs it to read where to pay.
PAYOUT_DESTINATION_ENCRYPTION_ACTIVE_KID=
PAYOUT_DESTINATION_ENCRYPTION_KEYS=
# Resend request timeout. RESEND_API_BASE_URL exists only for tests and is
# refused in production.
RESEND_TIMEOUT_MS=10000
# How long each process caches the dashboard's email settings.
EMAIL_SETTINGS_CACHE_SECONDS=15

# --- Outbound webhooks (Phase 17) --------------------------------------------
#
# The keyring that seals webhook URLs and signing secrets at rest. Unlike the
# single keys above, this is a ring: rows record which key sealed them, so a
# key can be rotated without every stored value and the key changing in the
# same instant. Format is kid:base64key, comma-separated; every key is 32
# bytes. Generate one with: openssl rand -base64 32
#
# Leave both blank to run a deployment without outbound webhooks. Setting one
# without the other is refused at boot, because half a keyring fails on the
# first real delivery and is reported as somebody's endpoint being broken.
WEBHOOK_ENCRYPTION_ACTIVE_KID=
WEBHOOK_ENCRYPTION_KEYS=

# Ports an organization may point a webhook at. Widening this is a platform
# decision: letting a tenant name a port turns an endpoint into a port scanner
# that reports its findings through delivery error codes.
WEBHOOK_ALLOWED_PORTS=443
# PalCert's own public hostnames, comma-separated. Refused as destinations, so
# PalCert cannot be made to call itself. The configured public web URL is added
# to this list automatically.
WEBHOOK_OWN_HOSTS=

# Bounds on one attempt. The total deadline is the one that matters: without it
# a receiver that accepts a connection and then says nothing costs a worker for
# as long as it cares to stay silent.
WEBHOOK_DNS_TIMEOUT_MS=3000
WEBHOOK_CONNECT_TIMEOUT_MS=5000
WEBHOOK_TLS_TIMEOUT_MS=5000
WEBHOOK_TOTAL_TIMEOUT_MS=15000
WEBHOOK_MAX_REQUEST_BYTES=65536
# No response-body cap: PalCert reads no response body at all, which is
# stricter than any cap. Only the headers it acts on are bounded.
WEBHOOK_MAX_RESPONSE_HEADER_BYTES=16384

# --- Web ---------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=PalCert
NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- Local infrastructure credentials (docker compose only) ------------------
POSTGRES_USER=palcert
POSTGRES_PASSWORD=palcert_local_dev
POSTGRES_DB=palcert

# Phase 19 — protects an API-client secret during its 24-hour show-once window.
# Its own key: the only one that can turn stored bytes back into a working
# inbound credential. Generate with: openssl rand -base64 32
API_CLIENT_REVEAL_SECRET_KEY=
