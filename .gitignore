# Dependencies
node_modules/
.pnpm-store/
__pycache__/
*.py[cod]
.venv/
venv/
# Build metadata written by `pip install -e`; never source.
*.egg-info/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo
generated/
# Regenerated by `next dev`/`next build`; typecheck does not require it.
next-env.d.ts

# Test / coverage
coverage/
# coverage.py's data file, rewritten by every pytest run.
.coverage
.coverage.*
.pytest_cache/
.ruff_cache/
junit*.xml

# Environment & secrets
# The persistent local environment's generated secrets (pnpm local:up).
.local/
.env
.env.*
!.env.example
# Host-only AI credentials; the Compose overlay contains references only.
ai.env
*.pem
*.key

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Local data
tmp/
.turbo/

# The browser QA fixture holds a throwaway account for a disposable stack.
qa/.fixture.json
qa/.probe*.mjs
