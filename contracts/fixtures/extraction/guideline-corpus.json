          "times": 100
        },
        { "scope": "ELEMENT:PARAGRAPH:fontFamily", "value": "Arial", "times": 96 }
      ],
      "expected": { "uniformity": "MIXED", "modalValue": "Times New Roman", "proposable": false }
    },
    {
