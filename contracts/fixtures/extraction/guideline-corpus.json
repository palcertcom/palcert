      "facts": [
        { "scope": "ELEMENT:HEADING#1:fontSize", "unit": "POINT", "value": "16", "times": 7 },
        { "scope": "ELEMENT:HEADING#1:fontSize", "unit": "POINT", "value": "14", "times": 5 }
      ],
      "expected": { "uniformity": "MIXED", "modalValue": "16", "proposable": false }
    },
    {
