        { "scope": "ELEMENT:PARAGRAPH:fontSize", "unit": "POINT", "value": "11", "times": 5 },
        { "scope": "ELEMENT:PARAGRAPH:fontSize", "unit": "POINT", "value": "14", "times": 4 }
      ],
      "expected": { "uniformity": "MOSTLY_UNIFORM", "modalValue": "12", "proposable": true }
    },
    {
      "id": "mixed-body-fonts",
