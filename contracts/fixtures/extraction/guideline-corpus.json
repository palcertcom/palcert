  "templates": [
    {
      "id": "uniform-margins",
      "description": "Every section uses the same page margins.",
      "facts": [
        { "scope": "PAGE:ALL:marginLeft", "unit": "MILLIMETRE", "value": "30", "times": 8 }
      ],
      "expected": { "uniformity": "UNIFORM", "modalValue": "30", "proposable": true }
    },
    {
      "id": "mixed-margins",
      "description": "The front matter uses different margins from the body.",
      "facts": [
        { "scope": "PAGE:ALL:marginLeft", "unit": "MILLIMETRE", "value": "30", "times": 5 },
        { "scope": "PAGE:ALL:marginLeft", "unit": "MILLIMETRE", "value": "25", "times": 4 }
      ],
      "expected": { "uniformity": "MIXED", "modalValue": "30", "proposable": false }
    },
    {
      "id": "uniform-body-font",
      "description": "Every body paragraph is 12 pt.",
      "facts": [
        { "scope": "ELEMENT:PARAGRAPH:fontSize", "unit": "POINT", "value": "12", "times": 196 }
      ],
      "expected": { "uniformity": "UNIFORM", "modalValue": "12", "proposable": true }
    },
    {
      "id": "mostly-uniform-body-font",
