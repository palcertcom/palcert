      "sourceKind": "GUIDELINE_PDF",
      "passage": "The left margin must be 30 mm on every page of the thesis.",
      "expected": {
        "kind": "EXPLICIT_REQUIREMENT",
        "scopeKey": "PAGE:ALL:marginLeft",
        "representable": true,
        "automationSupport": "SUPPORTED_DOCX"
      }
    },
    {
      "id": "en-font-explicit",
      "language": "en",
      "sourceKind": "GUIDELINE_PDF",
